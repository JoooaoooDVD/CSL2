# ===== Craft Studio Discord bot — pre-configured =====
# Only this line is needed from you (Developer Portal -> App 1551939107549225000 -> Bot -> Reset Token):
DISCORD_BOT_TOKEN=

# Craft Studio server (auto-detected from the invite; leave as is)
GUILD_ID=1498382595224895598
# 0 = bot creates the "Linked" role and a private #launcher-links channel itself on first start
LINKED_ROLE_ID=1563123562364149770
LINKED_ROLE_NAME=Linked
LOG_CHANNEL_ID=1504198522365411408
LOG_CHANNEL_NAME=launcher-links
ADMIN_ROLE_ID=1552025879461240912

# Supabase (same project as the launcher)
SUPABASE_URL=https://ygteavpkursyeyfthlxm.supabase.co
SUPABASE_SERVICE_KEY=

POLL_SECONDS=5
DISCORD_INVITE_URL=https://discord.gg/dmteYqZZyY
YOUTUBE_URL=https://youtube.com/@craft-studio-official
WEBSITE_URL=
LAUNCHER_NAME=CS Launcher Plus
COMMUNITY_NAME=Craft Studio
EMBED_COLOR=0x5865F2
DM_ON_UNLINK=true
LOG_LEVEL=INFO

# ---- v2 extras (all optional) ------------------------------------------------
# Welcome new members in the system channel (or WELCOME_CHANNEL_ID)
WELCOME_ENABLED=true
WELCOME_CHANNEL_ID=0
# Locked voice channel at the top showing "Linked: N"
STATS_CHANNEL=true
# Don't re-send the welcome DM if one was sent within this many minutes (re-links)
DM_COOLDOWN_MINUTES=60
# Retries for transient errors (Discord 5xx / network)
MAX_ATTEMPTS=5
# Daily digest hour (UTC). 18 = 23:30 IST
DIGEST_HOUR_UTC=18
# Locked voice channel "🎮 Playing now: N" (linked players currently in game)
PLAYING_CHANNEL=true
