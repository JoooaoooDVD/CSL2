# ---- Discord ------------------------------------------------------------------
# Bot token from https://discord.com/developers/applications -> YOUR APP -> Bot
# IMPORTANT: this must be the SAME application as the launcher's Social SDK app id
# (DiscordPresenceManager.APPLICATION_ID), otherwise guilds.join tokens are rejected.
DISCORD_BOT_TOKEN=
# Craft Studio server id (Developer Mode -> right click server -> Copy ID)
GUILD_ID=
# Role given to linked players (create a role e.g. "Linked" and copy its id). 0 = no role
LINKED_ROLE_ID=0
# Channel where link / unlink events are posted. 0 = off
LOG_CHANNEL_ID=0
# Optional staff role allowed to use /links lookup|sync|queue (admins always can)
ADMIN_ROLE_ID=0

# ---- Supabase (service role key - NEVER ship this in the app) ----------------
SUPABASE_URL=https://ygteavpkursyeyfthlxm.supabase.co
SUPABASE_SERVICE_KEY=

# ---- Optional ------------------------------------------------------------------
POLL_SECONDS=10
DISCORD_INVITE_URL=https://discord.gg/craftstudio
YOUTUBE_URL=https://youtube.com/@craft-studio-official
WEBSITE_URL=
LAUNCHER_NAME=CS Launcher Plus
COMMUNITY_NAME=Craft Studio
EMBED_COLOR=0x5865F2
DM_ON_UNLINK=true
LOG_LEVEL=INFO
