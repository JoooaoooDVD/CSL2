<?xml version="1.0" encoding="utf-8"?>
<!--
    CS press feedback for buttons and menu rows.
    Quick 96% squash on press, emphasized-decelerate release. Scale only - GPU-composited.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:valueTo="0.96"
                android:valueType="floatType"
                android:duration="80"
                android:interpolator="@interpolator/cs_standard" />
            <objectAnimator
                android:propertyName="scaleY"
                android:valueTo="0.96"
                android:valueType="floatType"
                android:duration="80"
                android:interpolator="@interpolator/cs_standard" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator
                android:propertyName="scaleX"
                android:valueTo="1.0"
                android:valueType="floatType"
                android:duration="220"
                android:interpolator="@interpolator/cs_emphasized_decelerate" />
            <objectAnimator
                android:propertyName="scaleY"
                android:valueTo="1.0"
                android:valueType="floatType"
                android:duration="220"
                android:interpolator="@interpolator/cs_emphasized_decelerate" />
        </set>
    </item>
</selector>
