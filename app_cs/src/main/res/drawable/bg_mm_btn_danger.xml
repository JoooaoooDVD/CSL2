<?xml version="1.0" encoding="utf-8"?>
<!-- Manager delete button -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="160">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/mm_danger_fill" />
            
            <stroke android:width="1dp" android:color="@color/mm_danger_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/hm_field" />
            
            <stroke android:width="1dp" android:color="@color/hm_inner_stroke" />
        </shape>
    </item>
</selector>
