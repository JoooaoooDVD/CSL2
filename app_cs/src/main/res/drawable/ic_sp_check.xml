<?xml version="1.0" encoding="utf-8"?>
<!-- Settings popup: check box mark (selected = filled box with a tick) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120"
    android:exitFadeDuration="120">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/hm_text" />
                    <corners android:radius="6dp" />
                    <size android:width="20dp" android:height="20dp" />
                </shape>
            </item>
            <item android:drawable="@drawable/ic_sp_check_mark" />
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="@color/hm_text_dim" />
            <corners android:radius="6dp" />
            <size android:width="20dp" android:height="20dp" />
        </shape>
    </item>
</selector>
