<?xml version="1.0" encoding="utf-8"?>
<!-- Round back button -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120"
    android:exitFadeDuration="200">
    <item android:state_pressed="true">
        <shape android:shape="oval">
        <solid android:color="@color/pe_field_pressed" />
        <stroke android:width="1dp" android:color="@color/pe_btn_dark_stroke" />
    </shape>
    </item>
    <item>
        <shape android:shape="oval">
        <solid android:color="@color/pe_round_button_bg" />
        <stroke android:width="1dp" android:color="@color/pe_card_stroke" />
    </shape>
    </item>
</selector>
