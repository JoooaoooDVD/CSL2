<?xml version="1.0" encoding="utf-8"?>
<!-- Settings popup: radio mark (selected = filled dot) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120"
    android:exitFadeDuration="120">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="2dp" android:color="@color/hm_text" />
                    <size android:width="20dp" android:height="20dp" />
                </shape>
            </item>
            <item android:bottom="5dp" android:left="5dp" android:right="5dp" android:top="5dp">
                <shape android:shape="oval">
                    <solid android:color="@color/hm_text" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke android:width="2dp" android:color="@color/hm_text_dim" />
            <size android:width="20dp" android:height="20dp" />
        </shape>
    </item>
</selector>
