<?xml version="1.0" encoding="utf-8"?>
<!-- Left + bottom shade so the wordmark and pills stay readable -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#B3070708" android:centerColor="#26070708" android:endColor="#00070708" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#80070708" android:centerColor="#00070708" android:endColor="#00070708" />
        </shape>
    </item>
</layer-list>
