<?xml version="1.0" encoding="utf-8"?>
<!-- "Explore" pill on the home partner strip -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#40D9B356" />
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="#80D9B356" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1FD9B356" />
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="#66D9B356" />
        </shape>
    </item>
</selector>
