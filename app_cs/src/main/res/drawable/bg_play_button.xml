<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:startColor="?attr/colorSurfaceBright" android:endColor="?attr/colorSurfaceBright" android:angle="0" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceContainerHighest" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="?attr/colorPrimaryContainer" android:endColor="?attr/colorSurfaceBright" android:angle="270" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>