<?xml version="1.0" encoding="utf-8"?>
<!-- Gliding pill behind the selected source, Modrinth flavour -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#2A5A3F" android:endColor="#1F4731" />
            <corners android:radius="13dp" />
            <stroke android:width="1.5dp" android:color="@color/lib_src_modrinth" />
        </shape>
    </item>
    <item android:bottom="0dp" android:top="0dp" android:left="0dp" android:right="0dp">
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#00FFFFFF" android:endColor="#1AFFFFFF" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</layer-list>
