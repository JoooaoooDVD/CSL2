<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#26FFFFFF" /><stroke android:width="1dp" android:color="#4A4A54" /><corners android:radius="100dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#00000000" /><stroke android:width="1dp" android:color="#3A3A44" /><corners android:radius="100dp" /></shape>
    </item>
</selector>
