<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="160">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#FF2A3754" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#FF16213A" />
            <stroke android:width="1dp" android:color="#FF22304C" />
        </shape>
    </item>
</selector>
