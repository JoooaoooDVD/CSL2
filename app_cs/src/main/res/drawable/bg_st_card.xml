<?xml version="1.0" encoding="utf-8"?>
<!-- Settings hub category card -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120"
    android:exitFadeDuration="220">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pe_field_pressed" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/pe_btn_dark_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pe_card_bg" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/pe_card_stroke" />
        </shape>
    </item>
</selector>
