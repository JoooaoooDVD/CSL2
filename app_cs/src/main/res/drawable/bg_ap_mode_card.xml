<?xml version="1.0" encoding="utf-8"?>
<!-- Appearance picker: mode card, activated = selected -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="140">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hm_accent_fill" />
            <corners android:radius="18dp" />
            <stroke android:width="1.5dp" android:color="@color/hm_accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hm_card_pressed" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/hm_accent_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hm_inner" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="@color/hm_inner_stroke" />
        </shape>
    </item>
</selector>
