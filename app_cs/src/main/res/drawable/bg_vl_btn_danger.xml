<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#33F07A7A" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="@color/vl_bad" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vl_bad_bg" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="#55F07A7A" />
        </shape>
    </item>
</selector>
