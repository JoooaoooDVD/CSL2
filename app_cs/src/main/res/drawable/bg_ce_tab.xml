<?xml version="1.0" encoding="utf-8"?>
<!-- Control editor: small tab hanging from the top edge (opens the menu) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="160">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hm_card_pressed" />
            <corners android:bottomLeftRadius="16dp" android:bottomRightRadius="16dp"
                android:topLeftRadius="0dp" android:topRightRadius="0dp" />
            <stroke android:width="1dp" android:color="@color/hm_inner_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ce_handle" />
            <corners android:bottomLeftRadius="16dp" android:bottomRightRadius="16dp"
                android:topLeftRadius="0dp" android:topRightRadius="0dp" />
            <stroke android:width="1dp" android:color="@color/hm_inner_stroke" />
        </shape>
    </item>
</selector>
