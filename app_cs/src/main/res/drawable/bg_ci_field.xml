<?xml version="1.0" encoding="utf-8"?>
<!-- Create form input / dropdown field -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hm_field" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="@color/hm_accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hm_card_pressed" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="@color/hm_accent_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hm_field" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/hm_inner_stroke" />
        </shape>
    </item>
</selector>
