<?xml version="1.0" encoding="utf-8"?>
<!-- Tappable configuration row -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120"
    android:exitFadeDuration="220">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
        <solid android:color="@color/pe_field_pressed" />
        <corners android:radius="12dp" />
        <stroke android:width="1dp" android:color="@color/pe_btn_dark_stroke" />
    </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
        <solid android:color="@color/pe_field_bg" />
        <corners android:radius="12dp" />
        <stroke android:width="1dp" android:color="@color/pe_field_stroke" />
    </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
        <solid android:color="@color/pe_field_bg" />
        <corners android:radius="12dp" />
        <stroke android:width="1dp" android:color="@color/pe_field_stroke" />
    </shape>
    </item>
</selector>
