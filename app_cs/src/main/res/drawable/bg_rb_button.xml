<?xml version="1.0" encoding="utf-8"?>
<!-- Install button: filled when idle, outlined (state_selected) while busy/installed, dimmed when disabled -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/rb_tile" />
            <corners android:radius="11dp" />
            <stroke android:width="1dp" android:color="@color/rb_tile_stroke" />
        </shape>
    </item>
    <item android:state_selected="true" android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rb_tile_stroke" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rb_tile" />
            <corners android:radius="11dp" />
            <stroke android:width="1dp" android:color="@color/rb_field_focus" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFD5D9E0" />
            <corners android:radius="11dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rb_accent" />
            <corners android:radius="11dp" />
        </shape>
    </item>
</selector>
