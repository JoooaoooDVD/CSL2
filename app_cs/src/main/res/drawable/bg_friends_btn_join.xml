<?xml version="1.0" encoding="utf-8"?>
<!-- "Join World": green action button of the CS Friends inbox -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4D5FD38D" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="@color/vl_ok" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2E5FD38D" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="#805FD38D" />
        </shape>
    </item>
</selector>
