<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#C9C9D1" /><corners android:radius="100dp" /></shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle"><solid android:color="#4A4A52" /><corners android:radius="100dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#E8E8EE" /><corners android:radius="100dp" /></shape>
    </item>
</selector>
