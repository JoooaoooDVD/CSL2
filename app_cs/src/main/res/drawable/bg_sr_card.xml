<?xml version="1.0" encoding="utf-8"?>
<!-- Settings row card (same family as the hub cards) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="100" android:exitFadeDuration="220">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pe_field_pressed" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="?attr/colorPrimary" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/pe_card_bg" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/pe_card_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pe_card_bg" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/pe_card_stroke" />
        </shape>
    </item>
</selector>
