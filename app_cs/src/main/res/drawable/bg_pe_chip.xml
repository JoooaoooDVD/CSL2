<?xml version="1.0" encoding="utf-8"?>
<!-- Selectable chip on light settings pages -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pe_btn_primary_bg" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pe_chip_bg" />
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="@color/pe_field_stroke" />
        </shape>
    </item>
</selector>
