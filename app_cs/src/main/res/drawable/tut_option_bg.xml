<?xml version="1.0" encoding="utf-8"?>
<!-- Selectable option card of the setup wizard; "selected" = platinum stroke -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle"><solid android:color="#22222A" /><stroke android:width="1.5dp" android:color="#C6C6CE" /><corners android:radius="14dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#202026" /><stroke android:width="1dp" android:color="#3A3A44" /><corners android:radius="14dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#18181D" /><stroke android:width="1dp" android:color="#2A2A30" /><corners android:radius="14dp" /></shape>
    </item>
</selector>
