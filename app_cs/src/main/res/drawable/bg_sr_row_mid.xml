<?xml version="1.0" encoding="utf-8"?>
<!-- Settings row inside a grouped card (bg_sr_row_mid) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="90" android:exitFadeDuration="200">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pe_field_pressed" />
            <corners android:topLeftRadius="0dp" android:topRightRadius="0dp" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pe_card_bg" />
            <corners android:topLeftRadius="0dp" android:topRightRadius="0dp" android:bottomLeftRadius="0dp" android:bottomRightRadius="0dp" />
        </shape>
    </item>
</selector>
