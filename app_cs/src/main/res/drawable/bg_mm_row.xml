<?xml version="1.0" encoding="utf-8"?>
<!-- Manager content row -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="160">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hm_card_pressed" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/hm_accent_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hm_card" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/hm_card_stroke" />
        </shape>
    </item>
</selector>
