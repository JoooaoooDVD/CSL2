<?xml version="1.0" encoding="utf-8"?>
<!-- Text field of the profile editor -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="150"
    android:exitFadeDuration="200">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
        <solid android:color="@color/pe_field_bg" />
        <corners android:radius="12dp" />
        <stroke android:width="1dp" android:color="@color/pe_chip_selected_stroke" />
    </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
        <solid android:color="@color/pe_field_bg" />
        <corners android:radius="12dp" />
        <stroke android:width="1dp" android:color="@color/pe_field_stroke" />
    </shape>
    </item>
</selector>
