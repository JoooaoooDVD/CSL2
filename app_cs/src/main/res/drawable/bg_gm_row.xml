<?xml version="1.0" encoding="utf-8"?>
<!-- In-game menu row: inset gives the gap between rows inside the ListView -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="140"
    android:enterFadeDuration="60">
    <item android:state_pressed="true">
        <inset android:insetTop="3dp" android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <solid android:color="#FF2E2E34" />
                <corners android:radius="14dp" />
                <stroke android:width="1dp" android:color="#FF4C4C55" />
            </shape>
        </inset>
    </item>
    <item android:state_focused="true">
        <inset android:insetTop="3dp" android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <solid android:color="#FF26262C" />
                <corners android:radius="14dp" />
                <stroke android:width="1dp" android:color="#FF4C4C55" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetTop="3dp" android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <solid android:color="#FF1D1D21" />
                <corners android:radius="14dp" />
                <stroke android:width="1dp" android:color="#FF2A2A30" />
            </shape>
        </inset>
    </item>
</selector>
