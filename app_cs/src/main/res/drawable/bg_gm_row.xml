<?xml version="1.0" encoding="utf-8"?>
<!-- In-game menu row: inset gives the gap between rows inside the ListView -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="140"
    android:enterFadeDuration="60">
    <item android:state_pressed="true">
        <inset android:insetTop="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="#FF333339" />
                <corners android:radius="16dp" />
                <stroke android:width="1dp" android:color="#FF54545E" />
            </shape>
        </inset>
    </item>
    <item android:state_focused="true">
        <inset android:insetTop="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="#FF28282E" />
                <corners android:radius="16dp" />
                <stroke android:width="1dp" android:color="#FF54545E" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetTop="4dp" android:insetBottom="4dp">
            <shape android:shape="rectangle">
                <solid android:color="#FF1B1B20" />
                <corners android:radius="16dp" />
                <stroke android:width="1dp" android:color="#FF2C2C33" />
            </shape>
        </inset>
    </item>
</selector>
