<?xml version="1.0" encoding="utf-8"?>
<!-- In-game menu row: inset gives the gap between rows inside the ListView -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="140"
    android:enterFadeDuration="60">
    <item android:state_pressed="true">
        <inset android:insetTop="3dp" android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <solid android:color="#FF25324F" />
                <corners android:radius="14dp" />
                <stroke android:width="1dp" android:color="#FF3D4B6B" />
            </shape>
        </inset>
    </item>
    <item android:state_focused="true">
        <inset android:insetTop="3dp" android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <solid android:color="#FF1D2843" />
                <corners android:radius="14dp" />
                <stroke android:width="1dp" android:color="#FF3D4B6B" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:insetTop="3dp" android:insetBottom="3dp">
            <shape android:shape="rectangle">
                <solid android:color="#FF16213A" />
                <corners android:radius="14dp" />
                <stroke android:width="1dp" android:color="#FF222D48" />
            </shape>
        </inset>
    </item>
</selector>
