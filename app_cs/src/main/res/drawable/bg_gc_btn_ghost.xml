<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/hm_accent_fill" /><corners android:radius="14dp" /><stroke android:width="1dp" android:color="@color/hm_accent_stroke" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/hm_inner" /><corners android:radius="14dp" /><stroke android:width="1dp" android:color="@color/hm_inner_stroke" /></shape>
    </item>
</selector>
