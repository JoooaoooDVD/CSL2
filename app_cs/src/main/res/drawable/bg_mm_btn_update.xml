<?xml version="1.0" encoding="utf-8"?>
<!-- Manager update button (an update is available) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="160">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/hm_amber_fill" />
            
            <stroke android:width="1dp" android:color="@color/hm_amber" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/hm_amber_fill" />
            
            <stroke android:width="1dp" android:color="@color/hm_amber_stroke" />
        </shape>
    </item>
</selector>
