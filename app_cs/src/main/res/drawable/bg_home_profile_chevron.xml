<?xml version="1.0" encoding="utf-8"?>
<!-- Round chevron button of the selected profile card -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/hm_accent_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/hm_accent_fill" />
            <stroke android:width="1dp" android:color="@color/hm_accent_stroke" />
        </shape>
    </item>
</selector>
