<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/vl_tile" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="@color/vl_tile_stroke" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vl_platinum_pressed" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vl_platinum" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</selector>
