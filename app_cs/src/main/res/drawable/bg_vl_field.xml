<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vl_field" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/vl_field_focus" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vl_field" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/vl_field_stroke" />
        </shape>
    </item>
</selector>
