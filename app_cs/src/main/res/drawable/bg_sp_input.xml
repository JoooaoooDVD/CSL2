<?xml version="1.0" encoding="utf-8"?>
<!-- Settings popup: text field -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120"
    android:exitFadeDuration="120">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hm_card_pressed" />
            <stroke android:width="1.5dp" android:color="@color/hm_text_dim" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hm_card_pressed" />
            <stroke android:width="1dp" android:color="@color/hm_inner_stroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
