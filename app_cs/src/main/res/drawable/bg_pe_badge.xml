<?xml version="1.0" encoding="utf-8"?>
<!-- Circular pencil badge over the previews -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120"
    android:exitFadeDuration="200">
    <item android:state_pressed="true">
        <shape android:shape="oval">
        <solid android:color="@color/pe_field_pressed" />
        <stroke android:width="1dp" android:color="@color/pe_badge_stroke" />
    </shape>
    </item>
    <item>
        <shape android:shape="oval">
        <solid android:color="@color/pe_badge_bg" />
        <stroke android:width="1dp" android:color="@color/pe_badge_stroke" />
    </shape>
    </item>
</selector>
