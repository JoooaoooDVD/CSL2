<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="100" android:exitFadeDuration="220">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/hm_card_pressed" /><corners android:radius="18dp" /><stroke android:width="1dp" android:color="@color/hm_text_dim" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#F4F5F8" /><corners android:radius="18dp" /><stroke android:width="1dp" android:color="@color/hm_card_stroke" /></shape>
    </item>
</selector>
