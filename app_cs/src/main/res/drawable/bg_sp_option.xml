<?xml version="1.0" encoding="utf-8"?>
<!-- Settings popup: choice row (single colour; the chosen row gets a soft fill + outline) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="90"
    android:exitFadeDuration="160">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hm_card_pressed" />
            <stroke android:width="1dp" android:color="@color/hm_inner_stroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hm_card_pressed" />
            <stroke android:width="1dp" android:color="@color/hm_inner_stroke" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
