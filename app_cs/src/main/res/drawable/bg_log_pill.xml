<?xml version="1.0" encoding="utf-8"?>
<!-- Toggle pill (Live / Auto-scroll) and filter chip: selected = filled -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="120"
    android:exitFadeDuration="160">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2A3754" />
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="#FF3D4B6B" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF22304C" />
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="#FF55658A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="#FF22304C" />
        </shape>
    </item>
</selector>
