<?xml version="1.0" encoding="utf-8"?>
<!-- Control editor panel: exit row -->
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:exitFadeDuration="160">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/mm_danger_fill" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/mm_danger" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hm_field" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/mm_danger_stroke" />
        </shape>
    </item>
</selector>
