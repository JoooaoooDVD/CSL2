<?xml version="1.0" encoding="utf-8"?>
<!-- Download/install progress bar: charcoal track, bright silver fill, soft border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#FF16161A" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#FF2E2E34" />
        </shape>
    </item>

    <item
        android:id="@android:id/progress"
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:startColor="#FFD7D7DD"
                    android:centerColor="#FFF2F5FA"
                    android:endColor="#FFB9B9C2" />
                <corners android:radius="8dp" />
            </shape>
        </clip>
    </item>

</layer-list>
