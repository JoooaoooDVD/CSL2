<?xml version="1.0" encoding="utf-8"?>
<!-- Selected profile card: soft accent glow growing towards the chevron (brighter when pressed) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/hm_accent_clear"
                android:centerColor="@color/hm_accent_clear" android:endColor="@color/hm_accent_fill" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="@color/hm_accent_clear"
                android:centerColor="@color/hm_accent_clear" android:endColor="@color/hm_accent_soft" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
