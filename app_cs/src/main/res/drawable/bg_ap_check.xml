<?xml version="1.0" encoding="utf-8"?>
<!-- Appearance picker: round check indicator, activated = on -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="140">
    <item android:state_activated="true">
        <shape android:shape="oval">
            <solid android:color="@color/hm_text" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/hm_inner_stroke" />
        </shape>
    </item>
</selector>
