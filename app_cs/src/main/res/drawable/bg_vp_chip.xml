<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="120" android:exitFadeDuration="200">
    <item android:state_selected="true">
        <shape android:shape="rectangle"><solid android:color="@color/hm_accent" /><corners android:radius="18dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#2E3440" /><corners android:radius="18dp" /><stroke android:width="1dp" android:color="@color/hm_card_stroke" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#1C1F26" /><corners android:radius="18dp" /><stroke android:width="1dp" android:color="@color/hm_card_stroke" /></shape>
    </item>
</selector>
