<?xml version="1.0" encoding="utf-8"?>
<!-- Thick rounded slider track: dim background + primary progress -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <size android:height="6dp" />
            <solid android:color="@color/pe_field_pressed" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="6dp" />
                <solid android:color="@android:color/transparent" />
                <corners android:radius="3dp" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="6dp" />
                <solid android:color="?attr/colorPrimary" />
                <corners android:radius="3dp" />
            </shape>
        </clip>
    </item>
</layer-list>
