<?xml version="1.0" encoding="utf-8"?>
<!-- Slider track: soft inset rail + ink progress -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <size android:height="8dp" />
            <solid android:color="@color/pe_field_bg" />
            <corners android:radius="4dp" />
            <stroke android:width="1dp" android:color="@color/pe_field_stroke" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="8dp" />
                <solid android:color="@android:color/transparent" />
                <corners android:radius="4dp" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="8dp" />
                <solid android:color="@color/pe_btn_primary_bg" />
                <corners android:radius="4dp" />
            </shape>
        </clip>
    </item>
</layer-list>
