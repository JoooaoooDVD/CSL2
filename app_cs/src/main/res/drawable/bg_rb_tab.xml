<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="140" android:enterFadeDuration="80">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rb_tab_on" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/rb_tile" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rb_tab_off" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
