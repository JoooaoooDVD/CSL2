<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary button: a raised tile with a visible edge so it reads as a button on any card -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="120">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="@color/vl_card_stroke" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vl_btn_pressed" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="@color/vl_btn_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vl_btn" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="@color/vl_btn_stroke" />
        </shape>
    </item>
</selector>
