<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="140" android:exitFadeDuration="220">
    <item android:state_activated="true">
        <shape android:shape="rectangle"><solid android:color="#232A36" /><corners android:radius="16dp" /><stroke android:width="1.5dp" android:color="@color/hm_accent" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#242933" /><corners android:radius="16dp" /><stroke android:width="1dp" android:color="@color/hm_card_stroke" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#1A1E25" /><corners android:radius="16dp" /><stroke android:width="1dp" android:color="@color/hm_card_stroke" /></shape>
    </item>
</selector>
