<?xml version="1.0" encoding="utf-8"?>
<!-- Slider thumb: ink disc with a card-coloured ring, grows while pressed -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <size android:width="26dp" android:height="26dp" />
                    <solid android:color="@color/pe_btn_primary_bg" />
                    <stroke android:width="4dp" android:color="@color/pe_card_bg" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <size android:width="22dp" android:height="22dp" />
                    <solid android:color="@color/pe_btn_primary_bg" />
                    <stroke android:width="4dp" android:color="@color/pe_card_bg" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
