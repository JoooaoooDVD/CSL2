<?xml version="1.0" encoding="utf-8"?>
<!-- Appearance picker: preset chip (Everything / Home screen only / Custom), activated = current -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="140">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hm_text" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hm_card_pressed" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/hm_accent_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="@color/hm_inner_stroke" />
        </shape>
    </item>
</selector>
