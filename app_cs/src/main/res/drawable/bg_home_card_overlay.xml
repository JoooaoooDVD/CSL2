<?xml version="1.0" encoding="utf-8"?>
<!-- Hairline above the card artwork; brightens while pressed -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1FFFFFFF" />
            <corners android:radius="16dp" />
            <stroke android:width="1.5dp" android:color="@color/hm_tile_blue_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/hm_card_stroke" />
        </shape>
    </item>
</selector>
