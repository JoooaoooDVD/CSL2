<?xml version="1.0" encoding="utf-8"?>
<!-- Partner hero card: dark panel with a faint warm light from the top-left -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF1A1D25" android:centerColor="#FF24201F" android:endColor="#FF17171B" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#FF3A342C" />
        </shape>
    </item>
    <item android:bottom="40dp" android:right="140dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="150dp" android:centerX="0.2" android:centerY="0.1" android:startColor="#2ED9B356" android:endColor="#00D9B356" />
        </shape>
    </item>
</layer-list>
