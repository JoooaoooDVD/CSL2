<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom sheet style entrance: emphasized-decelerate rise with a fade. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="false">
    <translate android:duration="320" android:fromYDelta="40%" android:toYDelta="0"
        android:interpolator="@interpolator/cs_emphasized_decelerate" />
    <alpha android:duration="160" android:fromAlpha="0.0" android:toAlpha="1"
        android:interpolator="@interpolator/cs_standard" />
</set>
