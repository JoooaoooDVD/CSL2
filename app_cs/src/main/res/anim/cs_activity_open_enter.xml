<?xml version="1.0" encoding="utf-8"?>
<!--
    CS motion - activity open (forward). Short 4% slide with an emphasized-decelerate landing
    and a fade: both GPU-composited, no layout passes, smooth on low-end phones.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <translate
        android:fromXDelta="4%p"
        android:toXDelta="0"
        android:duration="300"
        android:interpolator="@interpolator/cs_emphasized_decelerate" />
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:duration="180"
        android:interpolator="@interpolator/cs_standard" />
</set>
