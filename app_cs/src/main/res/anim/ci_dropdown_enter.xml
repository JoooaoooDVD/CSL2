<?xml version="1.0" encoding="utf-8"?>
<!-- Create form dropdown: grows from its field with a fade -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/decelerate_interpolator"
    android:shareInterpolator="true">
    <scale android:duration="200" android:fromXScale="0.96" android:fromYScale="0.88"
        android:pivotX="50%" android:pivotY="0%" android:toXScale="1.0" android:toYScale="1.0" />
    <alpha android:duration="160" android:fromAlpha="0.0" android:toAlpha="1.0" />
</set>
