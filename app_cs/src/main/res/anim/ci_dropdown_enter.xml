<?xml version="1.0" encoding="utf-8"?>
<!-- Dropdown / picker: grows from its anchor with a fade (emphasized decelerate). -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/cs_emphasized_decelerate"
    android:shareInterpolator="true">
    <scale android:duration="240" android:fromXScale="0.97" android:fromYScale="0.90"
        android:pivotX="50%" android:pivotY="0%" android:toXScale="1.0" android:toYScale="1.0" />
    <alpha android:duration="140" android:fromAlpha="0.0" android:toAlpha="1.0" />
</set>
