<?xml version="1.0" encoding="utf-8"?>
<!-- Dialog pop-in: small scale with an emphasized-decelerate landing + fade. Calm, never bouncy. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <scale
        android:fromXScale="0.92"
        android:toXScale="1.0"
        android:fromYScale="0.92"
        android:toYScale="1.0"
        android:pivotX="50%"
        android:pivotY="50%"
        android:duration="260"
        android:interpolator="@interpolator/cs_emphasized_decelerate" />
    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0"
        android:duration="150"
        android:interpolator="@interpolator/cs_standard" />
</set>
