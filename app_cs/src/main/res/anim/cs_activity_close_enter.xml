<?xml version="1.0" encoding="utf-8"?>
<!-- Activity close: the screen behind settles back from its parallax offset. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:shareInterpolator="false">
    <translate
        android:fromXDelta="-2%p"
        android:toXDelta="0"
        android:duration="260"
        android:interpolator="@interpolator/cs_emphasized_decelerate" />
    <alpha
        android:fromAlpha="0.9"
        android:toAlpha="1.0"
        android:duration="160"
        android:interpolator="@interpolator/cs_standard" />
</set>
