<?xml version="1.0" encoding="utf-8"?>
<!-- Discord login for the game status (Rich Presence). Single colour top bar + web page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hm_dialog"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/dl_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageView
            android:id="@+id/dl_close"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_pp_round_btn"
            android:clickable="true"
            android:contentDescription="@string/pp_close"
            android:focusable="true"
            android:padding="10dp"
            android:src="@drawable/ic_pp_close" />

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_sp_icon_tile">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_discord_mark"
                android:tint="@color/hm_icon" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/discord_login_title"
                android:textColor="@color/hm_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dl_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/discord_login_subtitle"
                android:textColor="@color/hm_text_dim"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/dl_progress"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:indeterminateTint="@color/hm_text_dim" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/hm_divider" />

    <FrameLayout
        android:id="@+id/dl_web_holder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
