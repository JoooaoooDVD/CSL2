<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/as_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_ac_card"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="6dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:id="@+id/as_tile"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/bg_ac_top_custom_tile">

        <TextView
            android:id="@+id/as_initial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/minecraft_ten"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/as_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/noto_sans_bold"
            android:maxLines="1"
            android:textColor="@color/hm_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/as_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/hm_text_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/as_remove"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_pp_round_btn"
        android:contentDescription="@string/auth_remove_server"
        android:padding="10dp"
        android:src="@drawable/ic_pe_trash"
        android:tint="@color/hm_text_dim" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="2dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_sl_chevron"
        android:tint="@color/hm_text_dim" />
</LinearLayout>
