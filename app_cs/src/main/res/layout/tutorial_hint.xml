<?xml version="1.0" encoding="utf-8"?>
<!-- Small self-dismissing hint chip (ContextualHelp): "Learn this screen" / "Resume tutorial" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tut_hint_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/tut_card_bg"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:maxWidth="520dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="6dp"
    android:paddingEnd="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_tut_help"
        android:tint="#C6C6CE"
        tools:ignore="UseAppTint" />

    <TextView
        android:id="@+id/tut_hint_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:maxWidth="300dp"
        android:textColor="#F2F5FA"
        android:textSize="12.5sp"
        tools:text="New here? Learn the Browse resources screen." />

    <TextView
        android:id="@+id/tut_hint_action"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/tut_btn_primary"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#101014"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="Start" />

    <ImageButton
        android:id="@+id/tut_hint_close"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/tut_icon_btn"
        android:contentDescription="@string/tut_close"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_tut_close" />
</LinearLayout>
