<?xml version="1.0" encoding="utf-8"?>
<!-- Play Time: how much, what and when the player has played (right pane screen) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <!-- Banner -->
    <FrameLayout
        android:id="@+id/pt_banner"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_banner_card"
        android:clipToOutline="true">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/banner_gradient_playtime" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/settings_header_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_settings_icon_box"
                android:contentDescription="@null"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_dock_playtime" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/pt_title"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/pt_subtitle"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/pt_refresh_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_button_home"
                android:contentDescription="@string/pt_title"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_refresh_home"
                android:stateListAnimator="?attr/csPressAnimator" />
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:id="@+id/pt_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingHorizontal="10dp"
        android:paddingBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/pt_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Live session -->
            <LinearLayout
                android:id="@+id/pt_live"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_pt_live"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:id="@+id/pt_live_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_vl_dot"
                    android:backgroundTint="@color/vl_ok" />

                <TextView
                    android:id="@+id/pt_live_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/vl_ok"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    tools:text="Minecraft is running right now · Fabric 1.21.1 · 12m 4s" />
            </LinearLayout>

            <!-- Hero: total time + today -->
            <LinearLayout
                android:id="@+id/pt_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pt_hero"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="14dp"
                android:paddingEnd="12dp"
                android:paddingBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.2"
                        android:text="@string/pt_total_label"
                        android:textAllCaps="true"
                        android:textColor="@color/vl_text_faint"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/pt_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:fontFamily="@font/minecraft_ten"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="@color/vl_text"
                        android:textSize="30sp"
                        tools:text="38h 12m" />

                    <TextView
                        android:id="@+id/pt_total_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textColor="@color/vl_text_dim"
                        android:textSize="11.5sp"
                        tools:text="38 hours 12 minutes · 54 sessions" />

                    <LinearLayout
                        android:id="@+id/pt_chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/pt_chip_streak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pt_chip"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/vl_text"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            tools:text="🔥 4 day streak" />

                        <TextView
                            android:id="@+id/pt_chip_days"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_pt_chip"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/vl_text"
                            android:textSize="10.5sp"
                            android:textStyle="bold"
                            tools:text="12 days played" />

                        <TextView
                            android:id="@+id/pt_chip_since"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_pt_chip"
                            android:paddingHorizontal="9dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/vl_text_dim"
                            android:textSize="10.5sp"
                            tools:text="since 12 Sep" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Today tile -->
                <LinearLayout
                    android:id="@+id/pt_today_tile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_pt_today_tile"
                    android:gravity="center"
                    android:minWidth="104dp"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.2"
                        android:text="@string/pt_stat_today"
                        android:textAllCaps="true"
                        android:textColor="#FF55596A"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/pt_today_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/minecraft_ten"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="#FF0E0E11"
                        android:textSize="20sp"
                        tools:text="1h 12m" />

                    <TextView
                        android:id="@+id/pt_today_delta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:singleLine="true"
                        android:textColor="#FF55596A"
                        android:textSize="10sp"
                        tools:text="▲ 20m vs yesterday" />
                </LinearLayout>
            </LinearLayout>

            <!-- This week chart -->
            <LinearLayout
                android:id="@+id/pt_week_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_vl_card"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.18"
                        android:text="@string/pt_stat_week"
                        android:textAllCaps="true"
                        android:textColor="@color/vl_text_faint"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/pt_week_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/vl_text"
                        android:textSize="13sp"
                        tools:text="6h 40m" />
                </LinearLayout>

                <com.craftstudio.cslauncher.stats.WeekChartView
                    android:id="@+id/pt_week_chart"
                    android:layout_width="match_parent"
                    android:layout_height="132dp"
                    android:layout_marginTop="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_vl_tile"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="7dp">

                    <TextView
                        android:id="@+id/pt_week_day_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/vl_text"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Today · Wed 29 Oct" />

                    <TextView
                        android:id="@+id/pt_week_day_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:singleLine="true"
                        android:textColor="@color/vl_text_dim"
                        android:textSize="11.5sp"
                        tools:text="1h 12m · 3 sessions" />
                </LinearLayout>
            </LinearLayout>

            <!-- Stat grid -->
            <LinearLayout
                android:id="@+id/pt_stats_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/pt_stats_row1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include android:id="@+id/pt_stat_sessions" layout="@layout/view_play_time_stat" />
                    <Space android:layout_width="6dp" android:layout_height="1dp" />
                    <include android:id="@+id/pt_stat_average" layout="@layout/view_play_time_stat" />
                    <Space android:layout_width="6dp" android:layout_height="1dp" />
                    <include android:id="@+id/pt_stat_longest" layout="@layout/view_play_time_stat" />
                    <Space android:layout_width="6dp" android:layout_height="1dp" />
                    <include android:id="@+id/pt_stat_shortest" layout="@layout/view_play_time_stat" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pt_stats_row2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <include android:id="@+id/pt_stat_yesterday" layout="@layout/view_play_time_stat" />
                    <Space android:layout_width="6dp" android:layout_height="1dp" />
                    <include android:id="@+id/pt_stat_lastweek" layout="@layout/view_play_time_stat" />
                    <Space android:layout_width="6dp" android:layout_height="1dp" />
                    <include android:id="@+id/pt_stat_month" layout="@layout/view_play_time_stat" />
                    <Space android:layout_width="6dp" android:layout_height="1dp" />
                    <include android:id="@+id/pt_stat_beststreak" layout="@layout/view_play_time_stat" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pt_stats_row3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <include android:id="@+id/pt_stat_topday" layout="@layout/view_play_time_stat" />
                    <Space android:layout_width="6dp" android:layout_height="1dp" />
                    <include android:id="@+id/pt_stat_favtime" layout="@layout/view_play_time_stat" />
                    <Space android:layout_width="6dp" android:layout_height="1dp" />
                    <include android:id="@+id/pt_stat_last" layout="@layout/view_play_time_stat" />
                    <Space android:layout_width="6dp" android:layout_height="1dp" />
                    <include android:id="@+id/pt_stat_topprofile" layout="@layout/view_play_time_stat" />
                </LinearLayout>
            </LinearLayout>

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/pt_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_vl_card"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="26dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:alpha="0.7"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_dock_playtime" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/pt_empty_title"
                    android:textColor="@color/vl_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/pt_empty_desc"
                    android:textColor="@color/vl_text_dim"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- By profile -->
            <LinearLayout
                android:id="@+id/pt_profiles_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_vl_card"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:letterSpacing="0.18"
                    android:text="@string/pt_section_profiles"
                    android:textAllCaps="true"
                    android:textColor="@color/vl_text_faint"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/pt_profiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Recent sessions -->
            <LinearLayout
                android:id="@+id/pt_sessions_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_vl_card"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:letterSpacing="0.18"
                    android:text="@string/pt_section_recent"
                    android:textAllCaps="true"
                    android:textColor="@color/vl_text_faint"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/pt_sessions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/pt_show_more"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:text="@string/pt_show_more"
                    android:textColor="@color/vl_text_dim"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
