<?xml version="1.0" encoding="utf-8"?>
<!-- Play Time: how much, what and when the player has played (right pane screen) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <!-- Banner -->
    <FrameLayout
        android:id="@+id/pt_banner"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_banner_card"
        android:clipToOutline="true">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/banner_gradient_playtime" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/settings_header_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_settings_icon_box"
                android:contentDescription="@null"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_dock_playtime" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/pt_title"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/pt_subtitle"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/pt_refresh_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_button_home"
                android:contentDescription="@string/pt_title"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_refresh_home"
                android:stateListAnimator="?attr/csPressAnimator" />
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:id="@+id/pt_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingHorizontal="10dp"
        android:paddingBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/pt_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Live session -->
            <LinearLayout
                android:id="@+id/pt_live"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_pt_live"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:id="@+id/pt_live_dot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_vl_dot"
                    android:backgroundTint="@color/vl_ok" />

                <TextView
                    android:id="@+id/pt_live_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/vl_ok"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    tools:text="Minecraft is running right now · Fabric 1.21.1 · 12m 4s" />
            </LinearLayout>

            <!-- Hero: total time -->
            <LinearLayout
                android:id="@+id/pt_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_vl_card"
                android:orientation="vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.18"
                    android:text="@string/pt_total_label"
                    android:textAllCaps="true"
                    android:textColor="@color/vl_text_faint"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pt_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/minecraft_ten"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="@color/vl_text"
                    android:textSize="26sp"
                    tools:text="38h 12m" />

                <TextView
                    android:id="@+id/pt_total_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/vl_text_dim"
                    android:textSize="11.5sp"
                    tools:text="38 hours 12 minutes · 54 sessions" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/pt_stat_today"
                        layout="@layout/view_play_time_stat" />

                    <Space
                        android:layout_width="6dp"
                        android:layout_height="1dp" />

                    <include
                        android:id="@+id/pt_stat_week"
                        layout="@layout/view_play_time_stat" />

                    <Space
                        android:layout_width="6dp"
                        android:layout_height="1dp" />

                    <include
                        android:id="@+id/pt_stat_sessions"
                        layout="@layout/view_play_time_stat" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/pt_stat_average"
                        layout="@layout/view_play_time_stat" />

                    <Space
                        android:layout_width="6dp"
                        android:layout_height="1dp" />

                    <include
                        android:id="@+id/pt_stat_longest"
                        layout="@layout/view_play_time_stat" />

                    <Space
                        android:layout_width="6dp"
                        android:layout_height="1dp" />

                    <include
                        android:id="@+id/pt_stat_last"
                        layout="@layout/view_play_time_stat" />
                </LinearLayout>

                <TextView
                    android:id="@+id/pt_since"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/vl_text_faint"
                    android:textSize="10.5sp"
                    tools:text="Playing since 12 Sep 2026" />
            </LinearLayout>

            <!-- Empty state -->
            <LinearLayout
                android:id="@+id/pt_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_vl_card"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="26dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:alpha="0.7"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_dock_playtime" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/pt_empty_title"
                    android:textColor="@color/vl_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/pt_empty_desc"
                    android:textColor="@color/vl_text_dim"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- By profile -->
            <LinearLayout
                android:id="@+id/pt_profiles_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_vl_card"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:letterSpacing="0.18"
                    android:text="@string/pt_section_profiles"
                    android:textAllCaps="true"
                    android:textColor="@color/vl_text_faint"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/pt_profiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Recent sessions -->
            <LinearLayout
                android:id="@+id/pt_sessions_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_vl_card"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:letterSpacing="0.18"
                    android:text="@string/pt_section_recent"
                    android:textAllCaps="true"
                    android:textColor="@color/vl_text_faint"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/pt_sessions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical"
                    android:showDividers="middle"
                    android:divider="@drawable/pt_divider" />

                <TextView
                    android:id="@+id/pt_show_more"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingVertical="8dp"
                    android:text="@string/pt_show_more"
                    android:textColor="@color/vl_text_dim"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
