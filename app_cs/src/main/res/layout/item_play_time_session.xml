<?xml version="1.0" encoding="utf-8"?>
<!-- One session row of the Play Time screen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="7dp"
    android:paddingEnd="4dp"
    android:paddingBottom="7dp">

    <View
        android:id="@+id/pt_session_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:background="@drawable/bg_vl_dot"
        android:backgroundTint="@color/vl_text_faint" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pt_session_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/vl_text"
            android:textSize="12.5sp"
            android:textStyle="bold"
            tools:text="Fabric 1.21.1" />

        <TextView
            android:id="@+id/pt_session_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/vl_text_dim"
            android:textSize="10.5sp"
            tools:text="26 Oct, 7:12 PM · 1.21.1" />
    </LinearLayout>

    <TextView
        android:id="@+id/pt_session_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true"
        android:textColor="@color/vl_text"
        android:textSize="12.5sp"
        tools:text="48m 10s" />
</LinearLayout>
