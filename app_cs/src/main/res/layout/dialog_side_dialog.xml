<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/_280sdp"
    android:layout_marginVertical="@dimen/padding_heavy"
    android:orientation="vertical"
    android:layout_height="wrap_content"
    android:layout_gravity="center_vertical"
    android:background="@drawable/background_control_editor">

    <!-- Header: icon tile + title (no banner) -->
    <LinearLayout
        android:id="@+id/side_dialog_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_pp_icon_tile">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_cc_sliders"
                app:tint="@color/hm_accent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/side_dialog_title_textview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/hm_text"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Edit control" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/side_dialog_title_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="4dp"
        android:background="@color/hm_divider"
        android:visibility="gone" />

    <com.kdt.DefocusableScrollView
        android:id="@+id/side_dialog_scrollview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="6dp"
        tools:background="@color/hm_dialog">
        <!-- The content is inflated here -->
    </com.kdt.DefocusableScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">

        <Button
            android:id="@+id/side_dialog_start_button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_ci_button_outline"
            android:stateListAnimator="?attr/csPressAnimator"
            android:textAllCaps="false"
            android:textColor="@color/hm_text"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Cancel" />

        <Button
            android:id="@+id/side_dialog_end_button"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_mm_tab_indicator"
            android:stateListAnimator="?attr/csPressAnimator"
            android:textAllCaps="false"
            android:textColor="@color/hm_text"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Confirm"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>