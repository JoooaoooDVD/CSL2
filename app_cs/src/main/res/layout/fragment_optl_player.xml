<?xml version="1.0" encoding="utf-8"?>
<!-- OPTL player profile: 3D skin (drag to turn), rank / points / overall tier, gamemode tiers. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/op_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_banner_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/op_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/about_back"
            android:padding="9dp"
            android:src="@drawable/ic_pe_back"
            android:tint="?attr/colorOnSurface" />

        <ImageView
            android:id="@+id/op_head"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/op_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/noto_sans_bold"
                    android:includeFontPadding="false"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    tools:text="jmz79" />
                <TextView
                    android:id="@+id/op_region"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_optl_tier_chip"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="9.5sp"
                    tools:text="AS" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:text="@string/optl_player_sub"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/op_site"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_optl_btn_ghost"
            android:fontFamily="@font/noto_sans_bold"
            android:includeFontPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:stateListAnimator="?attr/csPressAnimator"
            android:text="@string/optl_player_site"
            android:textColor="?attr/colorOnSurface"
            android:textSize="11sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero: 3D skin on the left, stats on the right -->
            <LinearLayout
                android:id="@+id/op_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_optl_me"
                android:orientation="horizontal"
                android:padding="12dp">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="250dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_optl_stage">
                    <com.craftstudio.cslauncher.skins.SkinModelView
                        android:id="@+id/op_model"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                    <TextView
                        android:id="@+id/op_skin_note"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_optl_tier_chip"
                        android:includeFontPadding="false"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        android:text="@string/optl_skin_hint"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="9.5sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.08"
                        android:text="@string/optl_player_overall"
                        android:textColor="#D9B356"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/op_tier"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/minecraft_ten"
                        android:includeFontPadding="false"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="22sp"
                        tools:text="Combat Ace" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_optl_tier_chip"
                            android:orientation="vertical"
                            android:padding="10dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.06"
                                android:text="@string/optl_player_rank"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="9.5sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/op_rank"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/jetbrains_mono"
                                android:includeFontPadding="false"
                                android:textColor="#D9B356"
                                android:textSize="20sp"
                                tools:text="#1" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_optl_tier_chip"
                            android:orientation="vertical"
                            android:padding="10dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.06"
                                android:text="@string/optl_player_points"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="9.5sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/op_points"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/jetbrains_mono"
                                android:includeFontPadding="false"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="20sp"
                                tools:text="218" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/optl_player_note"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="10.5sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Gamemode tiers -->
            <LinearLayout
                android:id="@+id/op_modes_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_partner_card"
                android:orientation="vertical"
                android:padding="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.08"
                        android:text="@string/optl_player_modes"
                        android:textColor="#D9B356"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/op_modes_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="10.5sp"
                        tools:text="7 gamemodes" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/op_modes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />
                <TextView
                    android:id="@+id/op_modes_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingVertical="14dp"
                    android:text="@string/optl_player_no_modes"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
