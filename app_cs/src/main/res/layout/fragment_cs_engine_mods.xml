<?xml version="1.0" encoding="utf-8"?>
<!-- CS Engine mod browser: the Horizon registry (index.json) rendered in the CS design -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingTop="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_mm_panel"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/cem_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_mm_btn"
            android:contentDescription="@string/hz_browser_back"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back_white"
            android:stateListAnimator="?attr/csPressAnimator" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/minecraft_ten"
                android:text="@string/hz_browser_title"
                android:textColor="@color/hm_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/cem_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/hz_browser_subtitle"
                android:textColor="@color/hm_text_dim"
                android:textSize="10.5sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_mm_tabs"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/cem_tab_mods"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/bg_mm_tab_indicator"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/hz_browser_tab_mods"
                android:textColor="@color/hm_text"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cem_tab_packs"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:text="@string/hz_browser_tab_packs"
                android:textColor="@color/hm_text_dim"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <EditText
        android:id="@+id/cem_search"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_mm_search"
        android:hint="@string/hz_browser_search_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:textColor="@color/hm_text"
        android:textColorHint="@color/hm_text_dim"
        android:textSize="13sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/cem_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="12dp" />

        <LinearLayout
            android:id="@+id/cem_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ProgressBar
                android:id="@+id/cem_progress"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminateTint="@color/hm_accent" />

            <TextView
                android:id="@+id/cem_state_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/hz_browser_loading"
                android:textColor="@color/hm_text_dim"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/cem_retry"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_cs_pill_dark"
                android:gravity="center"
                android:paddingHorizontal="18dp"
                android:text="@string/hz_browser_retry"
                android:textColor="@color/hm_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
