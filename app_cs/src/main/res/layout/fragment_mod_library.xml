<?xml version="1.0" encoding="utf-8"?>
<!-- Content library: mods / resource packs / shaders / modpacks browser -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/library_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:stateListAnimator="@null"
        app:elevation="0dp">

        <!-- Everything above the grid collapses as ONE block, so the reveal on scroll-up is smooth -->
        <LinearLayout
            android:id="@+id/library_collapsing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_scrollFlags="scroll|snap|snapMargins">

        <!-- Title block, scrolls away to give the grid more room -->
        <LinearLayout
            android:id="@+id/library_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/library_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/minecraft_ten"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.02"
                    android:maxLines="1"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="3"
                    android:shadowRadius="1"
                    android:text="@string/lib_title_mods"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="32sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/library_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:text="@string/lib_subtitle_mods"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="15sp" />

                    <!-- Active version/loader filter, tap to edit -->
                    <TextView
                        android:id="@+id/library_context_pill"
                        style="@style/Library.Badge"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_lib_badge_neutral"
                        android:clickable="true"
                        android:focusable="true"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textStyle="normal"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Content type selector: the pill indicator glides under the selected tab -->
            <FrameLayout
                android:id="@+id/library_type_tabs_frame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_lib_field"
                android:padding="4dp">

                <View
                    android:id="@+id/library_tab_indicator"
                    android:layout_width="0dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_lib_tab_indicator"
                    android:visibility="invisible" />

            <LinearLayout
                android:id="@+id/library_type_tabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/library_tab_mods"
                    style="@style/Library.Segment"
                    android:background="@drawable/bg_lib_segment_tab"
                    android:drawableStart="@drawable/ic_lib_cube"
                    android:text="@string/lib_tab_mods" />

                <TextView
                    android:id="@+id/library_tab_resourcepacks"
                    style="@style/Library.Segment"
                    android:background="@drawable/bg_lib_segment_tab"
                    android:layout_marginStart="2dp"
                    android:drawableStart="@drawable/ic_lib_image"
                    android:text="@string/lib_tab_resourcepacks" />

                <TextView
                    android:id="@+id/library_tab_shaders"
                    style="@style/Library.Segment"
                    android:background="@drawable/bg_lib_segment_tab"
                    android:layout_marginStart="2dp"
                    android:drawableStart="@drawable/ic_lib_sun"
                    android:text="@string/lib_tab_shaders" />

                <TextView
                    android:id="@+id/library_tab_worlds"
                    style="@style/Library.Segment"
                    android:background="@drawable/bg_lib_segment_tab"
                    android:layout_marginStart="2dp"
                    android:drawableStart="@drawable/ic_lib_world"
                    android:text="@string/lib_tab_worlds" />
            </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Content source switcher: Modrinth / CurseForge, the pill glides between them -->
        <FrameLayout
            android:id="@+id/library_source_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_lib_source_track"
            android:padding="4dp"
>

            <View
                android:id="@+id/library_source_indicator"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:background="@drawable/bg_lib_source_indicator_modrinth"
                android:visibility="invisible" />

            <LinearLayout
                android:id="@+id/library_source_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/library_source_modrinth"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_lib_source_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp">

                    <FrameLayout
                        android:id="@+id/library_source_modrinth_logo"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_lib_source_logo_modrinth"
                        android:padding="7dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_modrinth"
                            android:tint="#0B2A17" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/library_source_modrinth_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/lib_source_modrinth"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/library_source_modrinth_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/lib_source_modrinth_desc"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/library_source_modrinth_check"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_lib_check_badge"
                        android:tint="@color/lib_src_modrinth" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/library_source_curseforge"
                    android:layout_width="0dp"
                    android:layout_height="58dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_lib_source_item"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="8dp">

                    <FrameLayout
                        android:id="@+id/library_source_curseforge_logo"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_lib_source_logo_curseforge"
                        android:padding="7dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_curseforge"
                            android:tint="#FFFFFF" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/library_source_curseforge_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/lib_source_curseforge"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/library_source_curseforge_desc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/lib_source_curseforge_desc"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/library_source_curseforge_check"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_lib_check_badge"
                        android:tint="@color/lib_src_curseforge" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Search, categories and sort scroll away with the header so the grid gets the full screen -->
        <LinearLayout
            android:id="@+id/library_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/library_search_box"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1.2"
                android:background="@drawable/bg_lib_field"
                android:gravity="center_vertical"
                android:minWidth="150dp"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lib_search"
                    android:tint="?attr/colorOnSurfaceVariant" />

                <EditText
                    android:id="@+id/library_search_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/lib_search_mods"
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/library_search_clear"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/lib_clear_search"
                    android:padding="8dp"
                    android:src="@drawable/ic_lib_close"
                    android:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- Category chips. Moved to its own row below on narrow screens -->
            <HorizontalScrollView
                android:id="@+id/library_chips_scroll"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_lib_field"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/library_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="5dp"
                    android:paddingEnd="1dp" />
            </HorizontalScrollView>

            <!-- Modpack library only: install a .mrpack / CurseForge .zip from the device -->
            <LinearLayout
                android:id="@+id/library_import_button"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_lib_field_pressable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_pe_folder"
                    android:tint="?attr/colorOnSurface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/lib_import_modpack"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/library_sort_button"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_lib_field_pressable"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="10dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lib_sort"
                    android:tint="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/library_sort_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/lib_sort"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/library_sort_chevron"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="10dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_lib_chevron_down"
                    android:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>

        <!-- Holds the chips on narrow screens -->
        <FrameLayout
            android:id="@+id/library_chips_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:visibility="gone" />

        </LinearLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/library_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="invisible"
            app:trackThickness="2dp" />
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/library_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="11dp"
            android:paddingTop="2dp"
            android:paddingEnd="11dp"
            android:paddingBottom="18dp"
            android:scrollbars="none" />

        <LinearLayout
            android:id="@+id/library_state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/library_state_loading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true" />

            <ImageView
                android:id="@+id/library_state_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lib_search"
                android:tint="?attr/colorOnSurfaceVariant" />

            <TextView
                android:id="@+id/library_state_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:maxWidth="320dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/library_state_retry"
                style="@style/Library.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="14dp"
                android:text="@string/lib_retry"
                app:icon="@drawable/ic_lib_update" />
        </LinearLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
