<?xml version="1.0" encoding="utf-8"?>
<!-- Setup page 1: welcome. What the launcher offers, in three short rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/noto_sans_bold"
        android:text="@string/tut_welcome_heading"
        android:textColor="#F2F5FA"
        android:textSize="19sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2sp"
        android:text="@string/tut_welcome_text"
        android:textColor="#C9C9D1"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/tut_card_bg"
        android:orientation="vertical"
        android:padding="4dp">

        <include layout="@layout/tutorial_feature_row"
            android:id="@+id/tut_welcome_row1" />
        <include layout="@layout/tutorial_feature_row"
            android:id="@+id/tut_welcome_row2" />
        <include layout="@layout/tutorial_feature_row"
            android:id="@+id/tut_welcome_row3" />
        <include layout="@layout/tutorial_feature_row"
            android:id="@+id/tut_welcome_row4" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/tut_welcome_note"
        android:textColor="#9C9CA4"
        android:textSize="11.5sp" />
</LinearLayout>
