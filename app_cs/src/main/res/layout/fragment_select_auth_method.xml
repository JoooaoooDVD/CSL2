<?xml version="1.0" encoding="utf-8"?>
<!--
    Add account: artwork banner on top, then one card per sign-in method
    (Microsoft | Ely.by | Local). The row stacks vertically on narrow panes (code).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Artwork banner -->
            <FrameLayout
                android:id="@+id/select_auth_banner"
                android:layout_width="match_parent"
                android:layout_height="118dp"
                android:background="@drawable/bg_banner_card"
                android:clipToOutline="true">

                <ImageView
                    android:id="@+id/select_auth_banner_art"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop"
                    android:src="@drawable/banner_accounts" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/settings_header_scrim" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <ImageView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_settings_icon_box"
                        android:contentDescription="@null"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_nav_profiles" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.3"
                            android:text="@string/auth_select_eyebrow"
                            android:textColor="@color/hm_accent"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/minecraft_ten"
                            android:includeFontPadding="false"
                            android:shadowColor="#66000000"
                            android:shadowDy="3"
                            android:shadowRadius="1"
                            android:singleLine="true"
                            android:text="@string/mcl_title_add_account"
                            android:textColor="#FFFFFFFF"
                            android:textSize="24sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="@string/mcl_button_add_account"
                            android:textColor="#B3FFFFFF"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- One card per sign-in method -->
            <LinearLayout
                android:id="@+id/select_auth_cards_container"
                android:layout_width="match_parent"
                android:layout_height="222dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

            <!-- ═════ microsoft ═════ -->
            <FrameLayout
                android:id="@+id/button_microsoft_authentication"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_cc_option"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/auth_microsoft_art"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:src="@drawable/banner_auth_ms" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:layout_gravity="bottom"
                            android:background="@drawable/bg_cc_art_fade" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:layout_margin="9dp"
                            android:background="@drawable/bg_cc_badge_amber"
                            android:letterSpacing="0.12"
                            android:paddingStart="8dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="3dp"
                            android:singleLine="true"
                            android:text="@string/auth_badge_recommended"
                            android:textColor="@color/hm_text"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:id="@+id/auth_microsoft_tile"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="12dp"
                            android:layout_marginBottom="-10dp"
                            android:background="@drawable/bg_pp_icon_tile"
                            android:elevation="2dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_auth_ms" />
                        </FrameLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:singleLine="true"
                                android:text="@string/auth_select_microsoft"
                                android:textColor="@color/hm_text"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_mm_btn"
                                android:contentDescription="@null"
                                android:padding="6dp"
                                android:rotation="180"
                                android:src="@drawable/ic_ci_back"
                                app:tint="@color/hm_icon" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:ellipsize="end"
                            android:lineSpacingExtra="1dp"
                            android:maxLines="2"
                            android:text="@string/auth_desc_microsoft"
                            android:textColor="@color/hm_text_dim"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_cc_option_overlay"
                    android:duplicateParentState="true" />
            </FrameLayout>

            <!-- ═════ elyby ═════ -->
            <FrameLayout
                android:id="@+id/button_elyby_authentication"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_cc_option"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/auth_elyby_art"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:src="@drawable/banner_auth_elyby" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:layout_gravity="bottom"
                            android:background="@drawable/bg_cc_art_fade" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:layout_margin="9dp"
                            android:background="@drawable/bg_cc_badge_dark"
                            android:letterSpacing="0.12"
                            android:paddingStart="8dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="3dp"
                            android:singleLine="true"
                            android:text="@string/auth_badge_skins"
                            android:textColor="@color/hm_text"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:id="@+id/auth_elyby_tile"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="12dp"
                            android:layout_marginBottom="-10dp"
                            android:background="@drawable/bg_pp_icon_tile"
                            android:elevation="2dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_auth_elyby" />
                        </FrameLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:singleLine="true"
                                android:text="@string/auth_select_elyby"
                                android:textColor="@color/hm_text"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_mm_btn"
                                android:contentDescription="@null"
                                android:padding="6dp"
                                android:rotation="180"
                                android:src="@drawable/ic_ci_back"
                                app:tint="@color/hm_icon" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:ellipsize="end"
                            android:lineSpacingExtra="1dp"
                            android:maxLines="2"
                            android:text="@string/auth_desc_elyby"
                            android:textColor="@color/hm_text_dim"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_cc_option_overlay"
                    android:duplicateParentState="true" />
            </FrameLayout>

            <!-- ═════ local ═════ -->
            <FrameLayout
                android:id="@+id/button_local_authentication"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_cc_option"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/auth_local_art"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:src="@drawable/banner_auth_offline" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:layout_gravity="bottom"
                            android:background="@drawable/bg_cc_art_fade" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|start"
                            android:layout_margin="9dp"
                            android:background="@drawable/bg_cc_badge_dark"
                            android:letterSpacing="0.12"
                            android:paddingStart="8dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="3dp"
                            android:singleLine="true"
                            android:text="@string/auth_badge_offline"
                            android:textColor="@color/hm_text"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <FrameLayout
                            android:id="@+id/auth_local_tile"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="12dp"
                            android:layout_marginBottom="-10dp"
                            android:background="@drawable/bg_pp_icon_tile"
                            android:elevation="2dp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_nav_profiles" />
                        </FrameLayout>
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:includeFontPadding="false"
                                android:singleLine="true"
                                android:text="@string/auth_select_local"
                                android:textColor="@color/hm_text"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_mm_btn"
                                android:contentDescription="@null"
                                android:padding="6dp"
                                android:rotation="180"
                                android:src="@drawable/ic_ci_back"
                                app:tint="@color/hm_icon" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:ellipsize="end"
                            android:lineSpacingExtra="1dp"
                            android:maxLines="2"
                            android:text="@string/auth_desc_local"
                            android:textColor="@color/hm_text_dim"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_cc_option_overlay"
                    android:duplicateParentState="true" />
            </FrameLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/select_auth_footnote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/auth_select_footnote"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11.5sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
