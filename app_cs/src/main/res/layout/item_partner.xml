<?xml version="1.0" encoding="utf-8"?>
<!-- One partner card in the Official Partners list -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pi_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_partner_hero"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp"
    android:stateListAnimator="?attr/csPressAnimator">

    <FrameLayout
        android:id="@+id/pi_logo_wrap"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_partner_logo_tile">

        <ImageView
            android:id="@+id/pi_logo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="1dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            tools:src="@drawable/partner_optl_logo" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pi_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_partner_badge"
                android:letterSpacing="0.08"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:textColor="#D9B356"
                android:textSize="8.5sp"
                android:textStyle="bold"
                tools:text="OFFICIAL PARTNER" />

            <TextView
                android:id="@+id/pi_featured"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:letterSpacing="0.08"
                android:text="@string/partners_featured"
                android:textColor="#9C9CA4"
                android:textSize="8.5sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/pi_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/noto_sans_bold"
            android:textColor="#F2F5FA"
            android:textSize="15sp"
            tools:text="CS Launcher × OPTL" />

        <TextView
            android:id="@+id/pi_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#9C9CA4"
            android:textSize="11sp"
            tools:text="Official Pojav Tierlist" />

        <TextView
            android:id="@+id/pi_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#D8DBE2"
            android:textSize="11.5sp"
            tools:text="CS Launcher is the official launcher of OPTL…" />
    </LinearLayout>

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="8dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_home_chevron_right"
        android:tint="#D9B356" />
</LinearLayout>
