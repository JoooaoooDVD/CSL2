<?xml version="1.0" encoding="utf-8"?>
<!-- Minecraft Appearance picker: Vanilla vs CS Custom Experience with per-part scoping -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/ap_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/hm_scrim"
        android:clickable="true"
        android:focusable="true" />

    <LinearLayout
        android:id="@+id/ap_card"
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_pp_card"
        android:clickable="true"
        android:elevation="16dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/ap_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_pp_icon_tile"
                android:padding="11dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_px_palette"
                    android:tint="@color/hm_text" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.3"
                    android:text="@string/branding_eyebrow"
                    android:textColor="@color/hm_accent"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:includeFontPadding="false"
                    android:text="@string/branding_row_title"
                    android:textColor="@color/hm_text"
                    android:textSize="19sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/ap_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_pp_round_btn"
                android:contentDescription="@android:string/cancel"
                android:padding="11dp"
                android:src="@drawable/ic_pp_close" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/ap_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:fadingEdgeLength="20dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/ap_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/branding_picker_subtitle"
                    android:textColor="@color/hm_text_dim"
                    android:textSize="12.5sp" />

                <LinearLayout
                    android:id="@+id/ap_modes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/ap_mode_vanilla"
                        layout="@layout/item_appearance_mode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/ap_mode_custom"
                        layout="@layout/item_appearance_mode"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ap_scope"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:letterSpacing="0.3"
                                android:text="@string/branding_scope_eyebrow"
                                android:textColor="@color/hm_accent"
                                android:textSize="10.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/noto_sans_bold"
                                android:includeFontPadding="false"
                                android:text="@string/branding_scope_title"
                                android:textColor="@color/hm_text"
                                android:textSize="14.5sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/ap_scope_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_lib_badge_neutral"
                            android:paddingStart="9dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="9dp"
                            android:paddingBottom="3dp"
                            android:textColor="@color/hm_text_dim"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/ap_presets"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>

                    <LinearLayout
                        android:id="@+id/ap_parts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/ap_scope_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/branding_scope_hint"
                        android:textColor="@color/hm_text_dim"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ap_footer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/branding_picker_footer"
                    android:textColor="@color/hm_text_dim"
                    android:textSize="11sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/ap_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ap_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/hm_text_dim"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/ap_cancel"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_sp_btn_ghost"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@android:string/cancel"
                android:textColor="@color/hm_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ap_apply"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_sp_btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="@string/branding_apply"
                android:textColor="@color/hm_dialog"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
