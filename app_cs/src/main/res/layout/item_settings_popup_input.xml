<?xml version="1.0" encoding="utf-8"?>
<!-- Settings popup: text field + helper / error line -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <EditText
        android:id="@+id/sp_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sp_input"
        android:imeOptions="actionDone|flagNoExtractUi|flagNoFullscreen"
        android:importantForAutofill="no"
        android:minHeight="48dp"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:textColor="@color/hm_text"
        android:textColorHint="@color/hm_text_dim"
        android:textSize="14.5sp" />

    <TextView
        android:id="@+id/sp_input_helper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="6dp"
        android:textColor="@color/hm_text_dim"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
