<?xml version="1.0" encoding="utf-8"?>
<!-- One project card of the content library grid -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/bg_lib_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:background="@drawable/bg_lib_icon_box"
            android:padding="5dp">

            <ImageView
                android:id="@+id/card_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/card_compat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/card_compat_icon"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_lib_check_badge" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/card_compat_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:paddingTop="1dp"
                    android:text="@string/lib_compatible"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12.5sp" />

                <TextView
                    android:id="@+id/card_compat_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:maxLines="1"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:fontFamily="@font/noto_sans_bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurface"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/card_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:lineSpacingExtra="2dp"
        android:lines="3"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12.5sp" />

    <LinearLayout
        android:id="@+id/card_tags"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/card_tag_category"
            style="@style/Library.Tag"
            android:maxWidth="112dp" />

        <TextView
            android:id="@+id/card_tag_loader"
            style="@style/Library.Tag"
            android:maxWidth="92dp" />

        <TextView
            android:id="@+id/card_tag_version"
            style="@style/Library.Tag"
            android:maxWidth="80dp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/card_action"
        style="@style/Library.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="12dp"
        android:text="@string/lib_install"
        app:icon="@drawable/ic_lib_download" />
</LinearLayout>
