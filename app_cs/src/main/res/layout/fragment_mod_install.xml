<?xml version="1.0" encoding="utf-8"?>
<!-- Install screen, narrow panes: one scroll with the install controls first -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/install_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:paddingBottom="8dp"
        android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/install_back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_icon_button_home"
                android:contentDescription="@string/preference_back_title"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_lib_back"
                android:tint="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/install_breadcrumb"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/install_source"
                style="@style/Library.Badge"
                android:layout_height="28dp"
                android:background="@drawable/bg_lib_badge_neutral"
                android:drawablePadding="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="normal" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:id="@+id/install_action_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_lib_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Library.SectionLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/lib_install_to" />

                        <TextView
                            android:id="@+id/install_auto_badge"
                            style="@style/Library.Badge"
                            android:layout_height="22dp"
                            android:letterSpacing="0.06"
                            android:text="@string/lib_auto_detected"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/install_profile_icon"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_lib_icon_box"
                            android:importantForAccessibility="no"
                            android:padding="5dp"
                            android:scaleType="fitCenter" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/install_profile_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/install_profile_version"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:maxLines="1"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_lib_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/install_version_label"
                            style="@style/Library.SectionLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/lib_recommended_version" />

                        <TextView
                            android:id="@+id/install_version_badge"
                            style="@style/Library.Badge"
                            android:drawableStart="@drawable/ic_lib_star"
                            android:text="@string/lib_badge_recommended"
                            android:visibility="gone" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/install_version_box"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_lib_inner_box"
                        android:minHeight="74dp"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:id="@+id/install_version_loading"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp">

                            <com.google.android.material.progressindicator.CircularProgressIndicator
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:indeterminate="true"
                                app:indicatorSize="22dp"
                                app:trackThickness="3dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="@string/lib_detecting_version"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/install_version_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/install_version_meta"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:maxLines="2"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12.5sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/install_version_extra"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:maxLines="1"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/install_version_warning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:drawableStart="@drawable/ic_lib_warning_badge"
                        android:drawablePadding="8dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/lib_warning"
                        android:textSize="12.5sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/install_change_version"
                            style="@style/Library.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:enabled="false"
                            android:text="@string/lib_change_version"
                            android:textSize="15sp"
                            app:icon="@drawable/ic_lib_swap"
                            app:iconSize="18dp"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/install_use_recommended"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:layout_marginStart="8dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/lib_use_recommended"
                            android:textAllCaps="false"
                            android:textColor="?attr/colorOnSurface"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>




                <com.google.android.material.button.MaterialButton
                    android:id="@+id/install_uninstall"
                    style="@style/Library.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="10dp"
                    android:text="@string/lib_uninstall"
                    android:textColor="@color/lib_danger"
                    android:visibility="gone"
                    app:icon="@drawable/ic_lib_trash"
                    app:iconTint="@color/lib_danger"
                    app:strokeColor="@color/lib_danger" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:id="@+id/install_info_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_lib_card"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="92dp"
                        android:layout_height="92dp"
                        android:background="@drawable/bg_lib_icon_box"
                        android:padding="7dp">

                        <ImageView
                            android:id="@+id/install_icon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/install_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/noto_sans_bold"
                            android:includeFontPadding="false"
                            android:maxLines="2"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="26sp" />

                        <TextView
                            android:id="@+id/install_author"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:maxLines="1"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:id="@+id/install_tags"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/install_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/install_stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/install_stat_downloads"
                        style="@style/Library.Stat"
                        android:drawableStart="@drawable/ic_lib_download" />

                    <TextView
                        android:id="@+id/install_stat_follows"
                        style="@style/Library.Stat"
                        android:drawableStart="@drawable/ic_lib_heart" />

                    <TextView
                        android:id="@+id/install_stat_updated"
                        style="@style/Library.Stat"
                        android:drawableStart="@drawable/ic_lib_clock" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/install_gallery_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Library.SectionLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/lib_gallery" />

                        <TextView
                            android:id="@+id/install_gallery_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/install_gallery"
                        android:layout_width="match_parent"
                        android:layout_height="128dp"
                        android:layout_marginTop="10dp"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:scrollbars="none" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="16dp"
                    android:background="?attr/colorOutlineVariant" />

                <TextView
                    style="@style/Library.SectionLabel"
                    android:text="@string/lib_dependencies" />

                <LinearLayout
                    android:id="@+id/install_deps_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/install_deps_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/lib_dep_resolving"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_lib_card"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="12dp">
    <com.google.android.material.button.MaterialButton
    android:id="@+id/install_primary"
    style="@style/Widget.Material3.Button"
    android:layout_width="match_parent"
    android:layout_height="58dp"
    android:enabled="false"
    android:insetTop="0dp"
    android:insetBottom="0dp"
    android:letterSpacing="0.04"
    android:text="@string/lib_install"
    android:textAllCaps="false"
    android:textSize="17sp"
    android:textStyle="bold"
    app:backgroundTint="@color/lib_update_bg"
    app:cornerRadius="16dp"
    app:icon="@drawable/ic_lib_download"
    app:iconGravity="textStart"
    app:iconPadding="10dp"
    app:iconSize="22dp"
    app:iconTint="@color/lib_update_text"
    android:textColor="@color/lib_update_text" />
    <com.google.android.material.progressindicator.LinearProgressIndicator
    android:id="@+id/install_progress"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:indeterminate="true"
    android:visibility="gone"
    app:trackCornerRadius="2dp" />
    <TextView
    android:id="@+id/install_status"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:gravity="center"
    android:textColor="?attr/colorOnSurfaceVariant"
    android:textSize="12.5sp"
    android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
