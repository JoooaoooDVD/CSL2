<?xml version="1.0" encoding="utf-8"?>
<!-- Privacy policy & terms. Used as the first-launch welcome overlay and from the About page -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/policy_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9060810"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/policy_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_margin="12dp"
        android:background="@drawable/bg_policy_sheet"
        android:elevation="18dp"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:id="@+id/policy_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/policy_logo"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_cs_full" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/policy_eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.3"
                    android:text="@string/policy_eyebrow"
                    android:textColor="#8F99A8"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/policy_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/minecraft_ten"
                    android:includeFontPadding="false"
                    android:text="@string/policy_title_welcome"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp" />

                <TextView
                    android:id="@+id/policy_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/policy_subtitle"
                    android:textColor="#B5BDCA"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/policy_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_pp_round_btn"
                android:contentDescription="@android:string/cancel"
                android:padding="11dp"
                android:src="@drawable/ic_pp_close"
                android:visibility="gone" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:background="#1F2530" />

        <!-- Sections -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/policy_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fadingEdgeLength="24dp"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- AI artwork disclosure -->
                <LinearLayout
                    android:id="@+id/policy_ai_notice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_policy_ai"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <FrameLayout
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_policy_ai_icon"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_policy_sparkle"
                            android:tint="#C9B8FF" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/noto_sans_bold"
                            android:includeFontPadding="false"
                            android:text="@string/policy_ai_title"
                            android:textColor="#F2F4F7"
                            android:textSize="14.5sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/policy_ai_body"
                            android:textColor="#C4BBDD"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/policy_sections"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="18dp"
            android:background="#1F2530" />

        <!-- Footer: consent row + agree button -->
        <LinearLayout
            android:id="@+id/policy_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:id="@+id/policy_agree_row"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:orientation="horizontal"
                android:paddingStart="6dp"
                android:paddingEnd="6dp">

                <FrameLayout
                    android:id="@+id/policy_check"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_policy_check">

                    <ImageView
                        android:id="@+id/policy_check_mark"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:padding="4dp"
                        android:src="@drawable/ic_pe_check"
                        android:tint="#15181D"
                        android:visibility="invisible" />
                </FrameLayout>

                <TextView
                    android:id="@+id/policy_footnote"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/policy_footnote"
                    android:textColor="#B5BDCA"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/policy_accept"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_policy_accept"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:id="@+id/policy_accept_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_pe_check"
                    android:tint="#15181D" />

                <TextView
                    android:id="@+id/policy_accept_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:includeFontPadding="false"
                    android:text="@string/policy_accept"
                    android:textColor="#15181D"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
