<?xml version="1.0" encoding="utf-8"?>
<!--
    Slider row (CustomSeekBarPreference): title + value pill on the first line, summary,
    then a full-width slider. IDs: androidx preference contract + seekbar / seekbar_value.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="2dp"
    android:layout_marginRight="2dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_sr_card"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingTop="11dp"
    android:paddingRight="12dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@android:id/icon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_sr_icon"
            android:contentDescription="@null"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:tint="@color/pe_icon"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="13dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@android:id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/noto_sans_bold"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/pe_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@android:id/summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="@color/pe_text_secondary"
                android:textSize="11.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/seekbar_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:background="@drawable/bg_sr_value"
            android:fontFamily="@font/jetbrains_mono"
            android:minWidth="52dp"
            android:gravity="center"
            android:paddingLeft="9dp"
            android:paddingTop="4dp"
            android:paddingRight="9dp"
            android:paddingBottom="4dp"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <SeekBar
        android:id="@+id/seekbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@null"
        android:clickable="true"
        android:focusable="true"
        android:maxHeight="6dp"
        android:minHeight="6dp"
        android:paddingLeft="4dp"
        android:paddingTop="10dp"
        android:paddingRight="4dp"
        android:paddingBottom="10dp"
        android:progressDrawable="@drawable/sr_seek_track"
        android:splitTrack="false"
        android:thumb="@drawable/sr_seek_thumb"
        android:thumbOffset="0dp" />
</LinearLayout>
