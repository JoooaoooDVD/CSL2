<?xml version="1.0" encoding="utf-8"?>
<!--
    Slider row (CustomSeekBarPreference): title + value pill on the first line, summary,
    then a full-width slider. Grouped into cards by SettingsPageAdapter like item_setting_row.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sr_row_single"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingTop="12dp"
        android:paddingRight="14dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@android:id/icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_sr_icon"
                android:contentDescription="@null"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:tint="@color/pe_icon"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="13dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@android:id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/noto_sans_bold"
                    android:includeFontPadding="false"
                    android:maxLines="2"
                    android:textColor="@color/pe_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@android:id/summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:maxLines="3"
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="11.5sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/seekbar_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:background="@drawable/bg_sr_value"
                android:fontFamily="@font/jetbrains_mono"
                android:gravity="center"
                android:includeFontPadding="false"
                android:minWidth="56dp"
                android:paddingLeft="10dp"
                android:paddingTop="6dp"
                android:paddingRight="10dp"
                android:paddingBottom="6dp"
                android:textColor="@color/pe_btn_primary_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="53dp"
            android:layout_marginTop="4dp"
            android:background="@null"
            android:clickable="true"
            android:focusable="true"
            android:maxHeight="8dp"
            android:minHeight="8dp"
            android:paddingLeft="6dp"
            android:paddingTop="12dp"
            android:paddingRight="6dp"
            android:paddingBottom="12dp"
            android:progressDrawable="@drawable/sr_seek_track"
            android:splitTrack="false"
            android:thumb="@drawable/sr_seek_thumb"
            android:thumbOffset="0dp" />
    </LinearLayout>

    <View
        android:id="@+id/sr_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="67dp"
        android:layout_marginRight="12dp"
        android:background="@color/pe_card_stroke"
        android:visibility="gone" />
</LinearLayout>
