<?xml version="1.0" encoding="utf-8"?>
<!-- One-time "join our Discord" invite shown after the first-launch setup -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/di_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/hm_scrim"
        android:clickable="true"
        android:focusable="true" />

    <LinearLayout
        android:id="@+id/di_card"
        android:layout_width="400dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_pp_card"
        android:clickable="true"
        android:elevation="16dp"
        android:orientation="vertical">

        <!-- Hero -->
        <FrameLayout
            android:id="@+id/di_hero"
            android:layout_width="match_parent"
            android:layout_height="132dp"
            android:background="@drawable/bg_di_hero">

            <ImageView
                android:id="@+id/di_logo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_discord_mark"
                android:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/di_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:background="@drawable/bg_pp_round_btn"
                android:contentDescription="@android:string/cancel"
                android:padding="10dp"
                android:src="@drawable/ic_pp_close" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/di_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="18dp"
            android:paddingEnd="22dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.3"
                android:text="@string/di_eyebrow"
                android:textColor="@color/hm_accent"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/noto_sans_bold"
                android:includeFontPadding="false"
                android:text="@string/di_title"
                android:textColor="@color/hm_text"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/di_body"
                android:textColor="@color/hm_text_dim"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/di_perks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    style="@style/Library.Badge"
                    android:background="@drawable/bg_lib_badge_neutral"
                    android:text="@string/di_perk_support"
                    android:textColor="@color/hm_text_dim"
                    android:textStyle="normal" />

                <TextView
                    style="@style/Library.Badge"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_lib_badge_neutral"
                    android:text="@string/di_perk_updates"
                    android:textColor="@color/hm_text_dim"
                    android:textStyle="normal" />

                <TextView
                    style="@style/Library.Badge"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_lib_badge_neutral"
                    android:text="@string/di_perk_packs"
                    android:textColor="@color/hm_text_dim"
                    android:textStyle="normal" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/di_join"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_di_join"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_discord_mark"
                    android:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/di_join"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/di_later"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/di_later"
                android:textColor="@color/hm_text_dim"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
