<?xml version="1.0" encoding="utf-8"?>
<!-- Offline (local) account: pick a name, see the rules tick off live, play -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Banner -->
        <FrameLayout
            android:id="@+id/local_login_banner"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:background="@drawable/bg_banner_card"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/local_login_banner_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/banner_accounts" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/settings_header_scrim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageButton
                    android:id="@+id/local_login_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_settings_icon_box"
                    android:contentDescription="@string/pe_back"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pe_back"
                    android:tint="#FFFFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.3"
                        android:text="@string/ll_eyebrow"
                        android:textColor="#B3FFFFFF"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/minecraft_ten"
                        android:includeFontPadding="false"
                        android:shadowColor="#66000000"
                        android:shadowDy="3"
                        android:shadowRadius="1"
                        android:singleLine="true"
                        android:text="@string/auth_select_local"
                        android:textColor="#FFFFFFFF"
                        android:textSize="22sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Two columns on wide screens: form | rules. Stacks on phones (code) -->
        <LinearLayout
            android:id="@+id/ll_columns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Form card -->
            <LinearLayout
                android:id="@+id/login_menu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:background="@drawable/bg_pp_card"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="18dp">

                <!-- Avatar + greeting -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/ll_avatar"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_ss_tile_default">

                        <TextView
                            android:id="@+id/ll_avatar_letter"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:fontFamily="@font/minecraft_ten"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="?"
                            android:textColor="#FFFFFF"
                            android:textSize="26sp" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/ll_greeting"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="@font/noto_sans_bold"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/ll_greeting_empty"
                            android:textColor="@color/hm_text"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/ll_intro"
                            android:textColor="@color/hm_text_dim"
                            android:textSize="12.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Name field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:letterSpacing="0.3"
                    android:text="@string/ll_name_label"
                    android:textColor="@color/hm_accent"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/ll_field"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_sl_link"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_pe_person"
                        android:tint="@color/hm_text_dim" />

                    <EditText
                        android:id="@+id/login_edit_email"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/ll_name_hint"
                        android:imeOptions="actionDone|flagNoExtractUi"
                        android:importantForAutofill="no"
                        android:inputType="textVisiblePassword|textNoSuggestions"
                        android:maxLength="16"
                        android:maxLines="1"
                        android:paddingStart="10dp"
                        android:paddingEnd="8dp"
                        android:textColor="@color/hm_text"
                        android:textColorHint="@color/hm_text_dim"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/ll_counter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="0/16"
                        android:textColor="@color/hm_text_dim"
                        android:textSize="11.5sp" />

                    <ImageButton
                        android:id="@+id/ll_random"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_pp_round_btn"
                        android:contentDescription="@string/ll_random"
                        android:padding="9dp"
                        android:src="@drawable/ic_pe_refresh" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ll_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/lib_danger"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- Play button -->
                <LinearLayout
                    android:id="@+id/login_button"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_sl_action_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/ll_play_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ll_play"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_sl_chevron"
                        android:tint="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <!-- Rules card -->
            <LinearLayout
                android:id="@+id/ll_rules_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="2"
                android:background="@drawable/bg_pp_card"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.3"
                    android:text="@string/ll_rules_title"
                    android:textColor="@color/hm_accent"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/ll_rules"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/hm_card_stroke" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ll_note"
                    android:textColor="@color/hm_text_dim"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
