<?xml version="1.0" encoding="utf-8"?>
<!--
    Offline account = "create your player": a live 3D stage on the left (default skin, or the
    premium player's skin + cape once the name matches one), the name form on the right.
    Narrow screens: the stage goes on top (LocalLoginFragment.adaptToWidth).
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/ll_columns"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <!-- Stage -->
        <FrameLayout
            android:id="@+id/ll_preview_wrap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:background="@drawable/bg_ll_stage"
            android:minHeight="220dp">

            <View
                android:id="@+id/ll_floor"
                android:layout_width="200dp"
                android:layout_height="70dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="18dp"
                android:background="@drawable/bg_ll_floor" />

            <com.craftstudio.cslauncher.skins.PlayerPreviewView
                android:id="@+id/ll_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/ll_nametag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_ll_nametag"
                android:fontFamily="@font/minecraft_ten"
                android:includeFontPadding="false"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:text="@string/ll_nametag_default"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/ll_preview_tag"
                style="@style/Library.Badge"
                android:layout_gravity="bottom|start"
                android:layout_margin="12dp"
                android:background="@drawable/bg_lib_badge_neutral"
                android:text="@string/ll_tag_default"
                android:textColor="@color/hm_text_dim"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/ll_drag_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:text="@string/ll_drag_hint"
                android:textColor="#80FFFFFF"
                android:textSize="10.5sp" />
        </FrameLayout>

        <!-- Form -->
        <LinearLayout
            android:id="@+id/login_menu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="5"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/local_login_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/local_login_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_pp_round_btn"
                    android:contentDescription="@string/pe_back"
                    android:padding="11dp"
                    android:src="@drawable/ic_pe_back" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.3"
                        android:text="@string/ll_eyebrow"
                        android:textColor="@color/hm_accent"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/ll_greeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/minecraft_ten"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/ll_title"
                        android:textColor="@color/hm_text"
                        android:textSize="22sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ll_intro"
                android:textColor="@color/hm_text_dim"
                android:textSize="12.5sp" />

            <!-- Name field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.3"
                android:text="@string/ll_name_label"
                android:textColor="@color/hm_accent"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/ll_field"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_sl_link"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="6dp">

                <FrameLayout
                    android:id="@+id/ll_avatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_ss_tile_default">

                    <ImageView
                        android:id="@+id/ll_avatar_face"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:importantForAccessibility="no"
                        android:padding="4dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/ll_avatar_letter"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/minecraft_ten"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="?"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp" />
                </FrameLayout>

                <EditText
                    android:id="@+id/login_edit_email"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/ll_name_hint"
                    android:imeOptions="actionDone|flagNoExtractUi"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textNoSuggestions"
                    android:maxLength="16"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/hm_text"
                    android:textColorHint="@color/hm_text_dim"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/ll_counter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="0/16"
                    android:textColor="@color/hm_text_dim"
                    android:textSize="11.5sp" />

                <ImageButton
                    android:id="@+id/ll_random"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_pp_round_btn"
                    android:contentDescription="@string/ll_random"
                    android:padding="9dp"
                    android:src="@drawable/ic_pe_refresh" />
            </LinearLayout>

            <!-- Rules as chips -->
            <LinearLayout
                android:id="@+id/ll_rules"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/ll_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/lib_danger"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Premium lookup -->
            <LinearLayout
                android:id="@+id/ll_premium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_sl_link"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="9dp"
                android:paddingEnd="8dp"
                android:paddingBottom="9dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/ll_premium_spinner"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:indeterminateTint="@color/hm_accent" />

                <ImageView
                    android:id="@+id/ll_premium_icon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_pp_check"
                    android:tint="#22C55E"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/ll_premium_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/hm_text"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/ll_premium_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:textColor="@color/hm_text_dim"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/ll_premium_use"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Create -->
            <LinearLayout
                android:id="@+id/login_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_sl_action_primary"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ll_play_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ll_play"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="4dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sl_chevron"
                    android:tint="#FFFFFF" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ll_note"
                android:textColor="@color/hm_text_dim"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
