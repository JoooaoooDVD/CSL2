<?xml version="1.0" encoding="utf-8"?>
<!--
    CS Launcher Plus home content (mockup layout): banner, selected profile + EDIT + PLAY,
    then the Browser Resources / Manager cards. The three rows are weight based (with
    minimum heights) so the pane always fits the available height on phones.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ══════════════ BANNER ══════════════ -->
    <FrameLayout
        android:id="@+id/home_banner_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="51"
        android:minHeight="78dp"
        android:background="@drawable/bg_home_banner"
        android:clipToOutline="true">

        <!-- Default banner art, replaced by the profile / launcher background when set -->
        <ImageView
            android:id="@+id/right_pane_wallpaper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/banner_home" />

        <!-- Optional custom video background -->
        <com.kdt.mcgui.CenterCropVideoView
            android:id="@+id/right_pane_wallpaper_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_home_banner_shade" />

        <!-- Selected version + loader: opens the profile list -->
        <LinearLayout
            android:id="@+id/home_banner_version_chip"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_home_chip_dark"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_home_cube_small" />

            <TextView
                android:id="@+id/home_banner_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:ellipsize="end"
                android:maxWidth="200dp"
                android:singleLine="true"
                android:textColor="@color/home_white"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="26.3 • Fabric" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_home_chevron_down_white" />
        </LinearLayout>

        <!-- MINECRAFT wordmark -->
        <LinearLayout
            android:id="@+id/home_banner_wordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|bottom"
            android:layout_marginStart="18dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/home_banner_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/minecraft_ten"
                android:includeFontPadding="false"
                android:shadowColor="#B3000000"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:text="@string/home_banner_title"
                android:textColor="@color/home_white"
                android:textSize="@dimen/hm_title_size" />

            <TextView
                android:id="@+id/home_banner_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.42"
                android:shadowColor="#99000000"
                android:shadowRadius="5"
                android:text="@string/home_banner_subtitle"
                android:textColor="@color/home_white_dim"
                android:textSize="@dimen/hm_subtitle_size" />
        </LinearLayout>

        <!-- FAST | STABLE | CUSTOMIZABLE -->
        <LinearLayout
            android:id="@+id/home_banner_features"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_gravity="end|bottom"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_home_features"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_badge_fast" />

            <TextView
                style="@style/Home.BannerBadge"
                android:text="@string/home_banner_fast" />

            <View style="@style/Home.BannerBadgeDivider" />

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_badge_stable" />

            <TextView
                style="@style/Home.BannerBadge"
                android:text="@string/home_banner_stable" />

            <View style="@style/Home.BannerBadgeDivider" />

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_badge_custom" />

            <TextView
                style="@style/Home.BannerBadge"
                android:text="@string/home_banner_customizable" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_home_banner_border" />
    </FrameLayout>

    <!-- ══════════════ SELECTED PROFILE + EDIT + PLAY ══════════════ -->
    <LinearLayout
        android:id="@+id/home_action_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="9dp"
        android:layout_weight="22"
        android:minHeight="50dp"
        android:orientation="horizontal">

        <!-- Selected profile card -->
        <LinearLayout
            android:id="@+id/home_profile_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="43"
            android:background="@drawable/bg_home_card_navy"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/home_selected_profile"
                android:textColor="@color/hm_text_dim"
                android:textSize="10.5sp" />

            <!--
                mcVersionSpinner enforces a single line + end ellipsis itself; the compound
                start icon is the profile's real icon (InstanceIconProvider).
            -->
            <com.kdt.mcgui.mcVersionSpinner
                android:id="@+id/mc_version_spinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:background="?attr/selectableItemBackground"
                android:drawableEnd="@drawable/ic_home_chevron_down"
                android:drawablePadding="10dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:textColor="@color/hm_text"
                android:textSize="15sp"
                android:textStyle="bold"
                app:drawableStartSize="@dimen/_30sdp"
                app:drawableStartIntegerScaling="true"
                tools:ignore="RtlSymmetry" />
        </LinearLayout>

        <!-- EDIT card -->
        <FrameLayout
            android:id="@+id/home_edit_card"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="9dp"
            android:layout_weight="12"
            android:background="@drawable/bg_home_card_navy"
            android:minWidth="84dp"
            android:padding="7dp">

            <LinearLayout
                android:id="@+id/edit_profile_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_home_edit_inner"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:tooltipText="@string/home_edit">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_home_cube_edit" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:singleLine="true"
                    android:text="@string/home_edit"
                    android:textColor="@color/hm_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <!-- PLAY (becomes the download progress ring while tasks run) -->
        <FrameLayout
            android:id="@+id/home_play_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="9dp"
            android:layout_weight="42">

            <FrameLayout
                android:id="@+id/play_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_home_play"
                android:clickable="true"
                android:focusable="true">

                <!-- Pixel texture, clipped to the rounded face -->
                <FrameLayout
                    android:id="@+id/home_play_face"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_home_play_clip"
                    android:clipToOutline="true">

                    <ImageView
                        android:id="@+id/home_play_texture"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/home_play_texture" />

                    <View
                        android:id="@+id/home_play_glint"
                        android:layout_width="70dp"
                        android:layout_height="match_parent"
                        android:alpha="0"
                        android:background="@drawable/bg_home_play_glint"
                        android:rotation="0" />
                </FrameLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="3dp"
                    android:background="@drawable/bg_home_play_edge"
                    android:duplicateParentState="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/hm_play_padding_start"
                    android:paddingEnd="8dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/home_play_icon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_home_play_dark" />

                    <View
                        android:id="@+id/home_play_divider"
                        android:layout_width="1dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:background="#330E1525" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/home_play_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.06"
                            android:singleLine="true"
                            android:text="@string/home_play"
                            android:textColor="#FF0E1525"
                            android:textSize="@dimen/hm_play_size"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/home_play_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxWidth="170dp"
                            android:singleLine="true"
                            android:textColor="#FF1B2740"
                            android:textSize="11.5sp"
                            android:textStyle="bold"
                            tools:text="26.3 • Fabric" />
                    </LinearLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <!-- Profile list shortcut -->
                    <ImageView
                        android:id="@+id/home_play_more"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/home_selected_profile"
                        android:focusable="true"
                        android:padding="8dp"
                        android:src="@drawable/ic_home_chevron_down_dark" />
                </LinearLayout>
            </FrameLayout>

            <!-- Download arc travelling around the button outline -->
            <com.craftstudio.cslauncher.OutlineArcProgressView
                android:id="@+id/home_play_arc"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="3.5dp"
                android:clickable="false"
                android:focusable="false" />
        </FrameLayout>
    </LinearLayout>

    <!-- ══════════════ BROWSER RESOURCES + MANAGER ══════════════ -->
    <!-- Same card colour for both, each with its own artwork -->
    <LinearLayout
        android:id="@+id/home_cards_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="9dp"
        android:layout_weight="28"
        android:minHeight="58dp"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/home_card_browser"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_home_card_navy"
            android:clickable="true"
            android:focusable="true"
            android:tooltipText="@string/home_nav_browser">

            <!-- Card artwork (right side), faded into the card colour on the left -->
            <ImageView
                android:id="@+id/home_card_browser_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/banner_home_browser" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_home_card_art_fade" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="10dp">

                <FrameLayout
                    android:id="@+id/home_card_browser_tile"
                    android:layout_width="@dimen/hm_tile_size"
                    android:layout_height="@dimen/hm_tile_size"
                    android:background="@drawable/bg_home_tile_blue">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:padding="@dimen/hm_tile_padding"
                        android:src="@drawable/ic_home_cube_glow" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:letterSpacing="0.02"
                        android:shadowColor="@color/hm_text_shadow"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:singleLine="true"
                        android:text="@string/home_card_browser_title"
                        android:textColor="@color/hm_text"
                        android:textSize="@dimen/hm_card_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:shadowColor="@color/hm_text_shadow"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:singleLine="true"
                        android:text="@string/home_card_browser_desc"
                        android:textColor="@color/hm_text_dim"
                        android:textSize="@dimen/hm_card_desc_size" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/home_card_browser_chevron"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_home_card_chevron"
                    android:contentDescription="@null"
                    android:padding="7dp"
                    android:src="@drawable/ic_home_chevron_right" />
            </LinearLayout>

            <!-- Hairline + pressed tint above the artwork -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_home_card_overlay"
                android:duplicateParentState="true" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/home_card_manager"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:background="@drawable/bg_home_card_navy"
            android:clickable="true"
            android:focusable="true"
            android:tooltipText="@string/home_nav_manager">

            <!-- Card artwork (right side), faded into the card colour on the left -->
            <ImageView
                android:id="@+id/home_card_manager_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/banner_home_manager" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_home_card_art_fade" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="10dp">

                <FrameLayout
                    android:id="@+id/home_card_manager_tile"
                    android:layout_width="@dimen/hm_tile_size"
                    android:layout_height="@dimen/hm_tile_size"
                    android:background="@drawable/bg_home_tile_blue">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:padding="@dimen/hm_tile_padding"
                        android:src="@drawable/ic_home_servers"
                        android:tint="@color/hm_cube" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:letterSpacing="0.02"
                        android:shadowColor="@color/hm_text_shadow"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:singleLine="true"
                        android:text="@string/home_card_manager_title"
                        android:textColor="@color/hm_text"
                        android:textSize="@dimen/hm_card_title_size"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:ellipsize="end"
                        android:shadowColor="@color/hm_text_shadow"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:singleLine="true"
                        android:text="@string/home_card_manager_desc"
                        android:textColor="@color/hm_text_dim"
                        android:textSize="@dimen/hm_card_desc_size" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/home_card_manager_chevron"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_home_card_chevron"
                    android:contentDescription="@null"
                    android:padding="7dp"
                    android:src="@drawable/ic_home_chevron_right" />
            </LinearLayout>

            <!-- Hairline + pressed tint above the artwork -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_home_card_overlay"
                android:duplicateParentState="true" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
