<?xml version="1.0" encoding="utf-8"?>
<!-- Row of the create form dropdowns (Minecraft / loader version, Java, renderer) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="42dp"
    android:background="@drawable/bg_ci_dropdown_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="10dp">

    <TextView
        android:id="@+id/ci_row_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/hm_text"
        android:textSize="13.5sp"
        tools:text="1.21.1" />

    <ImageView
        android:id="@+id/ci_row_check"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_pp_check" />
</LinearLayout>
