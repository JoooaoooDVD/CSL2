<?xml version="1.0" encoding="utf-8"?>
<!-- Account picker: opened from the top-bar account pill. Header · account cards · add button -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/ap_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/hm_scrim"
        android:clickable="true"
        android:focusable="true" />

    <LinearLayout
        android:id="@+id/ap_card"
        android:layout_width="520dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_pp_card"
        android:clickable="true"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:id="@+id/ap_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/ap_head_tile"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_pp_icon_tile">

                <ImageView
                    android:id="@+id/ap_head"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_default_head" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.3"
                    android:text="@string/ap_eyebrow"
                    android:textColor="@color/hm_accent"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/ap_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/noto_sans_bold"
                    android:includeFontPadding="false"
                    android:text="@string/ap_title"
                    android:textColor="@color/hm_text"
                    android:textSize="19sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/ap_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_pp_round_btn"
                android:contentDescription="@android:string/cancel"
                android:padding="11dp"
                android:src="@drawable/ic_pp_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/ap_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/ap_subtitle"
            android:textColor="@color/hm_text_dim"
            android:textSize="12.5sp" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/ap_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:fadingEdgeLength="20dp"
            android:requiresFadingEdge="vertical"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/ap_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>

        <!-- Empty state -->
        <LinearLayout
            android:id="@+id/ap_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pp_row"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_px_account_edit"
                android:tint="@color/hm_text_dim" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/ap_empty"
                android:textColor="@color/hm_text_dim"
                android:textSize="12.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ap_add"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/tut_btn_primary"
            android:drawableStart="@drawable/ic_add"
            android:drawablePadding="8dp"
            android:fontFamily="@font/noto_sans_bold"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="22dp"
            android:text="@string/main_add_account"
            android:textColor="@color/hm_text"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
