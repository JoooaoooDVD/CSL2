<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="12dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/tut_row_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/tut_inner_bg"
        android:contentDescription="@null"
        android:padding="8dp"
        android:scaleType="fitCenter"
        tools:src="@drawable/ic_px_home" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tut_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F2F5FA"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Profiles for every setup" />

        <TextView
            android:id="@+id/tut_row_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="#9C9CA4"
            android:textSize="11.5sp"
            tools:text="Versions, mod loaders, memory and renderer per profile." />
    </LinearLayout>
</LinearLayout>
