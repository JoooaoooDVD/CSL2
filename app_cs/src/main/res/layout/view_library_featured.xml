<?xml version="1.0" encoding="utf-8"?>
<!--
    BASE OPTIMISE MOD: pinned card at the top of the Mods tab (Thorium Optimization).
    Reuses the library card language (bg_lib_card, icon box, tags, outlined button) so it
    sits naturally above the grid on phones and tablets.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/featured_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="11dp"
    android:layout_marginTop="6dp"
    android:layout_marginEnd="11dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_lib_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/featured_eyebrow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.12"
            android:text="@string/lib_base_opt_eyebrow"
            android:textColor="?attr/colorPrimary"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/featured_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_lib_card_source_badge"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="@string/lib_source_curseforge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_lib_icon_box">

            <ImageView
                android:id="@+id/featured_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_lib_cube" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/featured_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Thorium Optimization"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/featured_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/lib_base_opt_hint"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12.5sp" />

            <LinearLayout
                android:id="@+id/featured_tags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/featured_tag_loader"
                    style="@style/Library.Tag"
                    android:background="@drawable/bg_lib_tag_blue"
                    android:text="Fabric" />

                <TextView
                    android:id="@+id/featured_tag_version"
                    style="@style/Library.Tag"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/featured_tag_state"
                    style="@style/Library.Tag"
                    android:background="@drawable/bg_lib_tag_green"
                    android:text="@string/lib_base_opt_installed"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/featured_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/featured_action"
        style="@style/Library.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:text="@string/lib_base_opt_install"
        app:icon="@drawable/ic_lib_download" />
</LinearLayout>
