<?xml version="1.0" encoding="utf-8"?>
<!-- Setup page 2: how the tour should run -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.14"
        android:text="@string/tut_opt_section_mode"
        android:textAllCaps="true"
        android:textColor="#9C9CA4"
        android:textSize="10.5sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <include layout="@layout/tutorial_option_card" android:id="@+id/tut_opt_quick" />
        <Space android:layout_width="10dp" android:layout_height="1dp" />
        <include layout="@layout/tutorial_option_card" android:id="@+id/tut_opt_complete" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:letterSpacing="0.14"
        android:text="@string/tut_opt_section_style"
        android:textAllCaps="true"
        android:textColor="#9C9CA4"
        android:textSize="10.5sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <include layout="@layout/tutorial_option_card" android:id="@+id/tut_opt_interactive" />
        <Space android:layout_width="10dp" android:layout_height="1dp" />
        <include layout="@layout/tutorial_option_card" android:id="@+id/tut_opt_guided" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tut_opt_tips_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/tut_inner_bg"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tut_opt_tips_title"
                android:textColor="#F2F5FA"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tut_opt_tips_text"
                android:textColor="#9C9CA4"
                android:textSize="11.5sp" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/tut_opt_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:checked="true" />
    </LinearLayout>
</LinearLayout>
