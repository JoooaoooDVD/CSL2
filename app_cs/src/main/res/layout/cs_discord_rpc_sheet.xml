<?xml version="1.0" encoding="utf-8"?>
<!--
    Discord Rich Presence: content of the settings popup (SettingsPopup.customView).
    Status strip → live preview of the Discord card → optional account link. No options:
    the presence is composed automatically from what is running.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cs_discord_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Delivery status -->
    <LinearLayout
        android:id="@+id/cs_discord_status_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pp_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <View
            android:id="@+id/cs_discord_status_dot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="@drawable/cs_discord_dot_gray" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cs_discord_status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hm_text"
                android:textSize="12.5sp"
                android:textStyle="bold"
                tools:text="Live on Discord" />

            <TextView
                android:id="@+id/cs_discord_status_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/hm_text_dim"
                android:textSize="11sp"
                tools:text="Shown through the Discord app on this phone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Live preview of the activity card -->
    <LinearLayout
        android:id="@+id/cs_discord_preview_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pp_row"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.25"
                android:text="@string/cs_discord_preview_eyebrow"
                android:textColor="@color/hm_accent"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cs_discord_preview_scene"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pp_active_pill"
                android:letterSpacing="0.2"
                android:paddingStart="9dp"
                android:paddingTop="3dp"
                android:paddingEnd="9dp"
                android:paddingBottom="3dp"
                android:textColor="@color/hm_green_text"
                android:textSize="9.5sp"
                android:textStyle="bold"
                tools:text="HOME SCREEN" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp">

                <ImageView
                    android:id="@+id/cs_discord_preview_large"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_pp_icon_tile"
                    android:contentDescription="@null"
                    android:scaleType="centerCrop" />

                <FrameLayout
                    android:id="@+id/cs_discord_preview_small_wrap"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/cs_discord_badge_ring">

                    <ImageView
                        android:id="@+id/cs_discord_preview_small"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:scaleType="fitCenter" />
                </FrameLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cs_discord_preview_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/cs_discord_preview_app_name"
                    android:textColor="@color/hm_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cs_discord_preview_details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/hm_text"
                    android:textSize="12.5sp"
                    tools:text="Playing Skyblock Adventures" />

                <TextView
                    android:id="@+id/cs_discord_preview_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/hm_text_dim"
                    android:textSize="12.5sp"
                    tools:text="Minecraft 1.21.4 · Fabric · 42 mods" />

                <TextView
                    android:id="@+id/cs_discord_preview_elapsed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/hm_text_dim"
                    android:textSize="12sp"
                    tools:text="00:12:34 elapsed" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cs_discord_preview_btn1"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_sp_btn_ghost"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/cs_discord_button_discord"
                android:textColor="@color/hm_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cs_discord_preview_btn2"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_sp_btn_ghost"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/cs_discord_button_youtube"
                android:textColor="@color/hm_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Optional account link -->
    <LinearLayout
        android:id="@+id/cs_discord_account_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pp_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/cs_discord_account_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/cs_discord_avatar_bg"
            android:contentDescription="@null"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_discord_mark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cs_discord_account_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hm_text"
                android:textSize="13.5sp"
                android:textStyle="bold"
                tools:text="Discord account" />

            <TextView
                android:id="@+id/cs_discord_account_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/hm_text_dim"
                android:textSize="11.5sp"
                tools:text="Not linked · optional" />
        </LinearLayout>

        <TextView
            android:id="@+id/cs_discord_account_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_pp_active_pill"
            android:letterSpacing="0.2"
            android:paddingStart="9dp"
            android:paddingTop="3dp"
            android:paddingEnd="9dp"
            android:paddingBottom="3dp"
            android:text="@string/cs_discord_account_linked_pill"
            android:textColor="@color/hm_green_text"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/cs_discord_footnote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:text="@string/cs_discord_footnote"
        android:textColor="@color/hm_text_dim"
        android:textSize="11.5sp" />
</LinearLayout>
