<?xml version="1.0" encoding="utf-8"?>
<!-- Registry card: icon tile · name + kind pill · summary · author · action -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/bg_mm_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:id="@+id/cem_icon_tile"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/bg_mm_icon_tile">

        <ImageView
            android:id="@+id/cem_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="3dp"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cem_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hm_text"
                android:textSize="14.5sp"
                android:textStyle="bold"
                tools:text="AppleSkin" />

            <TextView
                android:id="@+id/cem_kind"
                android:layout_width="wrap_content"
                android:layout_height="19dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_mm_state_off"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/hm_text_dim"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="Built-in" />
        </LinearLayout>

        <TextView
            android:id="@+id/cem_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/hm_text_dim"
            android:textSize="11.5sp"
            tools:text="Shows food and saturation values." />

        <TextView
            android:id="@+id/cem_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/hm_text_dim"
            android:textSize="10.5sp"
            tools:text="by squeek502  ·  v1.2.0" />
    </LinearLayout>

    <TextView
        android:id="@+id/cem_action"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:background="@drawable/bg_cs_pill_dark"
        android:gravity="center"
        android:minWidth="84dp"
        android:paddingHorizontal="14dp"
        android:stateListAnimator="?attr/csPressAnimator"
        android:textColor="@color/hm_text"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="Install" />
</LinearLayout>
