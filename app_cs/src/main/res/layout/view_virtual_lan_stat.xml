<?xml version="1.0" encoding="utf-8"?>
<!-- Small label/value tile used in the Virtual LAN cards -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_vl_tile"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="7dp"
    android:paddingEnd="10dp"
    android:paddingBottom="7dp">

    <TextView
        android:id="@+id/vl_stat_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.2"
        android:singleLine="true"
        android:textAllCaps="true"
        android:textColor="@color/vl_text_faint"
        android:textSize="9.5sp"
        android:textStyle="bold"
        tools:text="Latency" />

    <TextView
        android:id="@+id/vl_stat_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:singleLine="true"
        android:textColor="@color/vl_text"
        android:textSize="13.5sp"
        tools:text="42 ms" />
</LinearLayout>
