<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings → Cursor: the player's own pointer for the game. A dark preview stage (tap it to
    place the click point), pick/reset buttons, the size slider shared with the Controls page,
    click-point presets and the supported formats.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <!-- LEFT: preview + actions -->
        <LinearLayout
            android:id="@+id/cur_left"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="11"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/cur_stage"
                android:layout_width="match_parent"
                android:layout_height="212dp"
                android:background="@drawable/bg_cursor_stage"
                android:clickable="true"
                android:contentDescription="@string/cursor_stage_hint"
                android:focusable="true">

                <ImageView
                    android:id="@+id/cur_preview"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:scaleType="fitCenter" />

                <View
                    android:id="@+id/cur_hot_marker"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/bg_cursor_hot_marker" />

                <TextView
                    android:id="@+id/cur_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_margin="12dp"
                    android:background="@drawable/bg_vl_pill"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="@string/cursor_badge_default"
                    android:textColor="@color/vl_text"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="10dp"
                    android:text="@string/cursor_stage_hint"
                    android:textColor="#B8C0CF"
                    android:textSize="11.5sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/cur_pick"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_pe_btn_primary"
                    android:drawablePadding="8dp"
                    android:gravity="center"
                    android:text="@string/cursor_pick"
                    android:textColor="@color/pe_btn_primary_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cur_reset"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_pe_btn_ghost"
                    android:gravity="center"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/cursor_reset"
                    android:textColor="@color/pe_btn_dark_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/cur_file_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/pe_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- RIGHT: size, click point, formats -->
        <LinearLayout
            android:id="@+id/cur_right"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="10"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/cur_card_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_st_card"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/cursor_size"
                        android:textColor="@color/pe_text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/cur_size_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textColor="@color/pe_text_primary"
                        android:textSize="13sp" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/cur_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:max="275"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cursor_size_note"
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cur_card_hot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_st_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cursor_hot_title"
                    android:textColor="@color/pe_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cur_hot_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/cur_hot_tl"
                        style="@style/CsPeChip"
                        android:text="@string/cursor_hot_top_left" />

                    <TextView
                        android:id="@+id/cur_hot_top"
                        style="@style/CsPeChip"
                        android:layout_marginStart="8dp"
                        android:text="@string/cursor_hot_top" />

                    <TextView
                        android:id="@+id/cur_hot_center"
                        style="@style/CsPeChip"
                        android:layout_marginStart="8dp"
                        android:text="@string/cursor_hot_center" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cur_card_formats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_st_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cursor_formats_title"
                    android:textColor="@color/pe_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/cursor_formats_body"
                    android:textColor="@color/pe_text_secondary"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
