<?xml version="1.0" encoding="utf-8"?>
<!-- Launch status pill: a small floating card at the bottom while the game window starts.
     No scrim, nothing is covered: the controls stay visible and editable underneath.
     Hidden by GameActivity.hideLoadingScreen() when the game surface appears. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/ls_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_ls_pill"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="7dp"
        android:paddingEnd="18dp"
        android:paddingBottom="7dp">

        <FrameLayout
            android:id="@+id/ls_logo_tile"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_ls_logo_tile"
            android:padding="6dp">

            <ImageView
                android:id="@+id/ls_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_cs_full" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/main_loading_screen_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/noto_sans_bold"
                android:includeFontPadding="false"
                android:maxWidth="260dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/loading_screen_title"
                android:textColor="#F2F5FA"
                android:textSize="12.5sp" />

            <FrameLayout
                android:id="@+id/ls_track"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_ls_track">

                <View
                    android:id="@+id/ls_bar"
                    android:layout_width="56dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_ls_bar" />
            </FrameLayout>

            <TextView
                android:id="@+id/main_loading_screen_warning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxWidth="260dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/loading_screen_warning"
                android:textColor="#7C7C85"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</merge>
