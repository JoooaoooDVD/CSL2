<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher-side pre-game screen (shown until the game window appears). Opaque so the controls
     underneath do not bleed through; hidden by GameActivity.hideLoadingScreen(). -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp">

        <FrameLayout
            android:layout_width="150dp"
            android:layout_height="150dp">

            <View
                android:id="@+id/ls_logo_glow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_ls_logo_glow" />

            <FrameLayout
                android:id="@+id/ls_logo_tile"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_ls_logo_tile"
                android:elevation="8dp"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/ls_logo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_cs_full" />
            </FrameLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/ls_eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:letterSpacing="0.34"
            android:text="@string/launch_screen_eyebrow"
            android:textColor="#C6C6CE"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ls_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/minecraft_ten"
            android:includeFontPadding="false"
            android:letterSpacing="0.06"
            android:text="@string/launch_screen_title"
            android:textColor="#F2F5FA"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/main_loading_screen_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/loading_screen_title"
            android:textColor="#9C9CA4"
            android:textSize="13sp" />

        <FrameLayout
            android:id="@+id/ls_track"
            android:layout_width="220dp"
            android:layout_height="3dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_ls_track">

            <View
                android:id="@+id/ls_bar"
                android:layout_width="84dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_ls_bar" />
        </FrameLayout>

        <TextView
            android:id="@+id/main_loading_screen_warning"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:alpha="0.75"
            android:gravity="center"
            android:text="@string/loading_screen_warning"
            android:textColor="#6E6E76"
            android:textSize="11.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ls_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="18dp"
        android:letterSpacing="0.2"
        android:text="@string/launch_screen_footer"
        android:textColor="#4A4A52"
        android:textSize="10sp" />
</merge>
