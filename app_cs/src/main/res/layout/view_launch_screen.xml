<?xml version="1.0" encoding="utf-8"?>
<!-- Launch status pill: a small floating card at the bottom while the game window starts.
     No scrim, nothing is covered: the controls stay visible and editable underneath.
     Hidden by GameActivity.hideLoadingScreen() when the game surface appears. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The PLAY rocket, idling above the pill; flies up and bursts when the game appears -->
    <com.craftstudio.cslauncher.game.LaunchRocketView
        android:id="@+id/ls_rocket"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- Advertisement card: right side, vertically centred, only while the game window starts.
         Kept GONE until the banner has rendered; removed together with the whole launch layer. -->
    <LinearLayout
        android:id="@+id/ls_ad_card"
        android:layout_width="368dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="22dp"
        android:background="@drawable/bg_ls_ad_card"
        android:elevation="10dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/ls_ad_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ls_ad_tag"
                android:fontFamily="@font/noto_sans_bold"
                android:includeFontPadding="false"
                android:letterSpacing="0.14"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingEnd="7dp"
                android:paddingBottom="3dp"
                android:text="@string/ls_ad_tag"
                android:textColor="#C9C9D1"
                android:textSize="9.5sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/noto_sans_bold"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="@string/ls_ad_sub"
                android:textColor="#7C7C85"
                android:textSize="10.5sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_ls_ad_slot"
            android:padding="6dp">

            <com.craftstudio.cslauncher.ads.AdsterraBannerView
                android:id="@+id/ls_ad_banner"
                android:layout_width="match_parent"
                android:layout_height="51dp" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ls_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_ls_pill"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="7dp"
        android:paddingEnd="18dp"
        android:paddingBottom="7dp">

        <FrameLayout
            android:id="@+id/ls_logo_tile"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_ls_logo_tile"
            android:padding="6dp">

            <ImageView
                android:id="@+id/ls_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_cs_full" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="11dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/main_loading_screen_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/noto_sans_bold"
                android:includeFontPadding="false"
                android:maxWidth="260dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/loading_screen_title"
                android:textColor="#F2F5FA"
                android:textSize="12.5sp" />

            <FrameLayout
                android:id="@+id/ls_track"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_ls_track">

                <View
                    android:id="@+id/ls_bar"
                    android:layout_width="56dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_ls_bar" />
            </FrameLayout>

            <TextView
                android:id="@+id/main_loading_screen_warning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:maxWidth="260dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/loading_screen_warning"
                android:textColor="#7C7C85"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</merge>
