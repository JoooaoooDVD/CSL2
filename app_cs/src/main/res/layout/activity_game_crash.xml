<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hm_backdrop_bottom"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <!-- LEFT: what happened + what to do -->
    <ScrollView
        android:id="@+id/gc_left"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.46"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingEnd="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_gc_diagnosis"
                    android:contentDescription="@null"
                    android:padding="9dp"
                    android:src="@drawable/ic_gc_bug" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/gc_eyebrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.16"
                        android:text="@string/gc_eyebrow"
                        android:textColor="#FFFF6B6B"
                        android:textSize="10.5sp" />

                    <TextView
                        android:id="@+id/gc_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/gc_title_crash"
                        android:textColor="@color/hm_text"
                        android:textSize="21sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/gc_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/hm_text_dim"
                android:textSize="12.5sp"
                tools:text="Exit code 1 · Survival · 1.21.4 · Fabric" />

            <!-- Diagnosis -->
            <LinearLayout
                android:id="@+id/gc_dx_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_pp_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.14"
                    android:text="@string/gc_dx_eyebrow"
                    android:textColor="@color/hm_accent"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/gc_dx_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/hm_text"
                    android:textSize="15.5sp"
                    tools:text="Out of memory" />

                <TextView
                    android:id="@+id/gc_dx_advice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/hm_text_dim"
                    android:textSize="12.5sp"
                    tools:text="Lower the render distance or give the game more memory in Settings." />

                <TextView
                    android:id="@+id/gc_dx_evidence"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_gc_log"
                    android:fontFamily="monospace"
                    android:maxLines="4"
                    android:ellipsize="end"
                    android:padding="10dp"
                    android:textColor="#FFFFB4B4"
                    android:textSize="10.5sp"
                    tools:text="java.lang.OutOfMemoryError: Java heap space" />
            </LinearLayout>

            <!-- Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

            <TextView
                android:id="@+id/gc_share"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                
                android:background="@drawable/bg_gc_btn_primary"
                android:clickable="true"
                android:drawableStart="@drawable/ic_gm_share"
                android:drawablePadding="8dp"
                android:drawableTint="@color/hm_backdrop_bottom"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/gc_share_logs"
                android:textColor="@color/hm_backdrop_bottom"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/gc_copy"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_gc_btn_ghost"
                android:clickable="true"
                android:drawableStart="@drawable/ic_cc_copy"
                android:drawablePadding="8dp"
                android:drawableTint="@color/hm_text"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/gc_copy_log"
                android:textColor="@color/hm_text"
                android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

            <TextView
                android:id="@+id/gc_play"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                
                android:background="@drawable/bg_gc_btn_ghost"
                android:clickable="true"
                android:drawableStart="@drawable/ic_home_rocket"
                android:drawablePadding="8dp"
                android:drawableTint="@color/hm_text"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/gc_play_again"
                android:textColor="@color/hm_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/gc_launcher"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_gc_btn_ghost"
                android:clickable="true"
                android:drawableStart="@drawable/ic_pe_back"
                android:drawablePadding="8dp"
                android:drawableTint="@color/hm_text"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/gc_back_launcher"
                android:textColor="@color/hm_text"
                android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/gc_crash_report"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_gc_btn_ghost"
                android:clickable="true"
                android:drawableStart="@drawable/ic_pe_terminal"
                android:drawablePadding="10dp"
                android:drawableTint="@color/hm_text"
                android:focusable="true"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:textColor="@color/hm_text"
                android:textSize="12.5sp"
                android:visibility="gone"
                tools:text="Share crash report · crash-2026-10-21_12.00.00-client.txt"
                tools:visibility="visible" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/gc_footer"
                android:textColor="@color/hm_text_dim"
                android:textSize="11.5sp" />
        </LinearLayout>
    </ScrollView>

    <!-- RIGHT: the log -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.54"
        android:background="@drawable/bg_pp_card"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.14"
                    android:text="@string/gc_log_eyebrow"
                    android:textColor="@color/hm_accent"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/gc_log_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hm_text_dim"
                    android:textSize="11.5sp"
                    tools:text="latestlog.txt · 2 431 lines · showing last 400" />
            </LinearLayout>

            <TextView
                android:id="@+id/gc_chip_errors"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_gc_chip"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/gc_errors_only"
                android:textColor="@color/hm_text"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/gc_chip_bottom"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_gc_chip"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/gc_jump_end"
                android:textColor="@color/hm_text"
                android:textSize="11.5sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/gc_log_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_gc_log"
            android:fadeScrollbars="false"
            android:scrollbarThumbVertical="@color/hm_inner_stroke">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/gc_log"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:padding="10dp"
                    android:textColor="#FFD5D8DF"
                    android:textIsSelectable="true"
                    android:textSize="10.5sp"
                    tools:text="[12:00:01] [main/INFO]: Loading Minecraft 1.21.4" />
            </HorizontalScrollView>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
