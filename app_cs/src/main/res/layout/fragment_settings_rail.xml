<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings category tabs, shown on the right of the category header banner (they replaced
    the old left icon rail so the settings screens get the full width): a hub button, a
    divider and one icon tab per category. The active tab is highlighted by SettingsRailFragment.
-->
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/settings_rail_items"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/rail_home"
            android:layout_width="@dimen/st_tab_size"
            android:layout_height="@dimen/st_tab_size"
            android:layout_marginLeft="0dp"
            android:background="@drawable/bg_st_tab"
            android:clickable="true"
            android:contentDescription="@string/settings_hub_title"
            android:focusable="true"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_px_home"
            android:tint="#FFFFFFFF"
            android:tooltipText="@string/settings_hub_title" />

        <View
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:background="#40FFFFFF" />

        <ImageView
            android:id="@+id/rail_video"
            android:layout_width="@dimen/st_tab_size"
            android:layout_height="@dimen/st_tab_size"
            android:layout_marginLeft="0dp"
            android:background="@drawable/bg_st_tab"
            android:clickable="true"
            android:contentDescription="@string/preference_video_title"
            android:focusable="true"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_qs_monitor"
            android:tint="#FFFFFFFF"
            android:tooltipText="@string/preference_video_title" />

        <ImageView
            android:id="@+id/rail_appearance"
            android:layout_width="@dimen/st_tab_size"
            android:layout_height="@dimen/st_tab_size"
            android:layout_marginLeft="6dp"
            android:background="@drawable/bg_st_tab"
            android:clickable="true"
            android:contentDescription="@string/preference_appearance_title"
            android:focusable="true"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_px_image"
            android:tint="#FFFFFFFF"
            android:tooltipText="@string/preference_appearance_title" />

        <ImageView
            android:id="@+id/rail_control"
            android:layout_width="@dimen/st_tab_size"
            android:layout_height="@dimen/st_tab_size"
            android:layout_marginLeft="6dp"
            android:background="@drawable/bg_st_tab"
            android:clickable="true"
            android:contentDescription="@string/preference_control_title"
            android:focusable="true"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_px_gamepad"
            android:tint="#FFFFFFFF"
            android:tooltipText="@string/preference_control_title" />

        <ImageView
            android:id="@+id/rail_java"
            android:layout_width="@dimen/st_tab_size"
            android:layout_height="@dimen/st_tab_size"
            android:layout_marginLeft="6dp"
            android:background="@drawable/bg_st_tab"
            android:clickable="true"
            android:contentDescription="@string/preference_java_title"
            android:focusable="true"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_px_java"
            android:tint="#FFFFFFFF"
            android:tooltipText="@string/preference_java_title" />

        <ImageView
            android:id="@+id/rail_misc"
            android:layout_width="@dimen/st_tab_size"
            android:layout_height="@dimen/st_tab_size"
            android:layout_marginLeft="6dp"
            android:background="@drawable/bg_st_tab"
            android:clickable="true"
            android:contentDescription="@string/preference_misc_title"
            android:focusable="true"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_px_alt_sliders"
            android:tint="#FFFFFFFF"
            android:tooltipText="@string/preference_misc_title" />

        <ImageView
            android:id="@+id/rail_experimental"
            android:layout_width="@dimen/st_tab_size"
            android:layout_height="@dimen/st_tab_size"
            android:layout_marginLeft="6dp"
            android:background="@drawable/bg_st_tab"
            android:clickable="true"
            android:contentDescription="@string/preference_experimental_title"
            android:focusable="true"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_px_experiment"
            android:tint="#FFFFFFFF"
            android:tooltipText="@string/preference_experimental_title" />
    </LinearLayout>
</HorizontalScrollView>
