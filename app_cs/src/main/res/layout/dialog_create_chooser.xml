<?xml version="1.0" encoding="utf-8"?>
<!--
    GENERATED by tools/gen_cc_layout.py
    "Create" chooser popup (opened from Create New Instance of the profile picker):
    Normal (Vanilla / Fabric / Forge ...) | CS Client (coming soon) | Modpack.
    Card width and option height are adjusted in code to the screen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/cc_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/hm_scrim"
        android:clickable="true"
        android:contentDescription="@string/pp_close"
        android:focusable="true" />

    <LinearLayout
        android:id="@+id/cc_card"
        android:layout_width="620dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_pp_card"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="false"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:id="@+id/cc_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.3"
                    android:text="@string/cc_label"
                    android:textColor="@color/hm_accent"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/cc_title"
                    android:textColor="@color/hm_text"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/cc_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_pp_round_btn"
                android:contentDescription="@string/pp_close"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pp_close" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cc_options"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

        <!-- ═════ normal ═════ -->
        <FrameLayout
            android:id="@+id/cc_opt_normal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_cc_option"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/cc_normal_art"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/banner_create_normal" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_cc_art_fade" />

                    <TextView
                        android:id="@+id/cc_normal_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="9dp"
                        android:background="@drawable/bg_cc_badge_dark"
                        android:letterSpacing="0.12"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:singleLine="true"
                        android:text="@string/cc_normal_badge"
                        android:textColor="@color/hm_text"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="11dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/cc_normal_tile"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_pp_icon_tile">
                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_gravity="top|start"
                        android:layout_margin="3dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_fabric" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="3dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_forge" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="@string/cc_normal_title"
                                android:textColor="@color/hm_text"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:lineSpacingExtra="1dp"
                        android:maxLines="2"
                        android:text="@string/cc_normal_desc"
                        android:textColor="@color/hm_text_dim"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_cc_option_overlay"
                android:duplicateParentState="true" />
        </FrameLayout>


        <!-- ═════ cs ═════ -->
        <FrameLayout
            android:id="@+id/cc_opt_cs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_cc_option"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/cc_cs_art"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/banner_create_csclient" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_cc_art_fade" />

                    <TextView
                        android:id="@+id/cc_cs_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="9dp"
                        android:background="@drawable/bg_cc_badge_amber"
                        android:letterSpacing="0.12"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:singleLine="true"
                        android:text="@string/cc_cs_badge"
                        android:textColor="@color/hm_amber"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="11dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/cc_cs_tile"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_pp_icon_tile">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:padding="5dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_cs_full" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="@string/cc_cs_title"
                                android:textColor="@color/hm_text"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/cc_cs_line1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:text="@string/cc_cs_soon"
                                android:textColor="@color/hm_amber"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:lineSpacingExtra="1dp"
                        android:maxLines="2"
                        android:text="@string/cc_cs_desc"
                        android:textColor="@color/hm_text_dim"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_cc_option_overlay"
                android:duplicateParentState="true" />
        </FrameLayout>


        <!-- ═════ modpack ═════ -->
        <FrameLayout
            android:id="@+id/cc_opt_modpack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_cc_option"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/cc_modpack_art"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/banner_create_modpack" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_cc_art_fade" />

                    <TextView
                        android:id="@+id/cc_modpack_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|start"
                        android:layout_margin="9dp"
                        android:background="@drawable/bg_cc_badge_dark"
                        android:letterSpacing="0.12"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:singleLine="true"
                        android:text="@string/cc_modpack_badge"
                        android:textColor="@color/hm_text"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="11dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/cc_modpack_tile"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_pp_icon_tile">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_modrinth" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="@string/cc_modpack_title"
                                android:textColor="@color/hm_text"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:ellipsize="end"
                        android:lineSpacingExtra="1dp"
                        android:maxLines="2"
                        android:text="@string/cc_modpack_desc"
                        android:textColor="@color/hm_text_dim"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_cc_option_overlay"
                android:duplicateParentState="true" />
        </FrameLayout>

        </LinearLayout>

    </LinearLayout>
</FrameLayout>
