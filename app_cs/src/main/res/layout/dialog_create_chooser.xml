<?xml version="1.0" encoding="utf-8"?>
<!--
    GENERATED by tools/gen_cc_layout.py
    "Create" chooser popup (opened from Create New Instance of the profile picker):
    Normal (Vanilla / Fabric / Forge ...) | CS Client (coming soon) | Modpack.
    Card width and option height are adjusted in code to the screen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/cc_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/hm_scrim"
        android:clickable="true"
        android:contentDescription="@string/pp_close"
        android:focusable="true" />

    <LinearLayout
        android:id="@+id/cc_card"
        android:layout_width="620dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_pp_card"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="false"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:id="@+id/cc_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.3"
                    android:text="@string/cc_label"
                    android:textColor="@color/hm_accent"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/cc_title"
                    android:textColor="@color/hm_text"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/cc_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_pp_round_btn"
                android:contentDescription="@string/pp_close"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pp_close" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cc_options"
            android:layout_width="match_parent"
            android:layout_height="186dp"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

        <!-- ═════ normal ═════ -->
        <FrameLayout
            android:id="@+id/cc_opt_normal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_cc_option"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/cc_normal_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/banner_create_normal" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_cc_art_fade" />

            <TextView
                android:id="@+id/cc_normal_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="10dp"
                android:background="@drawable/bg_cc_badge_dark"
                android:letterSpacing="0.12"
                android:paddingStart="9dp"
                android:paddingTop="3dp"
                android:paddingEnd="9dp"
                android:paddingBottom="3dp"
                android:singleLine="true"
                android:text="@string/cc_normal_badge"
                android:textColor="@color/hm_text"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="12dp">

                <FrameLayout
                    android:id="@+id/cc_normal_tile"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_pp_icon_tile">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="top|start"
                        android:layout_margin="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_fabric" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="4dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_forge" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:shadowColor="@color/hm_text_shadow"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:singleLine="true"
                    android:text="@string/cc_normal_title"
                    android:textColor="@color/hm_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:shadowColor="@color/hm_text_shadow"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:text="@string/cc_normal_desc"
                    android:textColor="@color/hm_text_dim"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_cc_option_overlay"
                android:duplicateParentState="true" />
        </FrameLayout>


        <!-- ═════ cs ═════ -->
        <FrameLayout
            android:id="@+id/cc_opt_cs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_cc_option"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/cc_cs_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.78"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/banner_create_csclient" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_cc_art_fade" />

            <TextView
                android:id="@+id/cc_cs_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="10dp"
                android:background="@drawable/bg_cc_badge_amber"
                android:letterSpacing="0.12"
                android:paddingStart="9dp"
                android:paddingTop="3dp"
                android:paddingEnd="9dp"
                android:paddingBottom="3dp"
                android:singleLine="true"
                android:text="@string/cc_cs_badge"
                android:textColor="@color/hm_amber"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="12dp">

                <FrameLayout
                    android:id="@+id/cc_cs_tile"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_pp_icon_tile">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_cs_full" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:shadowColor="@color/hm_text_shadow"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:singleLine="true"
                    android:text="@string/cc_cs_title"
                    android:textColor="@color/hm_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                    <TextView
                        android:id="@+id/cc_cs_line1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:singleLine="true"
                        android:text="@string/cc_cs_soon"
                        android:textColor="@color/hm_amber"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:shadowColor="@color/hm_text_shadow"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:text="@string/cc_cs_desc"
                    android:textColor="@color/hm_text_dim"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_cc_option_overlay"
                android:duplicateParentState="true" />
        </FrameLayout>


        <!-- ═════ modpack ═════ -->
        <FrameLayout
            android:id="@+id/cc_opt_modpack"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_cc_option"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/cc_modpack_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/banner_create_modpack" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_cc_art_fade" />

            <TextView
                android:id="@+id/cc_modpack_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="10dp"
                android:background="@drawable/bg_cc_badge_dark"
                android:letterSpacing="0.12"
                android:paddingStart="9dp"
                android:paddingTop="3dp"
                android:paddingEnd="9dp"
                android:paddingBottom="3dp"
                android:singleLine="true"
                android:text="@string/cc_modpack_badge"
                android:textColor="@color/hm_text"
                android:textSize="9.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="12dp">

                <FrameLayout
                    android:id="@+id/cc_modpack_tile"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_pp_icon_tile">
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_modrinth" />
                </FrameLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:ellipsize="end"
                    android:shadowColor="@color/hm_text_shadow"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:singleLine="true"
                    android:text="@string/cc_modpack_title"
                    android:textColor="@color/hm_text"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:shadowColor="@color/hm_text_shadow"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:text="@string/cc_modpack_desc"
                    android:textColor="@color/hm_text_dim"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_cc_option_overlay"
                android:duplicateParentState="true" />
        </FrameLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/cc_more"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_ci_dropdown_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@string/cc_more"
                android:textColor="@color/hm_accent"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_home_chevron_right" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
