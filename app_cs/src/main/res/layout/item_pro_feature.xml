<?xml version="1.0" encoding="utf-8"?>
<!-- One upcoming CS Launcher Pro feature: number badge, name, one line -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_st_icon_box"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/pf_number"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_pe_number"
        android:fontFamily="@font/jetbrains_mono"
        android:gravity="center"
        android:textColor="@color/pe_btn_primary_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pf_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/pe_text_primary"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pf_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/pe_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
