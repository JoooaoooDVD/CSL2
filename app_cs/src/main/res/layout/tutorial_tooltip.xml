<?xml version="1.0" encoding="utf-8"?>
<!--
    Tooltip card of the tutorial spotlight (TutorialOverlay). Positioned in code next to the
    highlighted control. Always dark (obsidian) regardless of the launcher theme: it sits on the
    dim scrim. Text colors are explicit for that reason.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tut_card"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/tut_card_bg"
    android:elevation="10dp"
    android:focusable="true"
    android:importantForAccessibility="yes"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tut_eyebrow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:letterSpacing="0.14"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="#9C9CA4"
            android:textSize="10.5sp"
            android:textStyle="bold"
            tools:text="Step 2 of 7 · Home screen" />

        <ImageButton
            android:id="@+id/tut_close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/tut_icon_btn"
            android:contentDescription="@string/tut_close"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_tut_close" />
    </LinearLayout>

    <TextView
        android:id="@+id/tut_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/noto_sans_bold"
        android:textColor="#F2F5FA"
        android:textSize="16sp"
        tools:text="The PLAY button" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fadeScrollbars="true"
        android:maxHeight="150dp"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/tut_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2sp"
            android:textColor="#D6D6DE"
            android:textSize="12.5sp"
            tools:text="Starts the selected profile. On the first launch of a version the launcher downloads the game first and shows the progress here." />
    </ScrollView>

    <LinearLayout
        android:id="@+id/tut_instruction_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/tut_inner_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="7dp"
        android:paddingEnd="10dp"
        android:paddingBottom="7dp">

        <View
            android:id="@+id/tut_instruction_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/tut_dot" />

        <TextView
            android:id="@+id/tut_instruction"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:textColor="#F2F5FA"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Tap the PLAY button to continue" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/tut_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="12dp"
        android:max="1000"
        android:progressDrawable="@drawable/tut_progress" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical|end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tut_back"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/tut_btn_ghost"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/tut_back"
            android:textColor="#E4E4EA"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tut_skip"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/tut_btn_ghost"
            android:gravity="center"
            android:minWidth="48dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/tut_skip_step"
            android:textColor="#E4E4EA"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tut_next"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/tut_btn_primary"
            android:gravity="center"
            android:minWidth="72dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/tut_next"
            android:textColor="#101014"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
