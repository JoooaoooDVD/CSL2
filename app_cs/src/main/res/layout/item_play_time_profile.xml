<?xml version="1.0" encoding="utf-8"?>
<!-- One profile row of the Play Time screen: icon, name, share bar, last played -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:background="@drawable/bg_vl_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="9dp"
    android:paddingEnd="12dp"
    android:paddingBottom="9dp">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_pp_icon_tile"
        android:clipToOutline="true">

        <ImageView
            android:id="@+id/pt_profile_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="5dp"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/pt_profile_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/vl_text"
                android:textSize="13.5sp"
                android:textStyle="bold"
                tools:text="Fabric 1.21.1" />

            <TextView
                android:id="@+id/pt_profile_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textColor="@color/vl_text"
                android:textSize="13.5sp"
                tools:text="12h 40m" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_pt_progress_track">

            <View
                android:id="@+id/pt_profile_bar"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_pt_progress_fill" />
        </FrameLayout>

        <TextView
            android:id="@+id/pt_profile_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/vl_text_dim"
            android:textSize="11sp"
            tools:text="1.21.1 · 14 sessions · 62% of total" />

        <TextView
            android:id="@+id/pt_profile_last"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/vl_text_faint"
            android:textSize="10.5sp"
            tools:text="Last played 2 hours ago · longest 3h 10m" />
    </LinearLayout>
</LinearLayout>
