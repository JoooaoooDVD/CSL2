<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:paddingHorizontal="10dp">

    <!-- Top collapsing banner and search overlay -->
    <LinearLayout
        android:id="@+id/search_mod_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:translationZ="10dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Horizontal Banner Header -->
        <FrameLayout
            android:id="@+id/search_mod_banner"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/bg_banner_card"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/card_browser" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/settings_header_scrim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:id="@+id/search_mod_header_icon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_settings_icon_box"
                    android:contentDescription="@null"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_nav_browser" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/search_mod_banner_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/content_picker_title_browse"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/search_mod_banner_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/hint_search_mod"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- Search Bar Row -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_home"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp">

            <EditText
                android:id="@+id/search_mod_edittext"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:background="@null"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                android:hint="@string/hint_search_modpack"
                android:inputType="textPersonName"
                android:paddingHorizontal="8dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/search_mod_filter"
                app:layout_constraintBottom_toTopOf="@id/search_mod_progressbar" />

            <ImageButton
                android:id="@+id/search_mod_filter"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_icon_button_home"
                android:src="@drawable/ic_filter"
                android:tint="?attr/colorOnSurface"
                android:stateListAnimator="?attr/csPressAnimator"
                android:padding="8dp"
                android:contentDescription="@string/content_picker_filter"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@id/search_mod_progressbar" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/search_mod_progressbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone"
                android:layout_marginTop="2dp"
                app:layout_constraintTop_toBottomOf="@+id/search_mod_edittext"
                app:layout_constraintBottom_toBottomOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/search_mod_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingTop="0dp"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/mineButton_import_local_modpack"
        app:layout_goneMarginBottom="0dp" />

    <TextView
        android:id="@+id/search_mod_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:visibility="gone"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintBottom_toBottomOf="@+id/search_mod_list"
        app:layout_constraintEnd_toEndOf="@+id/search_mod_list"
        app:layout_constraintStart_toStartOf="@+id/search_mod_list"
        app:layout_constraintTop_toTopOf="@+id/search_mod_list" />

    <!-- Only the standalone modpack search screen (SearchModFragment) shows this -->
    <com.kdt.mcgui.MineButton
        android:id="@+id/mineButton_import_local_modpack"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:enabled="false"
        android:visibility="gone"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="@string/import_local_modpack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="1.0" />

</androidx.constraintlayout.widget.ConstraintLayout>
