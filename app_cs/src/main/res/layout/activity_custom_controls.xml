<?xml version="1.0" encoding="utf-8"?>
<!--
    Control editor (Change 11): grid canvas, floating "Edit" handle, hint chip and a styled
    right panel (add tiles + layout actions) instead of the plain ListView drawer.
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/customctrl_drawerlayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ce_grid_backdrop">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/ce_grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_ce_grid" />

        <com.craftstudio.cslauncher.input.ControlLayout
            android:id="@+id/customctrl_controllayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Floating handle: opens the panel -->
        <LinearLayout
            android:id="@+id/drawer_button"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_ce_handle"
            android:clickable="true"
            android:contentDescription="@string/ce_title"
            android:elevation="10dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/ce_handle_icon"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_cc_sliders"
                app:tint="@color/hm_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:text="@string/ce_handle"
                android:textColor="@color/hm_text"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@null"
                android:rotation="270"
                android:src="@drawable/ic_ci_back"
                app:tint="@color/hm_text_dim" />
        </LinearLayout>

        <!-- Hint chip (fades away by itself) -->
        <LinearLayout
            android:id="@+id/ce_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_ce_hint"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="6dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_cc_button"
                app:tint="@color/hm_accent" />

            <TextView
                android:id="@+id/ce_hint_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="6dp"
                android:maxWidth="460dp"
                android:text="@string/ce_hint"
                android:textColor="@color/hm_text_dim"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/ce_hint_close"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_mm_btn"
                android:contentDescription="@string/pp_close"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_cc_close"
                app:tint="@color/hm_icon" />
        </LinearLayout>
    </FrameLayout>

    <!-- ═══ Right panel ═══ -->
    <LinearLayout
        android:id="@+id/customctrl_navigation_view"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="right"
        android:background="@drawable/bg_ce_panel"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/ce_panel_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/ce_panel_tile"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_pp_icon_tile">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_dock_controls"
                            app:tint="@color/hm_accent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ce_title"
                            android:textColor="@color/hm_text"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/ce_layout_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="middle"
                            android:maxLines="1"
                            android:textColor="@color/hm_text_dim"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/ce_panel_close"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_pp_round_btn"
                        android:contentDescription="@string/pp_close"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_cc_close"
                        app:tint="@color/hm_icon" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:letterSpacing="0.18"
                    android:text="@string/ce_section_add"
                    android:textColor="@color/hm_accent"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/ce_add_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/ce_add_button"
                        style="@style/Editor.AddTile"
                        android:layout_marginEnd="8dp">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_mm_type_mods">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_cc_button"
                                app:tint="@color/mm_mods_glyph" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:maxLines="1"
                            android:text="@string/ce_add_button"
                            android:textColor="@color/hm_text"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ce_add_drawer"
                        style="@style/Editor.AddTile"
                        android:layout_marginEnd="8dp">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_mm_type_sh">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_cc_drawer"
                                app:tint="@color/mm_sh_glyph" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:maxLines="1"
                            android:text="@string/ce_add_drawer"
                            android:textColor="@color/hm_text"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ce_add_joystick"
                        style="@style/Editor.AddTile">

                        <FrameLayout
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/bg_mm_type_rp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_cc_joystick"
                                app:tint="@color/mm_rp_glyph" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:maxLines="1"
                            android:text="@string/ce_add_joystick"
                            android:textColor="@color/hm_text"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:letterSpacing="0.18"
                    android:text="@string/ce_section_layout"
                    android:textColor="@color/hm_accent"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/ce_load"
                    style="@style/Editor.Row">

                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_mm_icon_tile">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_cc_load"
                            app:tint="@color/hm_accent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ce_load"
                            android:textColor="@color/hm_text"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ce_load_desc"
                            android:textColor="@color/hm_text_dim"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:rotation="180"
                        android:src="@drawable/ic_ci_back"
                        app:tint="@color/hm_text_dim" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ce_save"
                    style="@style/Editor.Row">

                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_mm_icon_tile">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_cc_save"
                            app:tint="@color/hm_accent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ce_save"
                            android:textColor="@color/hm_text"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ce_save_desc"
                            android:textColor="@color/hm_text_dim"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:rotation="180"
                        android:src="@drawable/ic_ci_back"
                        app:tint="@color/hm_text_dim" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ce_default"
                    style="@style/Editor.Row">

                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_mm_icon_tile">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_cc_default"
                            app:tint="@color/hm_accent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ce_default"
                            android:textColor="@color/hm_text"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ce_default_desc"
                            android:textColor="@color/hm_text_dim"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:rotation="180"
                        android:src="@drawable/ic_ci_back"
                        app:tint="@color/hm_text_dim" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ce_export"
                    style="@style/Editor.Row">

                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_mm_icon_tile">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_cc_export"
                            app:tint="@color/hm_accent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ce_export"
                            android:textColor="@color/hm_text"
                            android:textSize="13.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ce_export_desc"
                            android:textColor="@color/hm_text_dim"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:rotation="180"
                        android:src="@drawable/ic_ci_back"
                        app:tint="@color/hm_text_dim" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ce_exit"
                    style="@style/Editor.Row"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_ce_exit_row"
                    android:minHeight="46dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_cc_exit"
                        app:tint="@color/mm_danger" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="@string/ce_exit"
                        android:textColor="@color/mm_danger"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
