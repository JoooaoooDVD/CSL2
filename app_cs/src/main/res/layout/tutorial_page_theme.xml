<?xml version="1.0" encoding="utf-8"?>
<!-- Setup page 3: launcher theme (the real "theme_mode" preference) + where Minecraft's look lives -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.14"
        android:text="@string/tut_theme_section"
        android:textAllCaps="true"
        android:textColor="#9C9CA4"
        android:textSize="10.5sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <include layout="@layout/tutorial_option_card" android:id="@+id/tut_theme_dark" />
        <Space android:layout_width="10dp" android:layout_height="1dp" />
        <include layout="@layout/tutorial_option_card" android:id="@+id/tut_theme_light" />
        <Space android:layout_width="10dp" android:layout_height="1dp" />
        <include layout="@layout/tutorial_option_card" android:id="@+id/tut_theme_system" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/tut_theme_note"
        android:textColor="#9C9CA4"
        android:textSize="11.5sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/tut_card_bg"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.14"
            android:text="@string/tut_theme_mc_eyebrow"
            android:textAllCaps="true"
            android:textColor="#9C9CA4"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tut_theme_mc_title"
            android:textColor="#F2F5FA"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2sp"
            android:text="@string/tut_theme_mc_text"
            android:textColor="#C9C9D1"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
