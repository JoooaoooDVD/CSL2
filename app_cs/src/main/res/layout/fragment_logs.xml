<?xml version="1.0" encoding="utf-8"?>
<!-- Redesigned Launcher Log viewer with horizontal banner and modern terminal card -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- Top Horizontal Banner -->
    <FrameLayout
        android:id="@+id/logs_banner"
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:layout_marginHorizontal="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_banner_card"
        android:clipToOutline="true">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/banner_gradient_logs" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/settings_header_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_settings_icon_box"
                android:contentDescription="@null"
                android:padding="7dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_px_console" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/home_logs_title"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Console output and crash diagnostics"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/logs_reload_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_icon_button_home"
                android:contentDescription="@string/home_logs_title"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_refresh_home"
                android:stateListAnimator="?attr/csPressAnimator" />

            <ImageButton
                android:id="@+id/logs_share_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_icon_button_home"
                android:contentDescription="@string/home_logs_share"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_px_sharelog"
                android:stateListAnimator="?attr/csPressAnimator" />

        </LinearLayout>
    </FrameLayout>

    <!-- Terminal Output Card -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginHorizontal="10dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card_home"
        android:clipToOutline="true">

        <ScrollView
            android:id="@+id/logs_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:scrollbars="vertical">

            <TextView
                android:id="@+id/logs_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:textIsSelectable="true"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="10sp" />
        </ScrollView>
    </FrameLayout>

</LinearLayout>
