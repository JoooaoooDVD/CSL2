<?xml version="1.0" encoding="utf-8"?>
<!-- A small log viewer for the launcher's own log file, styled like the home screen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.06"
            android:text="@string/home_logs_title"
            android:textColor="@color/home_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/logs_reload_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_icon_button_home"
            android:contentDescription="@string/home_logs_title"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_refresh_home"
            android:stateListAnimator="?attr/csPressAnimator" />

        <ImageButton
            android:id="@+id/logs_share_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icon_button_home"
            android:contentDescription="@string/home_logs_share"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_px_sharelog"
            android:stateListAnimator="?attr/csPressAnimator" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/home_divider" />

    <ScrollView
        android:id="@+id/logs_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/logs_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:textColor="@color/home_text_dim"
            android:textSize="10sp"
            android:lineSpacingExtra="2dp" />
    </ScrollView>
</LinearLayout>
