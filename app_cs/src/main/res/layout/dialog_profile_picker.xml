<?xml version="1.0" encoding="utf-8"?>
<!--
    Profile picker popup (opened from the selected profile / version chip / PLAY chevron).
    Left: info column with the current profile and the Create New Instance button.
    Right: the scrollable list of every instance. Card size is adjusted in code to the screen.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pp_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/pp_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/hm_scrim"
        android:clickable="true"
        android:contentDescription="@string/pp_close"
        android:focusable="true" />

    <LinearLayout
        android:id="@+id/pp_card"
        android:layout_width="660dp"
        android:layout_height="340dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_pp_card"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="false"
        android:orientation="horizontal">

        <!-- ═════ Info column ═════ -->
        <FrameLayout
            android:id="@+id/pp_side"
            android:layout_width="230dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_pp_side">

            <!-- Big faint cube in the corner, pure decoration -->
            <ImageView
                android:id="@+id/pp_side_deco"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="end|top"
                android:layout_marginTop="-26dp"
                android:layout_marginEnd="-34dp"
                android:alpha="0.13"
                android:contentDescription="@null"
                android:rotation="14"
                android:src="@drawable/ic_home_cube_glow" />

            <LinearLayout
                android:id="@+id/pp_side_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.3"
                    android:text="@string/pp_label"
                    android:textColor="@color/hm_accent"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/pp_title"
                    android:textColor="@color/hm_text"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/pp_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/hm_text_dim"
                    android:textSize="12.5sp"
                    tools:text="3 instances" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.25"
                    android:text="@string/pp_current"
                    android:textColor="@color/hm_text_dim"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/pp_current"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_pp_current"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="10dp">

                    <FrameLayout
                        android:id="@+id/pp_current_tile"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_pp_icon_tile">

                        <ImageView
                            android:id="@+id/pp_current_icon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:padding="5dp"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/pp_current_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="@color/hm_text"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="Fabulously Optimized" />

                        <TextView
                            android:id="@+id/pp_current_sub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="@color/hm_text_dim"
                            android:textSize="11.5sp"
                            tools:text="26.3 • Fabric" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Create New Instance: same pixel texture as PLAY -->
                <FrameLayout
                    android:id="@+id/pp_create"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_home_play_clip"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:id="@+id/pp_create_texture"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/home_play_texture" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_home_play_edge"
                        android:duplicateParentState="true" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/pp_create_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_pp_plus_dark" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="9dp"
                            android:singleLine="true"
                            android:text="@string/pp_create"
                            android:textColor="#FF0E1525"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/hm_card_stroke" />

        <!-- ═════ Instance list ═════ -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/pp_list_header"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/pp_all"
                    android:textColor="@color/hm_text"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/pp_close"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_pp_round_btn"
                    android:contentDescription="@string/pp_close"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pp_close" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/pp_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:overScrollMode="ifContentScrolls"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp"
                    android:scrollbarStyle="outsideOverlay"
                    android:scrollbars="vertical" />

                <TextView
                    android:id="@+id/pp_empty"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="@string/pp_empty"
                    android:textColor="@color/hm_text_dim"
                    android:textSize="13.5sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
