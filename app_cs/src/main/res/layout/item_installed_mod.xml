<?xml version="1.0" encoding="utf-8"?>
<!-- Manager row: icon tile · name + state pill + file · actions -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/bg_mm_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="74dp"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="10dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp"
    android:stateListAnimator="?attr/csPressAnimator">

    <!-- Icon tile (clipped in code) -->
    <FrameLayout
        android:id="@+id/installed_mod_icon_tile"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:background="@drawable/bg_mm_icon_tile">

        <ImageView
            android:id="@+id/installed_mod_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="3dp"
            android:scaleType="fitCenter"
            tools:src="@mipmap/ic_launcher_foreground" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/installed_mod_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/hm_text"
            android:textSize="14.5sp"
            android:textStyle="bold"
            tools:text="Sodium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/installed_mod_state"
                android:layout_width="wrap_content"
                android:layout_height="19dp"
                android:background="@drawable/bg_mm_state_on"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/hm_profile_active"
                android:textSize="10.5sp"
                android:textStyle="bold"
                tools:text="Enabled" />

            <TextView
                android:id="@+id/installed_mod_version"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="middle"
                android:maxLines="1"
                android:textColor="@color/hm_text_dim"
                android:textSize="11.5sp"
                tools:text="v0.6.0  ·  1.2 MB  ·  sodium-fabric-0.6.0.jar" />
        </LinearLayout>

        <TextView
            android:id="@+id/installed_mod_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/hm_text_dim"
            android:textSize="11.5sp"
            android:visibility="gone"
            tools:text="A modern rendering engine for Minecraft which greatly improves performance"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Update (only when one is available) -->
    <ImageButton
        android:id="@+id/installed_mod_update"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_mm_btn_update"
        android:contentDescription="@string/mod_update"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_lib_download"
        android:visibility="gone"
        app:tint="@color/hm_amber"
        tools:visibility="visible" />

    <!-- Takes the update button's place while the update is downloading -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/installed_mod_update_progress"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="6dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/hm_amber"
        app:indicatorSize="20dp"
        app:trackThickness="2dp" />

    <!-- Switch version -->
    <ImageButton
        android:id="@+id/installed_mod_switch_version"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_mm_btn"
        android:contentDescription="@string/switch_mod_version_button_desc"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_lib_swap"
        app:tint="@color/hm_icon" />

    <!-- Delete -->
    <ImageButton
        android:id="@+id/installed_mod_delete"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_mm_btn_danger"
        android:contentDescription="@string/delete"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_lib_trash"
        app:tint="@color/mm_danger" />

    <!-- Enable / disable -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/installed_mod_toggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:checked="true" />

</LinearLayout>
