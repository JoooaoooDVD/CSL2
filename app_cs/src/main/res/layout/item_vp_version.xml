<?xml version="1.0" encoding="utf-8"?>
<!-- One version in the picker: channel tile, name, meta, file line, badge, check -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_vp_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="68dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:id="@+id/vpi_channel"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_vp_channel">

        <TextView
            android:id="@+id/vpi_channel_text"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/noto_sans_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/vpi_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hm_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/vpi_badge"
                style="@style/Library.Badge"
                android:layout_marginStart="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/vpi_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/hm_text"
            android:alpha="0.8"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/vpi_extra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="middle"
            android:maxLines="1"
            android:textColor="@color/hm_text_dim"
            android:textSize="11.5sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/vpi_check_wrap"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_ss_step_num">

        <ImageView
            android:id="@+id/vpi_check"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_pp_check"
            android:tint="#FFFFFF"
            android:visibility="invisible" />
    </FrameLayout>
</LinearLayout>
