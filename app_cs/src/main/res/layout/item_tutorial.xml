<?xml version="1.0" encoding="utf-8"?>
<!-- Tutorial Center row -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/tut_inner_bg"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="62dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/it_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_settings_icon_box"
        android:contentDescription="@null"
        android:padding="8dp"
        android:scaleType="fitCenter"
        tools:src="@drawable/ic_px_home" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/it_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#F2F5FA"
                android:textSize="13.5sp"
                android:textStyle="bold"
                tools:text="Profiles and versions" />

            <TextView
                android:id="@+id/it_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/tut_chip_bg"
                android:paddingStart="7dp"
                android:paddingTop="1dp"
                android:paddingEnd="7dp"
                android:paddingBottom="1dp"
                android:textColor="@color/tut_chip_text"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="RECOMMENDED"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/it_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#9C9CA4"
            android:textSize="11.5sp"
            tools:text="Create a profile, pick a version and loader, and switch between setups." />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/it_status_dot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/tut_status_new" />

            <TextView
                android:id="@+id/it_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="#9C9CA4"
                android:textSize="10.5sp"
                tools:text="Not started · 6 steps · 3 min" />

            <ProgressBar
                android:id="@+id/it_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="4dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:max="100"
                android:progressDrawable="@drawable/tut_progress"
                tools:progress="40" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/it_action"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/tut_btn_ghost"
        android:gravity="center"
        android:minWidth="74dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="#E4E4EA"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="Start" />
</LinearLayout>
