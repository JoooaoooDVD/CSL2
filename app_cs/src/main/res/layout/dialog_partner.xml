<?xml version="1.0" encoding="utf-8"?>
<!-- Official partner announcement popup (compact, dismissible). Filled by PartnerPopupDialog. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/pp_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/hm_scrim"
        android:clickable="true"
        android:focusable="true" />

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginVertical="10dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/pp_card"
            android:layout_width="400dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pp_card"
            android:clickable="true"
            android:elevation="16dp"
            android:orientation="vertical">

            <!-- Hero -->
            <FrameLayout
                android:id="@+id/pp_hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_partner_hero"
                android:paddingHorizontal="16dp"
                android:paddingTop="14dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/pp_logo_cs_wrap"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_partner_logo_tile">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:padding="7dp"
                            android:scaleType="fitCenter"
                            android:src="@mipmap/ic_launcher" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="8dp"
                        android:text="×"
                        android:textColor="#D9B356"
                        android:textSize="20sp" />

                    <FrameLayout
                        android:id="@+id/pp_logo_wrap"
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_partner_logo_tile">

                        <ImageView
                            android:id="@+id/pp_logo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_margin="1dp"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            tools:src="@drawable/partner_optl_logo" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/pp_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_partner_badge"
                            android:letterSpacing="0.08"
                            android:paddingHorizontal="7dp"
                            android:paddingVertical="2dp"
                            android:textColor="#D9B356"
                            android:textSize="8.5sp"
                            android:textStyle="bold"
                            tools:text="OFFICIAL PARTNER" />

                        <TextView
                            android:id="@+id/pp_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/noto_sans_bold"
                            android:textColor="#F2F5FA"
                            android:textSize="15.5sp"
                            tools:text="CS Launcher × OPTL" />

                        <TextView
                            android:id="@+id/pp_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#9C9CA4"
                            android:textSize="11sp"
                            tools:text="Official Pojav Tierlist" />
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/pp_close"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-6dp"
                    android:layout_marginEnd="-8dp"
                    android:background="@drawable/bg_pp_round_btn"
                    android:contentDescription="@android:string/cancel"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pp_close"
                    android:tint="#9C9CA4" />
            </FrameLayout>

            <!-- Body -->
            <LinearLayout
                android:id="@+id/pp_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="14dp">

                <TextView
                    android:id="@+id/pp_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="2dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12.5sp"
                    tools:text="CS Launcher is the official launcher of OPTL…" />

                <LinearLayout
                    android:id="@+id/pp_highlight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_partner_highlight"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <TextView
                        android:id="@+id/pp_highlight_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/minecraft_ten"
                        android:includeFontPadding="false"
                        android:textColor="#D9B356"
                        android:textSize="24sp"
                        tools:text="5" />

                    <TextView
                        android:id="@+id/pp_highlight_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:letterSpacing="0.1"
                        android:textColor="#D9B356"
                        android:textSize="9.5sp"
                        android:textStyle="bold"
                        tools:text="DAYS" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/pp_highlight_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="12.5sp"
                            android:textStyle="bold"
                            tools:text="5-Day Tier Testing Cooldown" />

                        <TextView
                            android:id="@+id/pp_highlight_old"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="10.5sp"
                            tools:text="Standard cooldown: 7 days" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/pp_more"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11.5sp"
                    tools:text="+ 4 more exclusive benefits for CS Launcher users" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/pp_later"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="2"
                        android:background="@drawable/bg_pp_row"
                        android:gravity="center"
                        android:text="@string/partner_popup_later"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/pp_explore"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="3"
                        android:background="@drawable/bg_partner_discord_btn"
                        android:drawableEnd="@drawable/ic_home_chevron_right"
                        android:drawablePadding="6dp"
                        android:drawableTint="#FFFFFF"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        tools:text="Explore OPTL" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
