<?xml version="1.0" encoding="utf-8"?>
<!--
    "Manage content" popup: Mods | Resource packs | Shader packs | Worlds (installed counts
    load in the background). Card art: the manager banner on top, gradient icon tiles below.
    Card width is set in code.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/mc_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/hm_scrim"
        android:clickable="true"
        android:contentDescription="@string/pp_close"
        android:focusable="true" />

    <LinearLayout
        android:id="@+id/mc_card"
        android:layout_width="620dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_pp_card"
        android:clickable="true"
        android:clipToOutline="true"
        android:elevation="16dp"
        android:focusable="false"
        android:orientation="vertical">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/banner_home_manager" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

        <LinearLayout
            android:id="@+id/mc_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.3"
                    android:text="@string/mm_eyebrow"
                    android:textColor="@color/hm_accent"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/mc_title"
                    android:textColor="@color/hm_text"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mc_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/hm_text_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/mc_filter"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_ci_button_outline"
                android:drawableStart="@drawable/ic_filter"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:text="@string/mc_filters"
                android:textColor="@color/hm_text"
                android:textSize="12.5sp"
                android:textStyle="bold"
                app:drawableTint="@color/hm_icon" />

            <ImageButton
                android:id="@+id/mc_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_pp_round_btn"
                android:contentDescription="@string/pp_close"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pp_close" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mc_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

        <!-- ═════ mods ═════ -->
        <LinearLayout
            android:id="@+id/mc_opt_mods"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_mm_option"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="14dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="64dp">

                <View
                    android:id="@+id/mc_mods_glow"
                    android:layout_width="96dp"
                    android:layout_height="64dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="-22dp"
                    android:alpha="0.3"
                    android:background="@drawable/bg_mm_glow_mods" />

                <FrameLayout
                    android:id="@+id/mc_mods_tile"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/bg_mm_type_mods">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_lib_cube"
                        app:tint="@color/mm_mods_glyph" />
                </FrameLayout>

                <TextView
                    android:id="@+id/mc_mods_count"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_mm_count_pill"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:text="@string/mc_count_loading"
                    android:textColor="@color/hm_text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/mcl_content_mods"
                android:textColor="@color/hm_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:lines="2"
                android:maxLines="2"
                android:text="@string/mc_desc_mods"
                android:textColor="@color/hm_text_dim"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/mc_mods_bar"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_mm_type_mods"
                    android:alpha="0.85" />

                <ImageView
                    android:id="@+id/mc_mods_chevron"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_mm_btn"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:rotation="180"
                    android:src="@drawable/ic_ci_back"
                    app:tint="@color/hm_icon" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═════ rp ═════ -->
        <LinearLayout
            android:id="@+id/mc_opt_rp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_mm_option"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="14dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="64dp">

                <View
                    android:id="@+id/mc_rp_glow"
                    android:layout_width="96dp"
                    android:layout_height="64dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="-22dp"
                    android:alpha="0.3"
                    android:background="@drawable/bg_mm_glow_rp" />

                <FrameLayout
                    android:id="@+id/mc_rp_tile"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/bg_mm_type_rp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_lib_image"
                        app:tint="@color/mm_rp_glyph" />
                </FrameLayout>

                <TextView
                    android:id="@+id/mc_rp_count"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_mm_count_pill"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:text="@string/mc_count_loading"
                    android:textColor="@color/hm_text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/mcl_content_resourcepacks"
                android:textColor="@color/hm_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:lines="2"
                android:maxLines="2"
                android:text="@string/mc_desc_rp"
                android:textColor="@color/hm_text_dim"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/mc_rp_bar"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_mm_type_rp"
                    android:alpha="0.85" />

                <ImageView
                    android:id="@+id/mc_rp_chevron"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_mm_btn"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:rotation="180"
                    android:src="@drawable/ic_ci_back"
                    app:tint="@color/hm_icon" />
            </LinearLayout>
        </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

        <!-- ═════ sh ═════ -->
        <LinearLayout
            android:id="@+id/mc_opt_sh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_mm_option"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="14dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="64dp">

                <View
                    android:id="@+id/mc_sh_glow"
                    android:layout_width="96dp"
                    android:layout_height="64dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="-22dp"
                    android:alpha="0.3"
                    android:background="@drawable/bg_mm_glow_sh" />

                <FrameLayout
                    android:id="@+id/mc_sh_tile"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/bg_mm_type_sh">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_lib_sun"
                        app:tint="@color/mm_sh_glyph" />
                </FrameLayout>

                <TextView
                    android:id="@+id/mc_sh_count"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_mm_count_pill"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:text="@string/mc_count_loading"
                    android:textColor="@color/hm_text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/mcl_content_shaderpacks"
                android:textColor="@color/hm_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:lines="2"
                android:maxLines="2"
                android:text="@string/mc_desc_sh"
                android:textColor="@color/hm_text_dim"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/mc_sh_bar"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_mm_type_sh"
                    android:alpha="0.85" />

                <ImageView
                    android:id="@+id/mc_sh_chevron"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_mm_btn"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:rotation="180"
                    android:src="@drawable/ic_ci_back"
                    app:tint="@color/hm_icon" />
            </LinearLayout>
        </LinearLayout>

        <!-- ═════ worlds ═════ -->
        <LinearLayout
            android:id="@+id/mc_opt_world"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_mm_option"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="14dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="64dp">

                <View
                    android:id="@+id/mc_world_glow"
                    android:layout_width="96dp"
                    android:layout_height="64dp"
                    android:layout_gravity="start|center_vertical"
                    android:layout_marginStart="-22dp"
                    android:alpha="0.3"
                    android:background="@drawable/bg_mm_glow_world" />

                <FrameLayout
                    android:id="@+id/mc_world_tile"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/bg_mm_type_world">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_lib_world"
                        app:tint="@color/mm_world_glyph" />
                </FrameLayout>

                <TextView
                    android:id="@+id/mc_world_count"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_mm_count_pill"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:singleLine="true"
                    android:text="@string/mc_count_loading"
                    android:textColor="@color/hm_text_dim"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/mcl_content_worlds"
                android:textColor="@color/hm_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:lines="2"
                android:maxLines="2"
                android:text="@string/mc_desc_world"
                android:textColor="@color/hm_text_dim"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/mc_world_bar"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_mm_type_world"
                    android:alpha="0.85" />

                <ImageView
                    android:id="@+id/mc_world_chevron"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_mm_btn"
                    android:contentDescription="@null"
                    android:padding="6dp"
                    android:rotation="180"
                    android:src="@drawable/ic_ci_back"
                    app:tint="@color/hm_icon" />
            </LinearLayout>
        </LinearLayout>
            </LinearLayout>

        </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
