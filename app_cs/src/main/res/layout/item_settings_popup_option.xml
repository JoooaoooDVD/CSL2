<?xml version="1.0" encoding="utf-8"?>
<!-- Settings popup: one choice (radio for single choice, box for multi choice) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_sp_option"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="46dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/sp_opt_mark"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        android:src="@drawable/ic_sp_radio" />

    <TextView
        android:id="@+id/sp_opt_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:textColor="@color/hm_text"
        android:textSize="14sp" />
</LinearLayout>
