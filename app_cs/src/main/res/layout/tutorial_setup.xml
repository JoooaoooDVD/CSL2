<?xml version="1.0" encoding="utf-8"?>
<!--
    First-time setup wizard (FirstLaunchSetup). Full-bleed page added to android.R.id.content,
    landscape only (the launcher is landscape). Left: brand + page title + progress dots.
    Right: the page content (tutorial_page_*) above the button bar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tut_setup_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1218"
    android:baselineAligned="false"
    android:clickable="true"
    android:focusable="true"
    android:orientation="horizontal">

    <!-- ── Brand column ── -->
    <LinearLayout
        android:id="@+id/tut_setup_side"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.38"
        android:background="#0B0D12"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="18dp">

        <ImageView
            android:id="@+id/tut_setup_logo"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_short_name"
            android:src="@drawable/ic_cs_full" />

        <TextView
            android:id="@+id/tut_setup_eyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:letterSpacing="0.16"
            android:text="@string/tut_setup_eyebrow"
            android:textAllCaps="true"
            android:textColor="#9C9CA4"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tut_setup_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/noto_sans_bold"
            android:textColor="#F2F5FA"
            android:textSize="22sp"
            tools:text="Welcome to CS Launcher Plus" />

        <TextView
            android:id="@+id/tut_setup_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2sp"
            android:textColor="#9C9CA4"
            android:textSize="12.5sp"
            tools:text="A two minute tour that explains the launcher while you use it." />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Progress dots: welcome · preferences · appearance · tour -->
        <LinearLayout
            android:id="@+id/tut_setup_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View android:layout_width="22dp" android:layout_height="4dp" android:background="@drawable/tut_dot" />
            <View android:layout_width="22dp" android:layout_height="4dp" android:layout_marginStart="6dp" android:background="@drawable/tut_dot" />
            <View android:layout_width="22dp" android:layout_height="4dp" android:layout_marginStart="6dp" android:background="@drawable/tut_dot" />
            <View android:layout_width="22dp" android:layout_height="4dp" android:layout_marginStart="6dp" android:background="@drawable/tut_dot" />
        </LinearLayout>

        <TextView
            android:id="@+id/tut_setup_skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="?attr/selectableItemBackground"
            android:minHeight="40dp"
            android:gravity="center_vertical"
            android:paddingEnd="8dp"
            android:text="@string/tut_setup_skip"
            android:textColor="#C6C6CE"
            android:textSize="12.5sp"
            android:textStyle="bold"
            tools:ignore="RtlSymmetry" />
    </LinearLayout>

    <!-- ── Page column ── -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.62"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp"
        android:paddingBottom="14dp">

        <ScrollView
            android:id="@+id/tut_setup_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fadeScrollbars="true"
            android:scrollbars="vertical">

            <FrameLayout
                android:id="@+id/tut_setup_page"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </ScrollView>

        <LinearLayout
            android:id="@+id/tut_setup_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tut_setup_back"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/tut_btn_ghost"
                android:gravity="center"
                android:minWidth="80dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/tut_back"
                android:textColor="#E4E4EA"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tut_setup_tertiary"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/tut_btn_ghost"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="#E4E4EA"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Launch Minecraft"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tut_setup_secondary"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/tut_btn_ghost"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:textColor="#E4E4EA"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Explore launcher" />

            <TextView
                android:id="@+id/tut_setup_primary"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/tut_btn_primary"
                android:gravity="center"
                android:minWidth="120dp"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:textColor="#101014"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Start setup" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
