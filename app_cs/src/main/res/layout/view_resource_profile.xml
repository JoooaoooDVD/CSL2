<?xml version="1.0" encoding="utf-8"?>
<!-- Compact active-profile strip: name, MC version, loader, resource folder status -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rb_profile_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_rb_card"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:orientation="vertical">
        <TextView style="@style/RbProfileLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rb_profile_label" />
        <TextView
            android:id="@+id/rb_profile_name"
            style="@style/RbProfileValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:text="@string/rb_value_loading" />
    </LinearLayout>

    <View android:layout_width="1dp" android:layout_height="22dp"
        android:layout_marginStart="8dp" android:layout_marginEnd="10dp"
        android:background="@color/rb_card_stroke" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:orientation="vertical">
        <TextView style="@style/RbProfileLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rb_version_label" />
        <TextView
            android:id="@+id/rb_profile_version"
            style="@style/RbProfileValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rb_value_loading" />
    </LinearLayout>

    <View android:layout_width="1dp" android:layout_height="22dp"
        android:layout_marginStart="8dp" android:layout_marginEnd="10dp"
        android:background="@color/rb_card_stroke" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:orientation="vertical">
        <TextView style="@style/RbProfileLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rb_loader_label" />
        <TextView
            android:id="@+id/rb_profile_loader"
            style="@style/RbProfileValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rb_value_loading" />
    </LinearLayout>

    <View android:layout_width="1dp" android:layout_height="22dp"
        android:layout_marginStart="8dp" android:layout_marginEnd="10dp"
        android:background="@color/rb_card_stroke" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView style="@style/RbProfileLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/rb_dir_label" />
        <TextView
            android:id="@+id/rb_profile_dir"
            style="@style/RbProfileValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/rb_value_loading" />
    </LinearLayout>
</LinearLayout>
