<?xml version="1.0" encoding="utf-8"?>
<!--
    Home screen "Official Partner" strip. Compact (one row), fed by PartnerHomeStrip from the
    featured Partner; hidden when there is none. Tapping anywhere opens the partner screen.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/partner_strip"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_home_card_navy"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="50dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <FrameLayout
        android:id="@+id/partner_strip_logo_wrap"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_partner_logo_tile">

        <ImageView
            android:id="@+id/partner_strip_logo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="1dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            tools:src="@drawable/partner_optl_logo" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/partner_strip_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_partner_badge"
                android:letterSpacing="0.08"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:textColor="#D9B356"
                android:textSize="8.5sp"
                android:textStyle="bold"
                tools:text="OFFICIAL PARTNER" />

            <TextView
                android:id="@+id/partner_strip_eyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/hm_text_dim"
                android:textSize="9.5sp"
                tools:text="Official Partner – OPTL" />
        </LinearLayout>

        <TextView
            android:id="@+id/partner_strip_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="@font/noto_sans_bold"
            android:singleLine="true"
            android:textColor="@color/hm_text"
            android:textSize="13sp"
            tools:text="CS Launcher × OPTL" />
    </LinearLayout>

    <TextView
        android:id="@+id/partner_strip_explore"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:background="@drawable/bg_partner_strip_btn"
        android:drawableEnd="@drawable/ic_home_chevron_right"
        android:drawablePadding="2dp"
        android:drawableTint="#D9B356"
        android:duplicateParentState="true"
        android:gravity="center"
        android:paddingStart="11dp"
        android:paddingEnd="6dp"
        android:singleLine="true"
        android:textColor="#D9B356"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="Explore OPTL" />
</LinearLayout>
