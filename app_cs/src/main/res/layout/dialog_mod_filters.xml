<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical">

    <!-- Top Horizontal Banner -->
    <FrameLayout
        android:id="@+id/dialog_mod_filters_banner"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_banner_card"
        android:clipToOutline="true">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/banner_gradient_installer" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/settings_header_scrim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_settings_icon_box"
                android:contentDescription="@null"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_filter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/content_picker_filter"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Choose version and modloader"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Filters Content Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card_home"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Search engine filter: Modrinth / CurseForge / Both -->
        <TextView
            android:id="@+id/search_mod_engine_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/search_mod_engine_label"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/search_mod_engine_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_icon_button_home"
            android:popupBackground="@drawable/bg_popup_rounded" />

        <!-- Version filter -->
        <TextView
            android:id="@+id/search_mod_mc_version_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/profiles_profile_version"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/search_mod_selected_mc_version_textview"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:gravity="center_vertical"
                android:hint="@string/version_select_hint"
                android:paddingHorizontal="10dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface" />

            <Button
                android:id="@+id/search_mod_mc_version_button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:stateListAnimator="?attr/csPressAnimator"
                android:text="@string/global_select" />
        </LinearLayout>

        <!-- Loader filter -->
        <TextView
            android:id="@+id/search_mod_loader_textview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/search_mod_loader_label"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/search_mod_loader_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_icon_button_home"
            android:popupBackground="@drawable/bg_popup_rounded" />

        <!-- Apply -->
        <com.kdt.mcgui.MineButton
            android:id="@+id/search_mod_apply_filters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:stateListAnimator="?attr/csPressAnimator"
            android:text="@string/generic_apply" />

    </LinearLayout>
</LinearLayout>