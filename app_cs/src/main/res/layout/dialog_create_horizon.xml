<?xml version="1.0" encoding="utf-8"?>
<!--
    Horizon Engine profile popup (Create New Instance → Horizon Engine).
    Same card/field language as dialog_create_instance.xml. Left: name, game version (fixed 26.3),
    renderer, CS controls.  Right: resolution scale, engine status.  The progress panel replaces the
    body while the shared engine resources are downloaded / verified / prepared.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/hz_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/hm_scrim"
        android:clickable="true"
        android:contentDescription="@string/pp_close"
        android:focusable="true" />

    <FrameLayout
        android:id="@+id/hz_card"
        android:layout_width="760dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_pp_card"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Header -->
            <LinearLayout
                android:id="@+id/hz_header"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/bg_pp_side"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageButton
                    android:id="@+id/hz_back"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_pp_round_btn"
                    android:contentDescription="@string/ci_back"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_ci_back" />

                <FrameLayout
                    android:id="@+id/hz_header_tile"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_pp_icon_tile">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_horizon" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/hz_title"
                        android:textColor="@color/hm_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/hz_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/hz_subtitle"
                        android:textColor="@color/hm_text_dim"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/hz_close"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_pp_round_btn"
                    android:contentDescription="@string/pp_close"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_pp_close" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/hm_divider" />

            <!-- Body: form -->
            <ScrollView
                android:id="@+id/hz_form"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:overScrollMode="ifContentScrolls"
                android:scrollbarStyle="outsideOverlay">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="16dp">

                    <!-- Left column -->
                    <LinearLayout
                        android:id="@+id/hz_left"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.2"
                            android:text="@string/ci_name"
                            android:textColor="@color/hm_text_dim"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />

                        <EditText
                            android:id="@+id/hz_name"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_ci_field"
                            android:hint="@string/hz_name_hint"
                            android:imeOptions="actionDone|flagNoExtractUi|flagNoFullscreen"
                            android:importantForAutofill="no"
                            android:inputType="textCapWords"
                            android:maxLength="48"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:singleLine="true"
                            android:textColor="@color/hm_text"
                            android:textColorHint="@color/hm_text_dim"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:letterSpacing="0.2"
                            android:text="@string/hz_version"
                            android:textColor="@color/hm_text_dim"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_ci_field"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp">

                            <TextView
                                android:id="@+id/hz_version_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:text="@string/hz_version_value"
                                android:textColor="@color/hm_text"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/hz_engine_build"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:singleLine="true"
                                android:textColor="@color/hm_text_dim"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:letterSpacing="0.2"
                            android:text="@string/hz_renderer"
                            android:textColor="@color/hm_text_dim"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/hz_renderer_field"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_ci_field"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingEnd="10dp">

                            <TextView
                                android:id="@+id/hz_renderer_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:textColor="@color/hm_text"
                                android:textSize="14sp" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_ci_chevron" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:letterSpacing="0.2"
                            android:text="@string/hz_controls"
                            android:textColor="@color/hm_text_dim"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/hz_controls_field"
                            android:layout_width="match_parent"
                            android:layout_height="44dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_ci_field"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingEnd="10dp">

                            <TextView
                                android:id="@+id/hz_controls_value"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:singleLine="true"
                                android:textColor="@color/hm_text"
                                android:textSize="14sp" />

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_ci_chevron" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Right column -->
                    <LinearLayout
                        android:id="@+id/hz_right"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:letterSpacing="0.2"
                                android:text="@string/hz_scale"
                                android:textColor="@color/hm_text_dim"
                                android:textSize="10.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/hz_scale_value"
                                android:layout_width="wrap_content"
                                android:layout_height="26dp"
                                android:background="@drawable/bg_ci_chip"
                                android:gravity="center"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:singleLine="true"
                                android:textColor="@color/hm_text"
                                android:textSize="12.5sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <SeekBar
                            android:id="@+id/hz_scale_slider"
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:layout_marginTop="4dp"
                            android:max="15"
                            android:paddingStart="6dp"
                            android:paddingEnd="6dp"
                            android:progressBackgroundTint="@color/hm_inner_stroke"
                            android:progressTint="@color/hm_accent"
                            android:thumbTint="@color/hm_accent" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/hz_scale_hint"
                            android:textColor="@color/hm_text_dim"
                            android:textSize="11.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:letterSpacing="0.2"
                            android:text="@string/hz_engine"
                            android:textColor="@color/hm_text_dim"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_ci_field"
                            android:gravity="center_vertical"
                            android:minHeight="44dp"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="10dp">

                            <View
                                android:id="@+id/hz_engine_dot"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@drawable/bg_ci_chip" />

                            <TextView
                                android:id="@+id/hz_engine_status"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:textColor="@color/hm_text"
                                android:textSize="12.5sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- Body: progress (shown instead of the form while the engine is set up) -->
            <LinearLayout
                android:id="@+id/hz_progress"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/hz_progress_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hz_progress_title"
                    android:textColor="@color/hm_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hz_progress_profile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textColor="@color/hm_text_dim"
                    android:textSize="12.5sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/hz_progress_stage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="@color/hm_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/hz_progress_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/hm_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/hz_progress_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progressBackgroundTint="@color/hm_inner_stroke"
                    android:progressTint="@color/hm_accent"
                    android:indeterminateTint="@color/hm_accent" />

                <TextView
                    android:id="@+id/hz_progress_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/hm_text_dim"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/hz_progress_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textColor="#FFE57373"
                    android:textSize="12.5sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/hz_progress_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:text="@string/hz_progress_hint"
                    android:textColor="@color/hm_text_dim"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/hm_divider" />

            <!-- Footer -->
            <LinearLayout
                android:id="@+id/hz_footer"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/hz_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="@string/hz_summary"
                    android:textColor="@color/hm_text_dim"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/hz_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_ci_button_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="96dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:text="@string/ci_cancel"
                    android:textColor="@color/hm_text"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/hz_create"
                    android:layout_width="170dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_home_play_clip"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="centerCrop"
                        android:src="@drawable/home_play_texture" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_home_play_edge"
                        android:duplicateParentState="true" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/hz_create_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_pp_plus_dark" />

                        <TextView
                            android:id="@+id/hz_create_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:singleLine="true"
                            android:text="@string/hz_create"
                            android:textColor="#FF0E1525"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
