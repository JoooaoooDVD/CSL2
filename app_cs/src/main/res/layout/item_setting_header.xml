<?xml version="1.0" encoding="utf-8"?>
<!-- Head of a settings category page: icon tile, big title and the category description -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="4dp"
    android:paddingTop="2dp"
    android:paddingRight="4dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@android:id/icon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_st_icon_box"
        android:contentDescription="@null"
        android:padding="13dp"
        android:scaleType="fitCenter"
        android:tint="@color/pe_icon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/minecraft_ten"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/pe_text_primary"
            android:textSize="21sp" />

        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/pe_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@android:id/widget_frame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
