<?xml version="1.0" encoding="utf-8"?>
<!-- OPTL Tier List inside the launcher: Top 10 from OPTL's public rankings feed + the player's own
     rank + the Request-a-test entry. Dark partner palette. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/ok_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_banner_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/ok_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/about_back"
            android:padding="9dp"
            android:src="@drawable/ic_pe_back"
            android:tint="?attr/colorOnSurface" />

        <FrameLayout
            android:id="@+id/ok_logo_wrap"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_partner_logo_tile">
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/partner_optl_logo" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/noto_sans_bold"
                android:includeFontPadding="false"
                android:text="@string/optl_rankings_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/ok_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:includeFontPadding="false"
                android:text="@string/optl_rankings_sub"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/ok_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_optl_btn_ghost"
            android:fontFamily="@font/noto_sans_bold"
            android:includeFontPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:stateListAnimator="?attr/csPressAnimator"
            android:text="@string/optl_refresh"
            android:textColor="?attr/colorOnSurface"
            android:textSize="11sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/ok_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/ok_me_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_optl_me"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:letterSpacing="0.08"
                    android:text="@string/optl_your_rank"
                    android:textColor="#D9B356"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
                <include
                    android:id="@+id/ok_me_row"
                    layout="@layout/item_optl_rank" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ok_request_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_partner_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/ok_request_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/noto_sans_bold"
                        android:includeFontPadding="false"
                        android:text="@string/optl_request_card_title"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13.5sp" />
                    <TextView
                        android:id="@+id/ok_request_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:includeFontPadding="false"
                        android:text="@string/optl_request_card_sub"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/ok_request"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_optl_btn_gold"
                    android:fontFamily="@font/noto_sans_bold"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="9dp"
                    android:stateListAnimator="?attr/csPressAnimator"
                    android:text="@string/optl_request_btn"
                    android:textColor="#17130A"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ok_top_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_partner_card"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.08"
                        android:text="@string/optl_top10"
                        android:textColor="#D9B356"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/ok_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="10.5sp"
                        tools:text="4,197 ranked players" />
                </LinearLayout>

                <TextView
                    android:id="@+id/ok_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:paddingVertical="18dp"
                    android:text="@string/optl_loading"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/ok_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/ok_full"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_optl_btn_ghost"
                    android:fontFamily="@font/noto_sans_bold"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="9dp"
                    android:stateListAnimator="?attr/csPressAnimator"
                    android:text="@string/optl_full_list"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
