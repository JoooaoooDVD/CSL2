<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_vl_sheet"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.3"
        android:text="@string/auth_section_servers"
        android:textColor="@color/hm_accent"
        android:textSize="10.5sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/minecraft_ten"
        android:includeFontPadding="false"
        android:text="@string/auth_add_server"
        android:textColor="@color/hm_text"
        android:textSize="20sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/auth_add_server_body"
        android:textColor="@color/hm_text_dim"
        android:textSize="12.5sp" />

    <LinearLayout
        android:id="@+id/aas_field"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_vl_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_auth_custom" />

        <EditText
            android:id="@+id/aas_url"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/cl_server_hint"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="textUri|textNoSuggestions"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:textColor="@color/hm_text"
            android:textColorHint="@color/hm_text_dim"
            android:textSize="14.5sp" />

        <ProgressBar
            android:id="@+id/aas_spinner"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:indeterminateTint="@color/hm_accent"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/aas_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/hm_text_dim"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/aas_presets"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/aas_cancel"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_vl_btn_ghost"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@android:string/cancel"
            android:textColor="@color/hm_text"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/aas_add"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_sl_action_primary"
            android:enabled="false"
            android:alpha="0.5"
            android:gravity="center"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="@string/auth_add_server_confirm"
            android:textColor="#0B0B0E"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
