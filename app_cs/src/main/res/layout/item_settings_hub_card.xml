<?xml version="1.0" encoding="utf-8"?>
<!--
    One category card of the settings hub: icon tile, title + summary, artwork on the
    right that melts into the card, and a round chevron. Filled in by SettingsHubFragment.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/st_card_height"
    android:background="@drawable/bg_st_card"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/st_card_art"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.6" />

    <View
        android:id="@+id/st_card_shade"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_st_art_shade"
        app:layout_constraintBottom_toBottomOf="@id/st_card_art"
        app:layout_constraintEnd_toEndOf="@id/st_card_art"
        app:layout_constraintStart_toStartOf="@id/st_card_art"
        app:layout_constraintTop_toTopOf="@id/st_card_art" />

    <View
        android:id="@+id/st_card_fade"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_st_art_fade"
        app:layout_constraintBottom_toBottomOf="@id/st_card_art"
        app:layout_constraintEnd_toEndOf="@id/st_card_art"
        app:layout_constraintStart_toStartOf="@id/st_card_art"
        app:layout_constraintTop_toTopOf="@id/st_card_art" />

    <ImageView
        android:id="@+id/st_card_icon"
        android:layout_width="@dimen/st_icon_box"
        android:layout_height="@dimen/st_icon_box"
        android:layout_marginStart="16dp"
        android:background="@drawable/bg_st_icon_box"
        android:importantForAccessibility="no"
        android:padding="@dimen/st_icon_padding"
        android:scaleType="fitCenter"
        android:tint="@color/pe_icon"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/st_card_texts"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/st_card_chevron"
        app:layout_constraintStart_toEndOf="@id/st_card_icon"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/st_card_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/noto_sans_bold"
            android:maxLines="1"
            android:shadowColor="#66000000"
            android:shadowRadius="6"
            android:textColor="@color/pe_text_primary"
            android:textSize="@dimen/st_card_title_size" />

        <TextView
            android:id="@+id/st_card_summary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:maxWidth="300dp"
            android:shadowColor="#66000000"
            android:shadowRadius="6"
            android:textColor="@color/pe_text_secondary"
            android:textSize="@dimen/st_card_summary_size" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/st_card_chevron"
        android:layout_width="@dimen/st_chevron"
        android:layout_height="@dimen/st_chevron"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_st_chevron"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_st_chevron_right"
            android:tint="#FFFFFFFF" />
    </FrameLayout>

    <View
        android:id="@+id/st_card_outline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_st_card_outline"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
