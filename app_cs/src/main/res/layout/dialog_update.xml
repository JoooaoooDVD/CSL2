<?xml version="1.0" encoding="utf-8"?>
<!-- In-app update popup: version comparison, release notes, download progress, actions -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/upd_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/hm_scrim"
        android:clickable="true"
        android:focusable="true" />

    <LinearLayout
        android:id="@+id/upd_card"
        android:layout_width="460dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_pp_card"
        android:clickable="true"
        android:elevation="16dp"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="16dp"
        android:paddingEnd="18dp"
        android:paddingBottom="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/upd_icon_tile"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_sp_icon_tile">

                <ImageView
                    android:id="@+id/upd_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_cs_update"
                    android:tint="@color/hm_icon" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/upd_eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.16"
                    android:text="@string/upd_eyebrow"
                    android:textAllCaps="true"
                    android:textColor="@color/hm_accent"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/upd_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/upd_available_title"
                    android:textColor="@color/hm_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/upd_close"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_pp_round_btn"
                android:clickable="true"
                android:contentDescription="@string/pp_close"
                android:focusable="true"
                android:padding="9dp"
                android:src="@drawable/ic_pp_close" />
        </LinearLayout>

        <!-- Version comparison -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_upd_version_chip"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="@string/upd_installed"
                    android:textAllCaps="true"
                    android:textColor="@color/hm_text_dim"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/upd_current"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:maxLines="1"
                    android:textColor="@color/hm_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_chevron_right_home"
                android:tint="@color/hm_text_dim" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_upd_version_chip_new"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/upd_new_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="@string/upd_latest"
                    android:textAllCaps="true"
                    android:textColor="@color/hm_accent"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/upd_new"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:maxLines="1"
                    android:textColor="@color/hm_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/upd_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/hm_text_dim"
            android:textSize="11.5sp" />

        <!-- Release notes -->
        <TextView
            android:id="@+id/upd_notes_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.12"
            android:text="@string/upd_whats_new"
            android:textAllCaps="true"
            android:textColor="@color/hm_text_dim"
            android:textSize="10sp"
            android:textStyle="bold" />

        <com.craftstudio.cslauncher.prefs.MaxHeightScrollView
            android:id="@+id/upd_notes_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_upd_notes"
            android:overScrollMode="never"
            android:scrollbarSize="3dp"
            android:scrollbarStyle="insideOverlay">

            <TextView
                android:id="@+id/upd_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="3dp"
                android:padding="12dp"
                android:textColor="@color/hm_text"
                android:textSize="12.5sp" />
        </com.craftstudio.cslauncher.prefs.MaxHeightScrollView>

        <!-- Progress (download / verify) -->
        <LinearLayout
            android:id="@+id/upd_progress_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/upd_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/hm_text"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/upd_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:textColor="@color/hm_text_dim"
                    android:textSize="12sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/upd_track"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_upd_track">

                <View
                    android:id="@+id/upd_bar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_upd_bar" />
            </FrameLayout>

            <TextView
                android:id="@+id/upd_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/hm_text_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/upd_skip"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_sp_btn_ghost"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/upd_skip"
                android:textColor="@color/hm_text_dim"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/upd_later"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_sp_btn_ghost"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/upd_later"
                android:textColor="@color/hm_text"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/upd_primary"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_sp_btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:maxLines="1"
                android:minWidth="124dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/upd_update_now"
                android:textColor="@color/hm_dialog"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
