<?xml version="1.0" encoding="utf-8"?>
<!-- Profile editor (Edit Profile) styles -->
<resources>

    <style name="PE.Card" parent="">
        <item name="android:background">@drawable/bg_pe_card</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="PE.CardTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/pe_text_primary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/noto_sans_bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="PE.CardSub" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:textColor">@color/pe_text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">2</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="PE.CardIcon" parent="">
        <item name="android:layout_width">26dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:tint">@color/pe_icon</item>
    </style>

    <style name="PE.FieldLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/pe_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="PE.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:background">@drawable/bg_pe_row</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <style name="PE.RowIcon" parent="">
        <item name="android:layout_width">26dp</item>
        <item name="android:layout_height">26dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:tint">@color/pe_icon</item>
    </style>

    <style name="PE.RowLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/pe_text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="PE.RowValue" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/pe_text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="PE.RowChevron" parent="">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:src">@drawable/ic_pe_chevron_down</item>
        <item name="android:tint">@color/pe_icon</item>
    </style>

    <style name="PE.IconChip" parent="">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:background">@drawable/bg_pe_icon_chip</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="PE.Button" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="cornerRadius">12dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">12dp</item>
        <item name="iconSize">22dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="PE.Button.Light">
        <item name="backgroundTint">@color/pe_btn_primary_bg</item>
        <item name="android:textColor">@color/pe_btn_primary_text</item>
        <item name="iconTint">@color/pe_btn_primary_text</item>
        <item name="rippleColor">#33000000</item>
    </style>

    <style name="PE.Button.Dark">
        <item name="backgroundTint">@color/pe_btn_dark_bg</item>
        <item name="android:textColor">@color/pe_btn_dark_text</item>
        <item name="iconTint">@color/pe_btn_dark_text</item>
        <item name="strokeColor">@color/pe_btn_dark_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="PE.Button.Delete">
        <item name="backgroundTint">@color/pe_delete_bg</item>
        <item name="android:textColor">@color/pe_delete_text</item>
        <item name="iconTint">@color/pe_delete_text</item>
        <item name="strokeColor">@color/pe_delete_stroke</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="rippleColor">#33E5484D</item>
    </style>
</resources>
