<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WorldEdit.ActionRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_lib_row_selectable</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>

    <style name="WorldEdit.ActionIcon" parent="">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:contentDescription">@null</item>
        <item name="tint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="WorldEdit.ActionText" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
