<?xml version="1.0" encoding="utf-8"?>
<!-- Styles for the redesigned profile editor (InstanceEditorFragment) -->
<resources>

    <!-- Section heading row: bold caps-style label, paired with a leading icon -->
    <style name="ProfileEditorSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <!-- Field label above each editable row -->
    <style name="ProfileEditorFieldLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">9.5sp</item>
    </style>

    <!-- Small helper text (e.g. profile background hint) -->
    <style name="ProfileEditorHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">7dp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">9sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

</resources>
