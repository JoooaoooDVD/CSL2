<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Selectable chip on the light settings pages -->
    <style name="CsPeChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:background">@drawable/bg_pe_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/pe_chip_text</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
