<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== home cards ===== -->
    <style name="CSCard" parent="">
        <item name="android:background">@drawable/cs_card_bg</item>
        <item name="android:padding">@dimen/_14sdp</item>
    </style>

    <style name="CSCardTitle">
        <item name="android:textColor">@color/cs_ink</item>
        <item name="android:textSize">@dimen/_17ssp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="CSCardSubtitle">
        <item name="android:textColor">@color/cs_ink_dim</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- ===== chips ===== -->
    <style name="CSChip">
        <item name="android:background">@drawable/cs_chip_bg</item>
        <item name="android:textColor">@color/cs_ink</item>
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="android:singleLine">true</item>
        <item name="android:paddingStart">@dimen/_10sdp</item>
        <item name="android:paddingEnd">@dimen/_10sdp</item>
        <item name="android:paddingTop">@dimen/_5sdp</item>
        <item name="android:paddingBottom">@dimen/_5sdp</item>
        <item name="android:drawablePadding">@dimen/_4sdp</item>
    </style>

    <!-- ===== section header ===== -->
    <style name="CSSectionTitle">
        <item name="android:textColor">@color/cs_ink</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="CSSectionLink">
        <item name="android:textColor">@color/cs_green</item>
        <item name="android:textSize">@dimen/_11ssp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">@dimen/_6sdp</item>
    </style>

    <!-- ===== quick action card ===== -->
    <style name="CSQuickTitle">
        <item name="android:textColor">@color/cs_ink</item>
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="CSQuickSubtitle">
        <item name="android:textColor">@color/cs_ink_dim</item>
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- ===== top bar ===== -->
    <style name="CSBrandTitle">
        <item name="android:textColor">@color/cs_ink</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="CSBrandTip">
        <item name="android:textColor">@color/cs_ink_dim</item>
        <item name="android:textSize">@dimen/_8ssp</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="CSBadgePro">
        <item name="android:background">@drawable/cs_badge_pro_bg</item>
        <item name="android:textColor">#07080A</item>
        <item name="android:textSize">@dimen/_10ssp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">@dimen/_7sdp</item>
        <item name="android:paddingEnd">@dimen/_7sdp</item>
        <item name="android:paddingTop">@dimen/_3sdp</item>
        <item name="android:paddingBottom">@dimen/_5sdp</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <!-- ===== "All Tools" bottom sheet ===== -->
    <style name="CSBottomSheetAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_out_bottom</item>
    </style>

    <!-- ===== standard CS compact button style ===== -->
    <style name="CSClassicButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/cs_btn_bg</item>
        <item name="android:textColor">@color/cs_ink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">@dimen/_10sdp</item>
        <item name="android:paddingEnd">@dimen/_10sdp</item>
    </style>

</resources>
