<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app2="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    app:key=""
    >

    <com.craftstudio.cslauncher.prefs.BackButtonPreference />

    <PreferenceCategory android:layout="@layout/item_settings_section"
        android:title="@string/preference_category_main_categories"
        >

        <Preference android:layout="@layout/item_setting_row"
            android:key="video_screen_setting"
            android:title="@string/preference_video_title"
            android:summary="@string/preference_video_description"
            android:fragment="com.craftstudio.cslauncher.prefs.screens.LauncherPreferenceVideoFragment"
            android:icon="@drawable/ic_qs_monitor"
            
            android:widgetLayout="@layout/view_chevron" />

        <Preference android:layout="@layout/item_setting_row"
            android:key="appearance_screen_setting"
            android:title="@string/preference_appearance_title"
            android:summary="@string/preference_appearance_description"
            android:fragment="com.craftstudio.cslauncher.prefs.screens.LauncherPreferenceAppearanceFragment"
            app:iconSpaceReserved="true"
            android:icon="@drawable/ic_px_image"
            
            android:widgetLayout="@layout/view_chevron" />

        <Preference android:layout="@layout/item_setting_row"
            android:key="control_screen_setting"
            android:title="@string/preference_control_title"
            android:summary="@string/preference_control_description"
            android:fragment="com.craftstudio.cslauncher.prefs.screens.LauncherPreferenceControlFragment"
            android:icon="@drawable/ic_px_gamepad"
            
            android:widgetLayout="@layout/view_chevron" />

        <Preference android:layout="@layout/item_setting_row"
            android:key="java_screen_setting"
            android:title="@string/preference_java_title"
            android:summary="@string/preference_java_description"
            android:fragment="com.craftstudio.cslauncher.prefs.screens.LauncherPreferenceJavaFragment"
            android:icon="@drawable/ic_px_java"
            
            android:widgetLayout="@layout/view_chevron" />

        <Preference android:layout="@layout/item_setting_row"
            android:key="misc_screen_setting"
            android:title="@string/preference_misc_title"
            android:summary="@string/preference_misc_description"
            android:fragment="com.craftstudio.cslauncher.prefs.screens.LauncherPreferenceMiscellaneousFragment"
            android:icon="@drawable/ic_px_alt_sliders"
            
            android:widgetLayout="@layout/view_chevron" />


        <Preference android:layout="@layout/item_setting_row"
            android:key="experimental_screen_setting"
            android:title="@string/preference_experimental_title"
            android:summary="@string/preference_experimental_description"
            android:fragment="com.craftstudio.cslauncher.prefs.screens.LauncherPreferenceExperimentalFragment"
            android:icon="@drawable/ic_px_experiment"
            android:widgetLayout="@layout/view_chevron" />
    </PreferenceCategory>

    <ListPreference android:layout="@layout/item_setting_row"
        android:title="@string/preference_language_title"
        android:key="launcher_language"
        android:defaultValue="system"
        android:icon="@drawable/ic_px_translate"
        android:widgetLayout="@layout/view_chevron"/>

    <Preference android:layout="@layout/item_setting_row"
        android:title="@string/preference_ask_for_notification_title"
        android:summary="@string/preference_ask_for_notification_description"
        android:key="notification_permission_request"
        android:icon="@drawable/ic_px_bell"
        />





</PreferenceScreen>