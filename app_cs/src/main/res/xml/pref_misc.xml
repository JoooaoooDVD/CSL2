<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app2="http://schemas.android.com/apk/res-auto">

    <com.craftstudio.cslauncher.prefs.BackButtonPreference />

    <PreferenceCategory android:layout="@layout/item_settings_section" android:title="@string/preference_category_miscellaneous">
        <SwitchPreferenceCompat android:layout="@layout/item_setting_row"
            android:widgetLayout="@layout/preference_widget_material_switch"
            android:defaultValue="true"
            android:icon="@drawable/ic_px_hash"
            android:key="checkGameFiles"
            android:summary="@string/preference_verify_game_files_description"
            android:title="@string/preference_verify_game_files_title" />

        <SwitchPreferenceCompat android:layout="@layout/item_setting_row"
            android:widgetLayout="@layout/preference_widget_material_switch"
            android:defaultValue="true"
            android:icon="@drawable/ic_px_zap"
            android:key="fastStartupCheck"
            android:summary="@string/preference_go_vroom_description"
            android:title="@string/preference_go_vroom_title" />
        <androidx.preference.ListPreference android:layout="@layout/item_setting_row"
            android:defaultValue="default"
            android:icon="@drawable/ic_px_file_dl"
            android:key="downloadSource"
            android:entries="@array/download_source_names"
            android:entryValues="@array/download_source_values"
            android:title="@string/preference_download_source_title"
            android:summary="@string/preference_download_source_description"
            app2:useSimpleSummaryProvider="true" android:widgetLayout="@layout/view_chevron"/>
        <SwitchPreferenceCompat android:layout="@layout/item_setting_row"
            android:widgetLayout="@layout/preference_widget_material_switch"
            android:defaultValue="true"
            android:icon="@drawable/ic_px_manifest_check"
            android:key="verifyManifest"
            android:title="@string/preference_verify_manifest_title"
            android:summary="@string/preference_verify_manifest_description"/>
        <Preference android:layout="@layout/item_setting_row"
            android:key="microphoneAccessRequest"
            android:icon="@drawable/ic_microphone"
            android:title="@string/preference_microphone_access_title"
            android:summary="@string/preference_microphone_access_description" />
        <Preference android:layout="@layout/item_setting_row"
            android:key="runDataMigration"
            android:icon="@drawable/ic_px_migrate"
            android:title="@string/preference_data_migration_title"
            android:summary="@string/preference_data_migration_summary" />
        <Preference android:layout="@layout/item_setting_row"
            android:key="clearMetadataCache"
            android:icon="@drawable/ic_px_cache_db"
            android:title="@string/preference_metadata_clear"
            android:summary="@string/preference_metadata_clear_summary" />
        <SwitchPreferenceCompat android:layout="@layout/item_setting_row"
            android:widgetLayout="@layout/preference_widget_material_switch"
            android:defaultValue="true"
            android:icon="@drawable/ic_px_memory_warning"
            android:key="showMemoryWarning"
            android:title="@string/preference_show_memory_warning_title"
            android:summary="@string/preference_show_memory_warning_summary"/>

    </PreferenceCategory>

    <PreferenceCategory android:layout="@layout/item_settings_section" android:title="@string/preference_category_skins">
        <SwitchPreferenceCompat android:layout="@layout/item_setting_row"
            android:widgetLayout="@layout/preference_widget_material_switch"
            android:defaultValue="true"
            android:icon="@drawable/ic_px_skin"
            android:key="localSkins"
            android:summary="@string/preference_local_skins_description"
            android:title="@string/preference_local_skins_title" />
    </PreferenceCategory>

    <PreferenceCategory android:layout="@layout/item_settings_section" android:title="@string/preference_category_discord">
        <SwitchPreferenceCompat android:layout="@layout/item_setting_row"
            android:widgetLayout="@layout/preference_widget_material_switch"
            android:defaultValue="true"
            android:icon="@drawable/ic_discord_mark"
            android:key="discordRpc"
            android:summary="@string/preference_discord_rpc_description"
            android:title="@string/preference_discord_rpc_title" />
        <Preference android:layout="@layout/item_setting_row"
            android:icon="@drawable/ic_tool_discord_rpc"
            android:key="discordPreview"
            android:summary="@string/preference_discord_preview_desc"
            android:title="@string/preference_discord_preview_title"
            android:widgetLayout="@layout/view_chevron" />
    </PreferenceCategory>

    <PreferenceCategory android:layout="@layout/item_settings_section" android:title="@string/preference_category_updates">
        <Preference android:layout="@layout/item_setting_row"
            android:key="checkUpdates"
            android:icon="@drawable/ic_cs_update"
            android:title="@string/preference_check_updates_title"
            android:summary="@string/preference_check_updates_description"
            android:widgetLayout="@layout/view_chevron" />
        <SwitchPreferenceCompat android:layout="@layout/item_setting_row"
            android:widgetLayout="@layout/preference_widget_material_switch"
            android:defaultValue="true"
            android:key="update_auto_check"
            android:icon="@drawable/ic_px_zap"
            android:title="@string/preference_update_auto_title"
            android:summary="@string/preference_update_auto_description" />
        <androidx.preference.ListPreference android:layout="@layout/item_setting_row"
            android:defaultValue="latest"
            android:key="update_channel"
            android:icon="@drawable/ic_px_file_dl"
            android:entries="@array/update_channel_names"
            android:entryValues="@array/update_channel_values"
            android:title="@string/preference_update_channel_title"
            app2:useSimpleSummaryProvider="true"
            android:widgetLayout="@layout/view_chevron" />
    </PreferenceCategory>

    <PreferenceCategory android:layout="@layout/item_settings_section" android:title="@string/tut_pref_category">
        <Preference android:layout="@layout/item_setting_row"
            android:key="tutorialCenter"
            android:icon="@drawable/ic_px_book"
            android:title="@string/tut_pref_title"
            android:summary="@string/tut_pref_summary"
            android:widgetLayout="@layout/view_chevron" />
    </PreferenceCategory>

    <PreferenceCategory android:layout="@layout/item_settings_section" android:title="@string/preference_category_about">
        <Preference android:layout="@layout/item_setting_row"
            android:key="aboutBrand"
            android:icon="@mipmap/ic_launcher"
            android:title="@string/preference_about_title"
            android:summary="@string/preference_about_summary"
            app2:iconSpaceReserved="false"
            android:selectable="false" />
    </PreferenceCategory>

</PreferenceScreen>