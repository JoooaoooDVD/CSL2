<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.craftstudio.cslauncher.prefs.BackButtonPreference />

    <PreferenceCategory android:layout="@layout/item_settings_section" android:title="@string/preference_category_theme">
        <androidx.preference.ListPreference android:layout="@layout/item_setting_row"
            android:defaultValue="dark"
            android:key="theme_mode"
            android:icon="@drawable/ic_px_dynamic"
            android:entries="@array/theme_mode_names"
            android:entryValues="@array/theme_mode_values"
            android:title="@string/preference_theme_mode_title"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true"  android:widgetLayout="@layout/view_chevron"/>
        <androidx.preference.ListPreference android:layout="@layout/item_setting_row"
            android:defaultValue="default"
            android:key="color_source"
            android:icon="@drawable/ic_px_sliders"
            android:entries="@array/color_source_names"
            android:entryValues="@array/color_source_values"
            android:title="@string/preference_color_source_title"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true"  android:widgetLayout="@layout/view_chevron"/>
        <com.craftstudio.cslauncher.prefs.ThemeColorPreference android:layout="@layout/item_setting_row"
            android:key="theme_custom_color"
            android:icon="@drawable/ic_px_palette"
            android:title="@string/preference_theme_color_title"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory android:layout="@layout/item_settings_section" android:title="@string/preference_category_display">
        <!-- CS Launcher Plus is always horizontal - orientation is locked in ThemeManager -->
    </PreferenceCategory>

    <PreferenceCategory android:layout="@layout/item_settings_section" android:title="@string/preference_category_animations">
        <androidx.preference.MultiSelectListPreference android:layout="@layout/item_setting_row"
            android:defaultValue="@array/animation_type_defaults"
            android:dialogTitle="@string/preference_animations_dialog_title"
            android:entries="@array/animation_type_names"
            android:entryValues="@array/animation_type_values"
            android:key="animation_types"
            android:icon="@drawable/ic_px_move"
            android:title="@string/preference_animations_title"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>


    <PreferenceCategory android:layout="@layout/item_settings_section" android:title="@string/preference_category_startup">
        <SwitchPreferenceCompat android:layout="@layout/item_setting_row"
            android:widgetLayout="@layout/preference_widget_material_switch"
            android:defaultValue="true"
            android:key="startup_sound"
            android:icon="@drawable/ic_cs_sound"
            android:title="@string/preference_startup_sound_title"
            android:summary="@string/preference_startup_sound_description" />
    </PreferenceCategory>

</PreferenceScreen>
