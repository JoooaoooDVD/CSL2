<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app2="http://schemas.android.com/apk/res-auto">

    <com.craftstudio.cslauncher.prefs.BackButtonPreference android:layout="@layout/item_setting_row"/>

    <PreferenceCategory android:layout="@layout/item_settings_section" android:title="@string/preference_renderer_mobileglues_settings" android:icon="@drawable/ic_mg_renderer">
        <EditTextPreference
            android:layout="@layout/item_setting_row"
            android:icon="@drawable/ic_px_ram"
            android:title="@string/mg_renderer_glsl_cache"
            android:key="mg_renderer_setting_glsl_cache_size"
            android:inputType="number"
            android:defaultValue="128" />
        <androidx.preference.ListPreference android:layout="@layout/item_setting_row"
            android:title="@string/mg_renderer_angle"
            android:key="mg_renderer_setting_angle"
            android:icon="@drawable/ic_px_image"
            android:defaultValue="1"
            android:entries="@array/mg_renderer_names_angle"
            android:entryValues="@array/mg_renderer_values_angle"
            app2:useSimpleSummaryProvider="true" android:widgetLayout="@layout/view_chevron"/>
        <androidx.preference.ListPreference android:layout="@layout/item_setting_row"
            android:title="@string/mg_renderer_multidraw"
            android:key="mg_renderer_setting_multidraw"
            android:icon="@drawable/ic_px_move"
            android:defaultValue="0"
            android:entries="@array/mg_renderer_names_multidraw"
            android:entryValues="@array/mg_renderer_values_multidraw"
            app2:useSimpleSummaryProvider="true" android:widgetLayout="@layout/view_chevron"/>
        <androidx.preference.ListPreference android:layout="@layout/item_setting_row"
            android:title="@string/mg_renderer_title_fsr"
            android:key="mg_renderer_setting_fsr"
            android:icon="@drawable/ic_px_resolution"
            android:defaultValue="0"
            android:entries="@array/mg_renderer_names_fsr"
            android:entryValues="@array/mg_renderer_values_fsr"
            app2:useSimpleSummaryProvider="true" android:widgetLayout="@layout/view_chevron"/>
        <androidx.preference.ListPreference android:layout="@layout/item_setting_row"
            android:title="@string/mg_renderer_title_errorSetting"
            android:key="mg_renderer_setting_errorSetting"
            android:icon="@drawable/ic_px_memory_warning"
            android:defaultValue="0"
            android:entries="@array/mg_renderer_names_errorSetting"
            android:entryValues="@array/mg_renderer_values_errorSetting"
            app2:useSimpleSummaryProvider="true" android:widgetLayout="@layout/view_chevron"/>
        <SwitchPreferenceCompat android:layout="@layout/item_setting_row"
            android:widgetLayout="@layout/preference_widget_material_switch"
            android:title="@string/mg_renderer_title_timerQueryExt"
            android:summary="@string/mg_renderer_summary_timerQueryExt"
            android:key="mg_renderer_setting_timerQueryExt"
            android:icon="@drawable/ic_px_hash"
            android:defaultValue="false" />
        <PreferenceCategory android:layout="@layout/item_settings_section" android:title="@string/preference_ANGLE_only">
            <SwitchPreferenceCompat android:layout="@layout/item_setting_row"
                android:widgetLayout="@layout/preference_widget_material_switch"
                android:title="@string/mg_renderer_title_angleDepthClearFixMode"
                android:summary="@string/mg_renderer_summary_angleDepthClearFixMode"
                android:key="mg_renderer_setting_angleDepthClearFixMode"
            android:icon="@drawable/ic_px_image_renderer"
                android:defaultValue="false" />
        </PreferenceCategory>
        <PreferenceCategory android:layout="@layout/item_settings_section" android:title="@string/preference_experimental_title">
            <SwitchPreferenceCompat android:layout="@layout/item_setting_row"
                android:widgetLayout="@layout/preference_widget_material_switch"
                android:title="@string/mg_renderer_title_computeShaderext"
                android:summary="@string/mg_renderer_summary_computeShaderext"
                android:key="mg_renderer_computeShaderext"
            android:icon="@drawable/ic_px_dynamic"
                android:defaultValue="false" />
            <SwitchPreferenceCompat android:layout="@layout/item_setting_row"
                android:widgetLayout="@layout/preference_widget_material_switch"
                android:title="@string/mg_renderer_title_dsaExt"
                android:summary="@string/mg_renderer_summary_dsaExt"
                android:key="mg_renderer_dsaExt"
            android:icon="@drawable/ic_px_sliders"
                android:defaultValue="false" />
            <SwitchPreferenceCompat android:layout="@layout/item_setting_row"
                android:widgetLayout="@layout/preference_widget_material_switch"
                android:title="@string/mg_renderer_title_multidrawCompute"
                android:summary="@string/mg_renderer_summary_multidrawCompute"
                android:key="mg_renderer_multidrawCompute"
            android:icon="@drawable/ic_px_zap"
                android:defaultValue="false" />
        </PreferenceCategory>
    </PreferenceCategory>
</PreferenceScreen>
