<?xml version="1.0" encoding="utf-8"?>
<!-- CS Launcher Plus home shell: brand header + content area -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_backdrop"
    android:orientation="vertical">

    <!-- ══════════════ TOP HEADER ══════════════ -->
    <!-- Hidden while a focus screen (profile editor) is open, see MainMenuMotion.topBar -->
    <LinearLayout
        android:id="@+id/cs_top_bar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <!-- Brand block -->
        <ImageView
            android:id="@+id/brand_logo"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/app_short_name"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_cs_full" />

        <LinearLayout
            android:id="@+id/brand_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/brand_short_name"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.32"
                android:text="@string/brand_tagline_home"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="7sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Navigation dock: replaces the old left sidebar, so every screen gets the full
             width. The indicator slides behind the active button (see TopNavDock) -->
        <FrameLayout
            android:id="@+id/top_nav_dock"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_top_dock"
            android:padding="3dp">

            <View
                android:id="@+id/top_nav_indicator"
                android:layout_width="@dimen/top_dock_item_width"
                android:layout_height="@dimen/top_dock_item_height"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_top_dock_indicator"
                android:visibility="invisible" />

            <LinearLayout
                android:id="@+id/top_nav_items"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/nav_home"
                    android:layout_width="@dimen/top_dock_item_width"
                    android:layout_height="@dimen/top_dock_item_height"
                    android:background="@drawable/bg_top_dock_item"
                    android:contentDescription="@string/home_nav_home"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_nav_home"
                    android:tooltipText="@string/home_nav_home" />

                <ImageButton
                    android:id="@+id/mod_store_button"
                    android:layout_width="@dimen/top_dock_item_width"
                    android:layout_height="@dimen/top_dock_item_height"
                    android:background="@drawable/bg_top_dock_item"
                    android:contentDescription="@string/home_nav_browser"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_dock_browser"
                    android:tooltipText="@string/home_nav_browser" />

                <ImageButton
                    android:id="@+id/open_files_button"
                    android:layout_width="@dimen/top_dock_item_width"
                    android:layout_height="@dimen/top_dock_item_height"
                    android:background="@drawable/bg_top_dock_item"
                    android:contentDescription="@string/home_nav_manager"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_dock_manager"
                    android:tooltipText="@string/home_nav_manager" />

                <ImageButton
                    android:id="@+id/nav_controls"
                    android:layout_width="@dimen/top_dock_item_width"
                    android:layout_height="@dimen/top_dock_item_height"
                    android:background="@drawable/bg_top_dock_item"
                    android:contentDescription="@string/home_nav_controls"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_dock_controls"
                    android:tooltipText="@string/home_nav_controls" />

                <ImageButton
                    android:id="@+id/nav_logs"
                    android:layout_width="@dimen/top_dock_item_width"
                    android:layout_height="@dimen/top_dock_item_height"
                    android:background="@drawable/bg_top_dock_item"
                    android:contentDescription="@string/home_nav_logs"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_dock_logs"
                    android:tooltipText="@string/home_nav_logs" />
            </LinearLayout>
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Account selector (existing AccountSpinner, restyled) -->
        <com.kdt.mcgui.AccountSpinner
            android:id="@+id/account_spinner"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_account_pill"
            android:dropDownVerticalOffset="40dp"
            android:minWidth="@dimen/top_account_min_width"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:popupBackground="@drawable/bg_popup_rounded"
            tools:ignore="RtlSymmetry" />

        <!-- Settings -->
        <ImageButton
            android:id="@+id/setting_button"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_icon_button_home"
            android:contentDescription="@string/home_settings"
            android:padding="10dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_px_sliders"
            android:tooltipText="@string/home_settings" />

        <!-- Overflow menu -->
    </LinearLayout>

    <!-- ══════════════ CONTENT ══════════════ -->
    <com.kdt.mcgui.ProgressLayout
        android:id="@+id/progress_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="4dp"
        android:elevation="8dp"
        android:visibility="gone" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/container_fragment"
        android:name="com.craftstudio.cslauncher.fragments.MainMenuFragment"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
