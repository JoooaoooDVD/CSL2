<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape settings. Hub: the hub fills the screen. Category: header banner with the
     category tabs on its right + the screen below (toggled by SettingsHostFragment) -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainer">

    <LinearLayout
        android:id="@+id/settings_right_column"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Header banner: art + scrim + section icon/title/subtitle -->
        <FrameLayout
            android:id="@+id/settings_header"
            android:layout_width="match_parent"
            android:layout_height="66dp"
            android:background="@drawable/bg_settings_header"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/settings_header_art"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:src="@drawable/settings_banner" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/settings_header_scrim" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="14dp"
                android:paddingRight="10dp">

                <ImageView
                    android:id="@+id/settings_header_icon"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_settings_icon_box"
                    android:contentDescription="@null"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_sharp_settings_24" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/settings_header_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/settings_hub_title"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/settings_header_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/settings_hub_subtitle"
                        android:textColor="#CCF1F3F5"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Category tabs (SettingsRailFragment): replaced the old left rail -->
                <FrameLayout
                    android:id="@+id/settings_left_pane_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- The active screen (hub or category) -->
        <FrameLayout
            android:id="@+id/settings_right_pane_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_right_pane"
            android:clipToOutline="true" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
